---
import '@fontsource/bebas-neue/index.css';
import '@fontsource/instrument-serif/index.css';
import '@fontsource/inter/index.css';
import '@fontsource/jetbrains-mono/index.css';
import { ClientRouter } from 'astro:transitions';

import '@/global.css';
import '@/styles.css';
import Footer from '@sections/Footer.astro';
import Navbar from '@sections/Navbar.astro';
import Stars from '@components/Stars.astro';

interface Props {
    description: string;
    title: string;
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const { description, title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1" name="viewport" />
        <title>{title}</title>
        <meta content={description} name="description" />
        <meta content="Kevin Huang" name="author" />
        <meta content="#0a0a0f" name="theme-color" />
        <meta content="index, follow" name="robots" />
        <link href={canonicalUrl} rel="canonical" />
        <link href="/apple-touch-icon.png" rel="apple-touch-icon" />
        <link href="/favicon.png" rel="icon" type="image/png" />
        <meta content={title} property="og:title" />
        <meta content={description} property="og:description" />
        <meta content={`${Astro.site}og.png`} property="og:image" />
        <meta content={canonicalUrl} property="og:url" />
        <meta content="Austin Music Video Film Festival" property="og:site_name" />
        <meta content="website" property="og:type" />
        <meta content="summary_large_image" name="twitter:card" />
        <meta content={title} name="twitter:title" />
        <meta content={description} name="twitter:description" />
        <meta content={`${Astro.site}og.png`} name="twitter:image" />
        <script
            is:inline
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebSite',
                'author': {
                    '@type': 'Person',
                    'name': 'Kevin Huang',
                },
                'name': 'Austin Music Video Film Festival',
                'url': Astro.site,
            })}
            type="application/ld+json"
        />
        <ClientRouter />
    </head>
    <body class="flex flex-col isolate overflow-x-clip relative min-h-screen antialiased font-sans bg-night text-cream">
        <div class="grain fixed pointer-events-none" aria-hidden="true" />
        <div class="vignette fixed pointer-events-none" aria-hidden="true" />
        <Stars />
        <Navbar />
        <main class="flex flex-col flex-1 mb-(--section-padding)">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    .grain {
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.7'/></svg>");
        inset: 0;
        mix-blend-mode: overlay;
        opacity: 0.18;
        z-index: 100;
    }

    .vignette {
        background: radial-gradient(ellipse at center, transparent 30%, var(--color-black-55) 100%);
        inset: 0;
        z-index: 99;
    }
</style>

<script>
    import { initMotion } from '@lib/motion';

    document.addEventListener('astro:page-load', initMotion);
</script>
