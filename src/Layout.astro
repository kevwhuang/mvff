---
import '@fontsource/bebas-neue/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import { ClientRouter } from 'astro:transitions';

import '@/global.css';
import '@/styles.css';
import Footer from '@sections/Footer.astro';
import Navbar from '@sections/Navbar.astro';
import Starfield from '@components/Starfield.astro';
import { ROUTES } from '@lib/constants';

interface Props {
    description: string;
    noindex?: boolean;
    title: string;
}

const canonicalUrl = new URL(Astro.routePattern, Astro.site);
const currentRoute = ROUTES.find(route => route.href === Astro.routePattern);
const { description, noindex, title } = Astro.props;
const ogImageUrl = `${Astro.site}og.png`;

const breadcrumbRoutes = currentRoute && currentRoute !== ROUTES[0] ? [ROUTES[0], currentRoute] : [];

const breadcrumbList = {
    '@type': 'BreadcrumbList',
    'itemListElement': breadcrumbRoutes.map((route, index) => ({
        '@type': 'ListItem',
        'item': new URL(route.href, Astro.site).href,
        'name': route.label,
        'position': index + 1,
    })),
};

const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        ...(breadcrumbRoutes.length > 0 ? [breadcrumbList] : []),
        {
            '@type': 'ItemList',
            'itemListElement': ROUTES.filter(route => !route.isDisabled).map((route, index) => ({
                '@type': 'SiteNavigationElement',
                'name': route.label,
                'position': index + 1,
                'url': new URL(route.href, Astro.site).href,
            })),
        },
        {
            '@type': 'WebSite',
            'author': {
                '@type': 'Person',
                'name': 'Anna Madewell',
            },
            'inLanguage': 'en',
            'name': 'Austin Music Video Film Festival',
            'url': Astro.site,
        },
    ],
};
---

<!doctype html>
<html class="overflow-x-clip" lang="en">
    <head>
        <meta charset="utf-8" />
        <title>{title}</title>
        <meta content="Anna Madewell" name="author" />
        <meta content={description} name="description" />
        <meta content={noindex ? 'noindex, nofollow' : 'index, follow'} name="robots" />
        <meta content="#0a0a0f" name="theme-color" />
        <meta content="width=device-width, initial-scale=1" name="viewport" />
        <link href="/apple-touch-icon.png" rel="apple-touch-icon" />
        <link href={canonicalUrl} rel="canonical" />
        <link href="/favicon.png" rel="icon" type="image/png" />
        <meta content={description} property="og:description" />
        <meta content={ogImageUrl} property="og:image" />
        <meta content="en_US" property="og:locale" />
        <meta content="Austin Music Video Film Festival" property="og:site_name" />
        <meta content={title} property="og:title" />
        <meta content="website" property="og:type" />
        <meta content={canonicalUrl} property="og:url" />
        <meta content="summary_large_image" name="twitter:card" />
        <meta content={description} name="twitter:description" />
        <meta content={ogImageUrl} name="twitter:image" />
        <meta content={title} name="twitter:title" />
        <script is:inline set:html={JSON.stringify(structuredData)} type="application/ld+json" />
        <ClientRouter />
    </head>
    <body class="flex flex-col overflow-x-clip relative isolate min-h-svh antialiased font-mono bg-night text-cream">
        <div class="grain fixed -z-10 pointer-events-none" aria-hidden="true" />
        <div class="vignette fixed inset-0 -z-20 pointer-events-none" aria-hidden="true" />
        <Starfield />
        <Navbar />
        <slot name="overlay" />
        <main class="flex flex-1 flex-col">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    .vignette {
        background: radial-gradient(ellipse at center, transparent 30%, var(--color-black-55) 100%);
    }
</style>

<script>
    import { LOADER_SHOWN_KEY } from '@lib/constants';
    import { initMotion } from '@lib/motion';

    function handlePageLoad() {
        initMotion();

        try {
            sessionStorage.setItem(LOADER_SHOWN_KEY, '1');
        } catch {
            return;
        }
    }

    document.addEventListener('astro:page-load', handlePageLoad);
</script>
