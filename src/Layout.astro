---
import '@fontsource/bebas-neue/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import { ClientRouter } from 'astro:transitions';

import '@/global.css';
import '@/styles.css';
import Footer from '@sections/Footer.astro';
import Navbar from '@sections/Navbar.astro';
import Starfield from '@components/Starfield.astro';

interface Props {
    description: string;
    noindex?: boolean;
    title: string;
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const { description, noindex, title } = Astro.props;
const ogImageUrl = `${Astro.site}og.png`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1" name="viewport" />
        <title>{title}</title>
        <meta content={description} name="description" />
        <meta content="Kevin Huang" name="author" />
        <meta content="#0a0a0f" name="theme-color" />
        <meta content={noindex ? 'noindex, nofollow' : 'index, follow'} name="robots" />
        <link href={canonicalUrl} rel="canonical" />
        <link href="/apple-touch-icon.png" rel="apple-touch-icon" />
        <link href="/favicon.png" rel="icon" type="image/png" />
        <meta content={title} property="og:title" />
        <meta content={description} property="og:description" />
        <meta content={ogImageUrl} property="og:image" />
        <meta content={canonicalUrl} property="og:url" />
        <meta content="Austin Music Video Film Festival" property="og:site_name" />
        <meta content="website" property="og:type" />
        <meta content="summary_large_image" name="twitter:card" />
        <meta content={title} name="twitter:title" />
        <meta content={description} name="twitter:description" />
        <meta content={ogImageUrl} name="twitter:image" />
        <script
            is:inline
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebSite',
                'author': {
                    '@type': 'Person',
                    'name': 'Kevin Huang',
                },
                'inLanguage': 'en',
                'name': 'Austin Music Video Film Festival',
                'url': Astro.site,
            })}
            type="application/ld+json"
        />
        <ClientRouter />
    </head>
    <body class="flex flex-col overflow-x-clip relative isolate min-h-screen antialiased bg-night text-cream">
        <div class="grain fixed -z-10 pointer-events-none" aria-hidden="true" />
        <div class="vignette fixed inset-0 -z-20 pointer-events-none" aria-hidden="true" />
        <Starfield />
        <Navbar />
        <main class="flex flex-1 flex-col">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    .vignette {
        background: radial-gradient(ellipse at center, transparent 30%, var(--color-black-55) 100%);
    }
</style>

<script>
    import { LOADER_SHOWN_KEY } from '@lib/constants';
    import { initMotion } from '@lib/motion';

    function handlePageLoad() {
        initMotion();

        try {
            sessionStorage.setItem(LOADER_SHOWN_KEY, '1');
        } catch {
            return;
        }
    }

    document.addEventListener('astro:page-load', handlePageLoad);
</script>
