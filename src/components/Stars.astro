<div class="starfield fixed overflow-hidden" aria-hidden="true">
    <div class="starfield__layer absolute" data-parallax="-0.15"></div>
    <div class="starfield__layer absolute" data-parallax="-0.35"></div>
    <div class="starfield__layer absolute" data-parallax="-0.65"></div>
</div>

<style>
    .starfield {
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }

    .starfield__layer {
        backface-visibility: hidden;
        inset: -10%;
        will-change: transform;
    }

    .starfield__layer:nth-child(1) {
        animation: twinkle 6s ease-in-out infinite alternate;
        background-image:
            radial-gradient(1.2px 1.2px at 58% 8%, rgba(244, 241, 234, 0.5), transparent),
            radial-gradient(1px 1px at 8% 12%, rgba(244, 241, 234, 0.7), transparent),
            radial-gradient(1.3px 1.3px at 38% 18%, rgba(244, 241, 234, 0.6), transparent),
            radial-gradient(1px 1px at 78% 22%, rgba(244, 241, 234, 0.7), transparent),
            radial-gradient(1.1px 1.1px at 22% 28%, rgba(244, 241, 234, 0.5), transparent),
            radial-gradient(1px 1px at 92% 35%, rgba(244, 241, 234, 0.5), transparent),
            radial-gradient(1.2px 1.2px at 68% 38%, rgba(244, 241, 234, 0.4), transparent),
            radial-gradient(1px 1px at 45% 42%, rgba(244, 241, 234, 0.35), transparent),
            radial-gradient(1.1px 1.1px at 12% 48%, rgba(244, 241, 234, 0.6), transparent),
            radial-gradient(1px 1px at 85% 52%, rgba(244, 241, 234, 0.5), transparent),
            radial-gradient(1.3px 1.3px at 32% 62%, rgba(244, 241, 234, 0.35), transparent),
            radial-gradient(1px 1px at 75% 65%, rgba(244, 241, 234, 0.7), transparent),
            radial-gradient(1.2px 1.2px at 5% 68%, rgba(244, 241, 234, 0.6), transparent),
            radial-gradient(1px 1px at 55% 72%, rgba(244, 241, 234, 0.4), transparent),
            radial-gradient(1.1px 1.1px at 95% 78%, rgba(244, 241, 234, 0.5), transparent),
            radial-gradient(1px 1px at 18% 85%, rgba(244, 241, 234, 0.6), transparent),
            radial-gradient(1.3px 1.3px at 65% 88%, rgba(244, 241, 234, 0.55), transparent),
            radial-gradient(1px 1px at 42% 92%, rgba(244, 241, 234, 0.4), transparent),
            radial-gradient(1.2px 1.2px at 88% 95%, rgba(244, 241, 234, 0.6), transparent);
        opacity: 0.35;
    }

    .starfield__layer:nth-child(2) {
        animation: twinkle 8s ease-in-out infinite alternate-reverse;
        background-image:
            radial-gradient(2px 2px at 15% 10%, rgba(244, 241, 234, 0.8), transparent),
            radial-gradient(1.8px 1.8px at 82% 15%, rgba(244, 241, 234, 0.7), transparent),
            radial-gradient(2.2px 2.2px at 48% 22%, rgba(244, 241, 234, 0.6), transparent),
            radial-gradient(1.8px 1.8px at 38% 35%, rgba(244, 241, 234, 0.4), transparent),
            radial-gradient(2px 2px at 8% 42%, rgba(244, 241, 234, 0.55), transparent),
            radial-gradient(2.3px 2.3px at 62% 48%, rgba(244, 241, 234, 0.4), transparent),
            radial-gradient(2px 2px at 92% 55%, rgba(244, 241, 234, 0.85), transparent),
            radial-gradient(1.8px 1.8px at 25% 68%, rgba(244, 241, 234, 0.65), transparent),
            radial-gradient(2.2px 2.2px at 72% 75%, rgba(244, 241, 234, 0.55), transparent),
            radial-gradient(2px 2px at 88% 85%, rgba(244, 241, 234, 0.6), transparent),
            radial-gradient(1.8px 1.8px at 5% 88%, rgba(244, 241, 234, 0.6), transparent),
            radial-gradient(2px 2px at 55% 92%, rgba(244, 241, 234, 0.7), transparent);
        opacity: 0.55;
    }

    .starfield__layer:nth-child(3) {
        animation: twinkle 10s ease-in-out infinite alternate;
        background-image:
            radial-gradient(3px 3px at 52% 18%, rgba(244, 241, 234, 0.7), transparent),
            radial-gradient(2.8px 2.8px at 10% 25%, rgba(244, 241, 234, 0.75), transparent),
            radial-gradient(3.2px 3.2px at 85% 42%, rgba(244, 241, 234, 0.65), transparent),
            radial-gradient(3px 3px at 68% 65%, rgba(244, 241, 234, 0.7), transparent),
            radial-gradient(2.8px 2.8px at 22% 72%, rgba(244, 241, 234, 0.75), transparent),
            radial-gradient(3px 3px at 92% 88%, rgba(244, 241, 234, 0.75), transparent);
        opacity: 0.85;
    }

    [data-theme='light'] .starfield__layer {
        opacity: 0.18 !important;
    }

    @keyframes twinkle {
        from {
            opacity: 0.3;
        }
        to {
            opacity: 1;
        }
    }
</style>
