<div
    class="starfield fixed inset-0 overflow-hidden -z-30 pointer-events-none"
    aria-hidden="true"
    transition:persist="starfield"
>
    <div class="starfield__layer absolute backface-hidden will-change-transform" data-parallax="-0.15" data-parallax-wrap="720" />
    <div class="starfield__layer absolute backface-hidden will-change-transform" data-parallax="-0.35" data-parallax-wrap="880" />
    <div class="starfield__layer absolute backface-hidden will-change-transform" data-parallax="-0.65" data-parallax-wrap="1040" />
</div>

<style>
    .starfield__layer {
        animation: starfield__twinkle var(--starfield-duration) ease-in-out var(--starfield-delay) infinite alternate;
        background-size: 100% var(--starfield-period);
        inset: 0 0 calc(-1 * var(--starfield-period));
        opacity: var(--starfield-rest);
    }

    .starfield__layer:nth-child(1) {
        --starfield-delay: 0s;
        --starfield-duration: 6s;
        --starfield-period: 720px;
        --starfield-rest: 0.5;
        --twinkle-max: 0.6;
        --twinkle-min: 0.25;
        background-image:
            radial-gradient(1.2px 1.2px at 5% 16%, var(--color-cream-70), transparent),
            radial-gradient(1.1px 1.1px at 28% 14%, var(--color-cream-85), transparent),
            radial-gradient(1.2px 1.2px at 44% 11%, var(--color-cream-85), transparent),
            radial-gradient(1.3px 1.3px at 61% 15%, var(--color-cream-70), transparent),
            radial-gradient(1.1px 1.1px at 73% 9%, var(--color-cream-85), transparent),
            radial-gradient(1px 1px at 95% 8%, var(--color-cream-85), transparent),
            radial-gradient(1.3px 1.3px at 6% 38%, var(--color-cream-70), transparent),
            radial-gradient(1px 1px at 22% 33%, var(--color-cream-60), transparent),
            radial-gradient(1.2px 1.2px at 43% 37%, var(--color-cream-60), transparent),
            radial-gradient(1px 1px at 59% 41%, var(--color-cream-60), transparent),
            radial-gradient(1.3px 1.3px at 75% 42%, var(--color-cream-60), transparent),
            radial-gradient(1.1px 1.1px at 94% 34%, var(--color-cream-60), transparent),
            radial-gradient(1.4px 1.4px at 11% 67%, var(--color-cream-70), transparent),
            radial-gradient(1.2px 1.2px at 25% 64%, var(--color-cream-70), transparent),
            radial-gradient(1.3px 1.3px at 39% 62%, var(--color-cream-85), transparent),
            radial-gradient(1.1px 1.1px at 55% 59%, var(--color-cream-70), transparent),
            radial-gradient(1.2px 1.2px at 78% 58%, var(--color-cream-70), transparent),
            radial-gradient(1.4px 1.4px at 90% 60%, var(--color-cream-70), transparent),
            radial-gradient(1px 1px at 7% 88%, var(--color-cream-70), transparent),
            radial-gradient(1.2px 1.2px at 23% 91%, var(--color-cream-85), transparent),
            radial-gradient(1.2px 1.2px at 45% 89%, var(--color-cream-85), transparent),
            radial-gradient(1.4px 1.4px at 57% 85%, var(--color-cream-60), transparent),
            radial-gradient(1px 1px at 77% 83%, var(--color-cream-70), transparent),
            radial-gradient(1.2px 1.2px at 91% 87%, var(--color-cream-60), transparent);
    }

    .starfield__layer:nth-child(2) {
        --starfield-delay: -3.5s;
        --starfield-duration: 8s;
        --starfield-period: 880px;
        --starfield-rest: 0.72;
        --twinkle-max: 0.82;
        --twinkle-min: 0.45;
        background-image:
            radial-gradient(1.9px 1.9px at 14% 10%, var(--color-cream), var(--color-cream-15) 3px, transparent 5px),
            radial-gradient(2.1px 2.1px at 27% 23%, var(--color-cream-85), transparent),
            radial-gradient(1.9px 1.9px at 47% 22%, var(--color-cream-85), transparent),
            radial-gradient(2px 2px at 71% 19%, var(--color-cream-70), transparent),
            radial-gradient(1.7px 1.7px at 92% 18%, var(--color-cream), transparent),
            radial-gradient(1.9px 1.9px at 12% 49%, var(--color-cream-85), var(--color-cream-15) 3px, transparent 5px),
            radial-gradient(2.1px 2.1px at 33% 56%, var(--color-cream-85), transparent),
            radial-gradient(1.9px 1.9px at 66% 51%, var(--color-cream-70), transparent),
            radial-gradient(2.1px 2.1px at 87% 44%, var(--color-cream), transparent),
            radial-gradient(1.8px 1.8px at 8% 78%, var(--color-cream-70), var(--color-cream-15) 3px, transparent 5px),
            radial-gradient(2px 2px at 29% 80%, var(--color-cream), var(--color-cream-15) 3px, transparent 5px),
            radial-gradient(2.2px 2.2px at 48% 82%, var(--color-cream-70), var(--color-cream-15) 3px, transparent 5px),
            radial-gradient(1.8px 1.8px at 68% 90%, var(--color-cream), var(--color-cream-15) 3px, transparent 5px),
            radial-gradient(2px 2px at 88% 77%, var(--color-cream-70), transparent);
    }

    .starfield__layer:nth-child(3) {
        --starfield-delay: -7s;
        --starfield-duration: 10s;
        --starfield-period: 1040px;
        --starfield-rest: 0.95;
        --twinkle-max: 1;
        --twinkle-min: 0.7;
        background-image:
            radial-gradient(3.2px 3.2px at 15% 84%, var(--color-cream), var(--color-cream-35) 4px, transparent 8px),
            radial-gradient(2.9px 2.9px at 26% 40%, var(--color-cream), var(--color-cream-35) 4px, transparent 8px),
            radial-gradient(2.6px 2.6px at 37% 48%, var(--color-cream), var(--color-cream-35) 4px, transparent 8px),
            radial-gradient(2.8px 2.8px at 44% 71.5%, var(--color-cream), var(--color-cream-35) 4px, transparent 8px),
            radial-gradient(2.9px 2.9px at 52% 28%, var(--color-cream), var(--color-cream-35) 4px, transparent 8px),
            radial-gradient(2.7px 2.7px at 62% 63%, var(--color-cream), var(--color-cream-35) 4px, transparent 8px),
            radial-gradient(2.9px 2.9px at 76% 75%, var(--color-cream), var(--color-cream-35) 4px, transparent 8px),
            radial-gradient(3.2px 3.2px at 86% 13%, var(--color-cream), var(--color-cream-35) 4px, transparent 8px);
    }

    @keyframes starfield__twinkle {
        from {
            opacity: var(--twinkle-min);
        }

        to {
            opacity: var(--twinkle-max);
        }
    }
</style>
