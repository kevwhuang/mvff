<div
    class="starfield fixed inset-0 overflow-hidden -z-30 pointer-events-none"
    aria-hidden="true"
    transition:persist="starfield"
>
    <div class="starfield__layer absolute backface-hidden will-change-transform" data-parallax="-0.15" />
    <div class="starfield__layer absolute backface-hidden will-change-transform" data-parallax="-0.35" />
    <div class="starfield__layer absolute backface-hidden will-change-transform" data-parallax="-0.65" />
</div>

<style>
    .starfield__layer {
        animation: starfield__twinkle var(--starfield-duration) ease-in-out var(--starfield-delay) infinite alternate;
        inset: -10%;
        opacity: var(--starfield-rest);
    }

    .starfield__layer:nth-child(1) {
        --starfield-delay: 0s;
        --starfield-duration: var(--duration-twinkle);
        --starfield-rest: 0.5;
        --twinkle-max: 0.6;
        --twinkle-min: 0.25;
        background-image:
            radial-gradient(1.2px 1.2px at 3% 18%, var(--color-cream-70), transparent),
            radial-gradient(1.2px 1.2px at 23% 17%, var(--color-cream-85), transparent),
            radial-gradient(1.2px 1.2px at 38% 4%, var(--color-cream-85), transparent),
            radial-gradient(1.2px 1.2px at 57% 20%, var(--color-cream-60), transparent),
            radial-gradient(1px 1px at 69% 11%, var(--color-cream-60), transparent),
            radial-gradient(1px 1px at 95% 8%, var(--color-cream-70), transparent),
            radial-gradient(1px 1px at 2% 39%, var(--color-cream-70), transparent),
            radial-gradient(1.3px 1.3px at 30% 36%, var(--color-cream-85), transparent),
            radial-gradient(1.1px 1.1px at 43% 28%, var(--color-cream-60), transparent),
            radial-gradient(1.3px 1.3px at 59% 27%, var(--color-cream-60), transparent),
            radial-gradient(1.4px 1.4px at 70% 28%, var(--color-cream-70), transparent),
            radial-gradient(1.1px 1.1px at 87% 43%, var(--color-cream-85), transparent),
            radial-gradient(1.4px 1.4px at 4% 62%, var(--color-cream-60), transparent),
            radial-gradient(1.4px 1.4px at 22% 65%, var(--color-cream-70), transparent),
            radial-gradient(1px 1px at 40% 68%, var(--color-cream-85), transparent),
            radial-gradient(1.2px 1.2px at 60% 64%, var(--color-cream-85), transparent),
            radial-gradient(1.1px 1.1px at 73% 57%, var(--color-cream-70), transparent),
            radial-gradient(1px 1px at 94% 66%, var(--color-cream-60), transparent),
            radial-gradient(1.3px 1.3px at 12% 80%, var(--color-cream-70), transparent),
            radial-gradient(1.2px 1.2px at 26% 82%, var(--color-cream-70), transparent),
            radial-gradient(1.1px 1.1px at 44% 94%, var(--color-cream-85), transparent),
            radial-gradient(1.2px 1.2px at 63% 90%, var(--color-cream-70), transparent),
            radial-gradient(1.2px 1.2px at 71% 84%, var(--color-cream-60), transparent),
            radial-gradient(1.3px 1.3px at 92% 97%, var(--color-cream-70), transparent);
    }

    .starfield__layer:nth-child(2) {
        --starfield-delay: -3.5s;
        --starfield-duration: var(--duration-twinkle-slow);
        --starfield-rest: 0.72;
        --twinkle-max: 0.82;
        --twinkle-min: 0.45;
        background-image:
            radial-gradient(1.9px 1.9px at 17% 9%, var(--color-cream-85), var(--color-cream-15) 3px, transparent 5px),
            radial-gradient(1.8px 1.8px at 50% 13%, var(--color-cream-70), var(--color-cream-15) 3px, transparent 5px),
            radial-gradient(2px 2px at 73% 20%, var(--color-cream-70), transparent),
            radial-gradient(1.9px 1.9px at 84% 28%, var(--color-cream-70), transparent),
            radial-gradient(1.9px 1.9px at 4% 49%, var(--color-cream), var(--color-cream-15) 3px, transparent 5px),
            radial-gradient(2px 2px at 36% 59%, var(--color-cream), var(--color-cream-15) 3px, transparent 5px),
            radial-gradient(2.2px 2.2px at 51% 44%, var(--color-cream-70), var(--color-cream-15) 3px, transparent 5px),
            radial-gradient(2.1px 2.1px at 68% 62%, var(--color-cream-85), transparent),
            radial-gradient(1.7px 1.7px at 90% 43%, var(--color-cream), transparent),
            radial-gradient(1.8px 1.8px at 17% 94%, var(--color-cream), var(--color-cream-15) 3px, transparent 5px),
            radial-gradient(1.9px 1.9px at 37% 86%, var(--color-cream-85), transparent),
            radial-gradient(2px 2px at 58% 91%, var(--color-cream-70), transparent),
            radial-gradient(2.1px 2.1px at 75% 82%, var(--color-cream-85), transparent),
            radial-gradient(2.1px 2.1px at 92% 92%, var(--color-cream), transparent);
    }

    .starfield__layer:nth-child(3) {
        --starfield-delay: -7s;
        --starfield-duration: var(--duration-twinkle-slower);
        --starfield-rest: 0.95;
        --twinkle-max: 1;
        --twinkle-min: 0.7;
        background-image:
            radial-gradient(2.9px 2.9px at 19% 18%, var(--color-cream), var(--color-cream-35) 4px, transparent 8px),
            radial-gradient(2.7px 2.7px at 33% 19%, var(--color-cream), var(--color-cream-35) 4px, transparent 8px),
            radial-gradient(2.9px 2.9px at 62% 32%, var(--color-cream), var(--color-cream-35) 4px, transparent 8px),
            radial-gradient(2.9px 2.9px at 77% 27%, var(--color-cream), var(--color-cream-35) 4px, transparent 8px),
            radial-gradient(3.2px 3.2px at 18% 72%, var(--color-cream), var(--color-cream-35) 4px, transparent 8px),
            radial-gradient(2.6px 2.6px at 43% 75%, var(--color-cream), var(--color-cream-35) 4px, transparent 8px),
            radial-gradient(3.2px 3.2px at 67% 85%, var(--color-cream), var(--color-cream-35) 4px, transparent 8px);
    }

    @keyframes starfield__twinkle {
        from {
            opacity: var(--twinkle-min);
        }

        to {
            opacity: var(--twinkle-max);
        }
    }
</style>
