---
interface Props {
    headingId: string;
    level?: 'h1' | 'h2';
    number: string;
}

const { headingId, level: Heading = 'h1', number } = Astro.props;
---

<div class="section__head grid select-none" data-scroll>
    <span class="section__number">{number}</span>
    <Heading
        id={headingId}
        class="section__title"
    >
        <slot />
    </Heading>
</div>

<style>
    .section__head {
        align-items: end;
        border-bottom: 1px solid var(--color-cream-15);
        gap: 12px 24px;
        grid-template-columns: auto 1fr;
        margin-bottom: clamp(48px, 6vw, 80px);
        padding-bottom: 16px;
    }

    .section__number {
        color: var(--color-coral);
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.2em;
    }

    .section__title {
        font-size: clamp(40px, 7vw, 88px);
        line-height: 0.9;
        text-transform: uppercase;
    }

    @media (max-width: 768px) {
        .section__head {
            grid-template-columns: 1fr;
        }
    }
</style>
