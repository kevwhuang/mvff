---
import { LINKS, ROUTES } from '@lib/constants';
import { getExternalLinkProps } from '@lib/utils';
---

<footer class="footer border-cream-15 border-t bg-navy">
    <div class="footer__inner shell grid items-start">
        <div class="flex flex-col gap-4">
            <a
                class="footer__title py-1 font-display no-underline text-cream select-none"
                href="/"
            >
                Austin Music Video Film Festival
            </a>
            <p class="footer__tag max-w-90 font-serif italic text-xl text-cream-60">Austin's music video scene, staged like a premiere: live sets, screening blocks, awards, and an after party that ran to 2 AM. One night at Cabana Club.</p>
        </div>
        <nav
            class="contents"
            aria-label="Footer"
        >
            <div class="footer__column">
                <h2 class="footer__heading mb-4 pt-2 uppercase text-cream-60">Site</h2>
                <ul class="list-none">
                    {ROUTES.map(route => (
                        <li>
                            <a
                                class="footer__link block py-3 font-display no-underline text-cream select-none"
                                aria-disabled={route.isDisabled ? 'true' : undefined}
                                href={route.href}
                                tabindex={route.isDisabled ? '-1' : undefined}
                                {...(route.isDisabled ? {} : getExternalLinkProps(route.href))}
                            >
                                {route.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
            <div class="footer__column">
                <h2 class="footer__heading mb-4 pt-2 uppercase text-cream-60">Connect</h2>
                <ul class="list-none">
                    <li>
                        <a
                            class="footer__link block py-3 font-display no-underline text-cream select-none"
                            href={LINKS.instagram}
                            {...getExternalLinkProps(LINKS.instagram)}
                        >
                            Instagram
                        </a>
                    </li>
                    <li>
                        <a
                            class="footer__link block py-3 font-display no-underline text-cream select-none"
                            href={LINKS.email}
                        >
                            Email
                        </a>
                    </li>
                    <li>
                        <a
                            class="footer__link block py-3 font-display no-underline text-cream select-none"
                            href={LINKS.phone}
                        >
                            Phone
                        </a>
                    </li>
                    <li>
                        <a
                            class="footer__link block py-3 font-display no-underline text-cream select-none"
                            href={LINKS.calendly}
                            {...getExternalLinkProps(LINKS.calendly)}
                        >
                            Schedule Call
                        </a>
                    </li>
                </ul>
            </div>
            <div class="footer__column">
                <h2 class="footer__heading mb-4 pt-2 uppercase text-cream-60">Insider</h2>
                <ul class="list-none">
                    <li>
                        <a
                            class="footer__link block py-3 font-display no-underline text-cream select-none"
                            href={LINKS.pitchDeck}
                            rel="noopener"
                            target="_blank"
                        >
                            Pitch Deck
                        </a>
                    </li>
                    <li>
                        <a
                            class="footer__link block py-3 font-display no-underline text-cream select-none"
                            aria-disabled="true"
                            href={LINKS.filmfreeway}
                            tabindex="-1"
                        >
                            FilmFreeway
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </div>
    <div class="footer__bottom shell flex flex-wrap justify-between gap-x-16 gap-y-3 border-cream-15 border-t font-mono uppercase text-cream-60">
        <p>&copy; 2026 Austin Music Video Film Festival &middot; All rights reserved</p>
        <p><time datetime="2026-07-18">July 18, 2026</time> &middot; <time datetime="2026-07-18T19:00-05:00">7 PM</time>&nbsp;&ndash;&nbsp;<time datetime="2026-07-19T02:00-05:00">2 AM</time> &middot; Cabana Club &middot; Austin, TX</p>
    </div>
</footer>

<style>
    .footer {
        padding: var(--section-padding-sm) 0 clamp(24px, calc(21.33px + 0.83vw), 32px);
    }

    .footer__bottom {
        font-size: 10px;
        letter-spacing: 0.2em;
        padding-block: 16px 0;
    }

    .footer__heading {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.2em;
        line-height: 1.5;
    }

    .footer__inner {
        gap: clamp(24px, calc(16px + 2.5vw), 48px);
        grid-template-columns: 2fr 1fr 1fr 1fr;
        margin-bottom: clamp(48px, calc(42.67px + 1.67vw), 64px);
    }

    .footer__link {
        font-size: 20px;
        letter-spacing: 0.02em;
        transition: color var(--duration-fast) ease;
    }

    .footer__link:active {
        color: var(--color-coral);
    }

    .footer__link:hover {
        color: var(--color-coral);
    }

    .footer__link[aria-disabled='true'] {
        color: var(--color-cream-60);
        cursor: not-allowed;
        opacity: 0.4;
    }

    .footer__link[aria-disabled='true']:active {
        color: var(--color-cream-60);
    }

    .footer__link[aria-disabled='true']:hover {
        color: var(--color-cream-60);
    }

    .footer__title {
        font-size: clamp(32px, calc(26.67px + 1.67vw), 48px);
        letter-spacing: 0.04em;
        line-height: 1.1;
        transition: color var(--duration-fast) ease;
    }

    .footer__title:active {
        color: var(--color-coral);
    }

    .footer__title:hover {
        color: var(--color-coral);
    }

    @media (max-width: 1024px) {
        .footer__inner {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 768px) {
        .footer__inner {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    import { initDisabledLinks, registerPageScript } from '@lib/utils';

    function initFooter(signal: AbortSignal) {
        initDisabledLinks('.footer__link[aria-disabled="true"]', signal);
    }

    registerPageScript(initFooter);
</script>
