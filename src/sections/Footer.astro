---
import { LINKS, ROUTES } from '@lib/constants';
---

<footer
    class="site-footer"
    aria-label="Site footer"
>
    <div class="shell site-footer__inner grid items-start">
        <div class="flex flex-col gap-4">
            <a
                class="site-footer__title"
                href="/"
            >
                Austin Music Video Film Festival
            </a>
            <p class="site-footer__tag">Austin's music video scene, staged like a premiere &mdash; music-video screenings, live nominee sets, awards, and a pool party that runs to 2 AM. One night at Cabana Club.</p>
        </div>
        <div class="site-footer__col">
            <h2 class="site-footer__heading">Site</h2>
            <ul class="list-none">
                {ROUTES.map(route => (
                    <li>
                        <a
                            class="site-footer__link"
                            href={route.href}
                            target={route.href.startsWith('http') ? '_blank' : undefined}
                        >
                            {route.label}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
        <div class="site-footer__col">
            <h2 class="site-footer__heading">Connect</h2>
            <ul class="list-none">
                <li>
                    <a
                        class="site-footer__link"
                        href={LINKS.instagram}
                        target="_blank"
                    >
                        Instagram
                    </a>
                </li>
                <li>
                    <a class="site-footer__link" href={LINKS.email}>Email</a>
                </li>
                <li>
                    <a
                        class="site-footer__link"
                        href={LINKS.calendly}
                        target="_blank"
                    >
                        Schedule a Call
                    </a>
                </li>
            </ul>
        </div>
        <div class="site-footer__col">
            <h2 class="site-footer__heading">Insider</h2>
            <ul class="list-none">
                <li>
                    <a
                        class="site-footer__link"
                        href={LINKS.filmfreeway}
                        target="_blank"
                    >
                        FilmFreeway
                    </a>
                </li>
                <li>
                    <a
                        class="site-footer__link"
                        href={LINKS.pitchDeck}
                        target="_blank"
                    >
                        Pitch Deck
                    </a>
                </li>
            </ul>
        </div>
    </div>
    <div class="shell site-footer__bottom flex flex-wrap justify-between">
        <span>&copy; 2026 Austin Music Video Film Festival &middot; All rights reserved</span>
        <span><time datetime="2026-07-18T19:00-05:00">July 18, 2026</time> &middot; 7 PM&ndash;2 AM &middot; Cabana Club &middot; Austin, TX</span>
    </div>
</footer>

<style>
    .site-footer {
        background: var(--color-navy);
        border-top: 1px solid var(--color-cream-15);
        padding: clamp(48px, calc(37.33px + 3.33vw), 80px) 0 clamp(24px, calc(21.33px + 0.83vw), 32px);
    }

    .site-footer__bottom {
        border-top: 1px solid var(--color-cream-15);
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 10px;
        gap: 12px;
        letter-spacing: 0.16em;
        padding-block: 16px 0;
        text-transform: uppercase;
    }

    .site-footer__heading {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 400;
        letter-spacing: 0.22em;
        margin-bottom: 16px;
        text-transform: uppercase;
    }

    .site-footer__inner {
        gap: clamp(24px, calc(16px + 2.5vw), 48px);
        grid-template-columns: 2fr 1fr 1fr 1fr;
        margin-bottom: clamp(48px, calc(42.67px + 1.67vw), 64px);
    }

    .site-footer__link {
        color: var(--color-cream);
        display: block;
        font-family: var(--font-display);
        font-size: 18px;
        padding: 8px 0;
        text-decoration: none;
        transition:
            color var(--duration-fast) ease,
            transform var(--duration-fast) ease;
    }

    .site-footer__link:active,
    .site-footer__link:hover {
        color: var(--color-coral);
        transform: translateX(4px);
    }

    .site-footer__tag {
        color: var(--color-cream-60);
        font-family: var(--font-serif);
        font-size: 16px;
        font-style: italic;
        line-height: 1.4;
        max-width: 360px;
    }

    .site-footer__title {
        color: var(--color-cream);
        font-family: var(--font-display);
        font-size: clamp(36px, calc(30.67px + 1.67vw), 52px);
        letter-spacing: 0.04em;
        line-height: 1.1;
        text-decoration: none;
        transition: color var(--duration-fast) ease;
    }

    .site-footer__title:active,
    .site-footer__title:hover {
        color: var(--color-coral);
    }

    @media (max-width: 1024px) {
        .site-footer__inner {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 768px) {
        .site-footer__inner {
            grid-template-columns: 1fr;
        }
    }
</style>
