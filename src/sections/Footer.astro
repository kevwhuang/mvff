---
import { Image } from 'astro:assets';

import logo from '@images/logos/atx_music_video_film_festival.webp';
import { LINKS, ROUTES } from '@lib/utils';
---

<footer
    class="site-footer"
    aria-label="Site footer"
>
    <div class="shell site-footer__inner">
        <div class="flex flex-col gap-4">
            <div class="site-footer__mark">
                <Image
                    alt="ATX Music Video Film Festival"
                    densities={[1, 2]}
                    src={logo}
                    width={62}
                />
            </div>
            <p class="site-footer__tag">An immersive production blending music and film, celebrating artists. One night, one venue, every screen and stage active.</p>
        </div>
        <div class="site-footer__col">
            <h2>Site</h2>
            <ul class="list-none">
                {ROUTES.map(route => (
                    <li>
                        <a href={route.href}>{route.label}</a>
                    </li>
                ))}
            </ul>
        </div>
        <div class="site-footer__col">
            <h2>Connect</h2>
            <ul class="list-none">
                <li>
                    <a href={LINKS.email}>Email</a>
                </li>
                <li>
                    <a
                        href={LINKS.instagram}
                        rel="noopener noreferrer"
                        target="_blank"
                    >
                        Instagram
                    </a>
                </li>
                <li>
                    <a
                        href={LINKS.filmfreeway}
                        rel="noopener noreferrer"
                        target="_blank"
                    >
                        FilmFreeway
                    </a>
                </li>
            </ul>
        </div>
        <div class="site-footer__col">
            <h2>Inside</h2>
            <ul class="list-none">
                <li>
                    <a
                        href={LINKS.calendly}
                        rel="noopener noreferrer"
                        target="_blank"
                    >
                        Schedule a Call
                    </a>
                </li>
                <li>
                    <a
                        href={LINKS.pitchDeck}
                        rel="noopener noreferrer"
                        target="_blank"
                    >
                        Pitch Deck
                    </a>
                </li>
            </ul>
        </div>
    </div>
    <div class="shell site-footer__bottom">
        <span>&copy; 2026 ATX Music Video Film Festival. All rights reserved.</span>
        <nav
            class="flex gap-3"
            aria-label="Legal"
        >
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
        </nav>
        <span><time datetime="2026-07-18T19:00-05:00">JUL 18 2026</time> &middot; 7PM &rarr; 2AM &middot; CABANA CLUB &middot; AUSTIN TX</span>
    </div>
</footer>

<style>
    .site-footer {
        background: var(--color-navy);
        border-top: 1px solid var(--color-cream-15);
        padding: clamp(40px, 6vw, 60px) 0 clamp(20px, 3vw, 32px);
    }

    .site-footer__bottom {
        border-top: 1px solid var(--color-cream-15);
        color: var(--color-cream-60);
        display: flex;
        flex-wrap: wrap;
        font-family: var(--font-mono);
        font-size: 10.5px;
        gap: 12px;
        justify-content: space-between;
        letter-spacing: 0.16em;
        padding-block: 18px 0;
        text-transform: uppercase;
    }

    .site-footer__col a {
        color: var(--color-cream);
        display: block;
        font-family: var(--font-display);
        font-size: 18px;
        padding: 8px 0;
        text-decoration: none;
        transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
    }

    .site-footer__col a:active,
    .site-footer__col a:hover {
        color: var(--color-coral);
        transform: translateX(4px);
    }

    .site-footer__col h2 {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 400;
        letter-spacing: 0.22em;
        margin-bottom: 14px;
        text-transform: uppercase;
    }

    .site-footer__inner {
        align-items: start;
        display: grid;
        gap: clamp(24px, 4vw, 48px);
        grid-template-columns: 2fr 1fr 1fr 1fr;
        margin-bottom: clamp(40px, 5vw, 60px);
    }

    .site-footer__mark {
        background: var(--color-night);
        border: 1px solid var(--color-cream-15);
        display: grid;
        height: 80px;
        place-items: center;
        user-select: none;
        width: 80px;
    }

    .site-footer__tag {
        color: var(--color-cream-60);
        font-family: var(--font-serif);
        font-size: 16px;
        font-style: italic;
        line-height: 1.4;
        max-width: 360px;
    }

    @media (max-width: 1024px) {
        .site-footer__inner {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 768px) {
        .site-footer__inner {
            grid-template-columns: 1fr;
        }
    }
</style>
