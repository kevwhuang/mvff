---
import { LINKS, ROUTES } from '@lib/utils';
---

<footer
    class="site-footer"
    aria-label="Site footer"
>
    <div class="shell site-footer__inner grid items-start">
        <div class="flex flex-col gap-4">
            <a class="site-footer__title" href="/">ATX Music Video Film Festival</a>
            <p class="site-footer__tag">An immersive production where Austin's music and film worlds collide. Official selections, live acts, screening blocks, and a pool party. Every screen and stage active.</p>
        </div>
        <div class="site-footer__col">
            <h2>Site</h2>
            <ul class="list-none">
                {ROUTES.map(route => (
                    <li>
                        <a
                            href={route.href}
                            target={route.href.startsWith('http') ? '_blank' : undefined}
                        >
                            {route.label}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
        <div class="site-footer__col">
            <h2>Connect</h2>
            <ul class="list-none">
                <li>
                    <a
                        href={LINKS.instagram}
                        target="_blank"
                    >
                        Instagram
                    </a>
                </li>
                <li>
                    <a href={LINKS.email}>Email</a>
                </li>
                <li>
                    <a
                        href={LINKS.calendly}
                        target="_blank"
                    >
                        Schedule a Call
                    </a>
                </li>
            </ul>
        </div>
        <div class="site-footer__col">
            <h2>Insider</h2>
            <ul class="list-none">
                <li>
                    <a
                        href={LINKS.filmfreeway}
                        target="_blank"
                    >
                        FilmFreeway
                    </a>
                </li>
                <li>
                    <a
                        href={LINKS.pitchDeck}
                        target="_blank"
                    >
                        Pitch Deck
                    </a>
                </li>
            </ul>
        </div>
    </div>
    <div class="shell site-footer__bottom flex flex-wrap justify-between select-none">
        <span>&copy; 2026 ATX MVFF &middot; All rights reserved</span>
        <span><time datetime="2026-07-18T19:00-05:00">July 18, 2026</time> &middot; 7pm &ndash; 2am &middot; Cabana Club &middot; Austin, TX</span>
        <nav
            class="flex gap-3"
            aria-label="Legal"
        >
            <a href="/privacy">Privacy</a>
            <span aria-hidden="true">&middot;</span>
            <a href="/terms">Terms</a>
        </nav>
    </div>
</footer>

<style>
    .site-footer {
        background: var(--color-navy);
        border-top: 1px solid var(--color-cream-15);
        padding: clamp(48px, 8vw, 80px) 0 clamp(24px, 3vw, 32px);
    }

    .site-footer__bottom {
        border-top: 1px solid var(--color-cream-15);
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 10.5px;
        gap: 12px;
        letter-spacing: 0.16em;
        padding-block: 16px 0;
        text-transform: uppercase;
    }

    .site-footer__col a {
        color: var(--color-cream);
        display: block;
        font-family: var(--font-display);
        font-size: 18px;
        padding: 8px 0;
        text-decoration: none;
        transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
    }

    .site-footer__col a:active,
    .site-footer__col a:hover {
        color: var(--color-coral);
        transform: translateX(4px);
    }

    .site-footer__col h2 {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 400;
        letter-spacing: 0.22em;
        margin-bottom: 16px;
        text-transform: uppercase;
    }

    .site-footer__inner {
        gap: clamp(24px, 4vw, 48px);
        grid-template-columns: 2fr 1fr 1fr 1fr;
        margin-bottom: clamp(48px, 5vw, 64px);
    }

    .site-footer__tag {
        color: var(--color-cream-60);
        font-family: var(--font-serif);
        font-size: 16px;
        font-style: italic;
        line-height: 1.4;
        max-width: 360px;
    }

    .site-footer__title {
        color: var(--color-cream);
        font-family: var(--font-display);
        font-size: clamp(36px, 5vw, 52px);
        letter-spacing: 0.04em;
        line-height: 1.1;
        text-decoration: none;
        transition: color var(--duration-fast) ease;
    }

    .site-footer__title:active,
    .site-footer__title:hover {
        color: var(--color-coral);
    }

    @media (max-width: 1024px) {
        .site-footer__inner {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 768px) {
        .site-footer__inner {
            grid-template-columns: 1fr;
        }
    }
</style>
