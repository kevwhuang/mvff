---
import poster from '@images/poster.webp';
---

<section
    class="hero relative overflow-hidden"
    aria-label="Hero"
>
    <div class="hero__bg absolute">
        <video
            aria-label="Event highlight reel"
            autoplay
            loop
            muted
            playsinline
            poster={poster.src}
        >
            <source src="/videos/hero.webm" type="video/webm" />
        </video>
    </div>

    <div class="hero__frame-tl absolute" aria-hidden="true"></div>
    <div class="hero__frame-tr absolute" aria-hidden="true"></div>
    <div class="hero__frame-bl absolute" aria-hidden="true"></div>
    <div class="hero__frame-br absolute" aria-hidden="true"></div>

    <div class="hero__countdown" aria-label="Event countdown">
        <div>
            <div id="hero-days" class="hero__countdown-num">00</div>
            <div class="hero__countdown-lbl">Days</div>
        </div>
        <div>
            <div id="hero-hrs" class="hero__countdown-num">00</div>
            <div class="hero__countdown-lbl">Hrs</div>
        </div>
        <div>
            <div id="hero-min" class="hero__countdown-num">00</div>
            <div class="hero__countdown-lbl">Min</div>
        </div>
        <div>
            <div id="hero-sec" class="hero__countdown-num">00</div>
            <div class="hero__countdown-lbl">Sec</div>
        </div>
    </div>

    <div class="hero__content relative">
        <div
            class="hero__meta flex flex-wrap items-center"
            data-scroll
        >
            <span class="hero__meta-item">VOL. 01 / EST. 2026</span>
            <span class="hero__meta-item">Cabana Club · Austin TX</span>
            <span class="hero__meta-item">07 · 18 · 2026 — 19:00 CDT</span>
        </div>
        <h1
            class="hero__title"
            data-scroll
            data-scroll-delay="0.1"
        >
            Music<br />Video<br />Film <span class="hero__title-accent">Fest</span>
        </h1>
        <p
            class="hero__sub"
            data-scroll
            data-scroll-delay="0.2"
        >One night where Austin's music and film worlds collide. Twelve programmed acts, four screening blocks, one pool party.
        </p>
        <div
            class="hero__actions flex flex-wrap items-center"
            data-scroll
            data-scroll-delay="0.3"
        >
            <a
                class="btn btn--primary"
                href="https://filmfreeway.com/atxmusicvideofilmfestival"
                rel="noopener noreferrer"
                target="_blank"
            >
                Submit a Video →
            </a>
            <a
                class="btn"
                href="/info"
            >See the Lineup
            </a>
        </div>
    </div>
</section>

<style>
    .hero {
        align-items: end;
        display: grid;
        isolation: isolate;
        min-height: calc(100vh - 70px);
    }

    .hero__bg {
        inset: 0;
        z-index: -1;
    }

    .hero__bg video {
        filter: brightness(0.55) contrast(1.1) saturate(1.15);
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .hero__bg::after {
        background:
            linear-gradient(180deg, var(--color-night-40) 0%, transparent 30%, transparent 60%, var(--color-night) 100%),
            radial-gradient(ellipse at 50% 70%, transparent 30%, var(--color-night-70) 100%);
        content: '';
        inset: 0;
        position: absolute;
    }

    .hero__frame-tl,
    .hero__frame-tr,
    .hero__frame-bl,
    .hero__frame-br {
        border: 1px solid var(--color-cream);
        height: 28px;
        width: 28px;
    }

    .hero__frame-tl {
        border-bottom: none;
        border-right: none;
        left: 24px;
        top: 24px;
    }

    .hero__frame-tr {
        border-bottom: none;
        border-left: none;
        right: 24px;
        top: 24px;
    }

    .hero__frame-bl {
        border-right: none;
        border-top: none;
        bottom: 24px;
        left: 24px;
    }

    .hero__frame-br {
        border-left: none;
        border-top: none;
        bottom: 24px;
        right: 24px;
    }

    .hero__countdown {
        display: grid;
        gap: 18px;
        grid-template-columns: repeat(4, 1fr);
        position: absolute;
        right: var(--shell-pad);
        text-align: right;
        top: 60px;
    }

    .hero__countdown-num {
        color: var(--color-cream);
        font-family: var(--font-display);
        font-size: clamp(28px, 4vw, 56px);
        line-height: 0.9;
    }

    .hero__countdown-lbl {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.2em;
        margin-top: 4px;
        text-transform: uppercase;
    }

    .hero__content {
        margin: 0 auto;
        max-width: var(--shell-max);
        padding: 0 var(--shell-pad) clamp(40px, 8vh, 90px);
        width: 100%;
    }

    .hero__meta {
        gap: 24px;
        margin-bottom: 24px;
    }

    .hero__meta-item {
        align-items: center;
        color: var(--color-cream-60);
        display: flex;
        font-family: var(--font-mono);
        font-size: 11px;
        gap: 8px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    .hero__meta-item::before {
        background: var(--color-cream-60);
        content: '';
        display: inline-block;
        height: 1px;
        width: 18px;
    }

    .hero__title {
        font-size: clamp(64px, 13vw, 200px);
        font-weight: 400;
        letter-spacing: -0.02em;
        line-height: 0.86;
        margin: 0 0 18px;
        text-transform: uppercase;
    }

    .hero__title-accent {
        color: var(--color-accent);
        font-family: var(--font-serif);
        font-size: 0.85em;
        font-style: italic;
        padding: 0 0.05em;
        vertical-align: 0.05em;
    }

    .hero__sub {
        color: var(--color-cream-60);
        font-family: var(--font-serif);
        font-size: clamp(20px, 2.4vw, 30px);
        font-style: italic;
        line-height: 1.3;
        margin-top: 18px;
        max-width: 540px;
    }

    .hero__actions {
        gap: 14px;
        margin-top: 32px;
    }

    @media (max-width: 1024px) {
        .hero__countdown {
            display: none;
        }
    }
</style>

<script>
    import { getCountdownParts, pad } from '@lib/utils';

    const MS_PER_SECOND = 1_000;

    let heroInterval: ReturnType<typeof setInterval> | undefined;

    function initHeroCountdown(): void {
        if (heroInterval) clearInterval(heroInterval);
        updateHeroCountdown();
        heroInterval = setInterval(updateHeroCountdown, MS_PER_SECOND);
    }

    function updateHeroCountdown(): void {
        const days = document.getElementById('hero-days');
        const hours = document.getElementById('hero-hrs');
        const minutes = document.getElementById('hero-min');
        const seconds = document.getElementById('hero-sec');

        if (!days) {
            if (heroInterval) {
                clearInterval(heroInterval);
                heroInterval = undefined;
            }

            return;
        }

        const { remaining, d, h, m, s } = getCountdownParts();

        if (remaining <= 0) return;

        days.textContent = pad(d);
        if (hours) hours.textContent = pad(h);
        if (minutes) minutes.textContent = pad(m);
        if (seconds) seconds.textContent = pad(s);
    }

    document.addEventListener('astro:page-load', initHeroCountdown);
</script>
