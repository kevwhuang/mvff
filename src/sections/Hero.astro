---
import poster from '@images/poster.webp';
import { LINKS } from '@lib/utils';

const UNITS = [
    { label: 'Days', unit: 'days' },
    { label: 'Hours', unit: 'hours' },
    { label: 'Minutes', unit: 'minutes' },
    { label: 'Seconds', unit: 'seconds' },
];
---

<section
    class="hero overflow-hidden relative"
    aria-labelledby="hero-title"
>
    <div
        class="hero__background absolute"
        aria-hidden="true"
    >
        <video
            autoplay
            loop
            muted
            playsinline
            poster={poster.src}
        >
            <source src="/videos/hero.webm" type="video/webm" />
        </video>
    </div>
    <div class="hero__frame-top-left absolute" aria-hidden="true" />
    <div class="hero__frame-top-right absolute" aria-hidden="true" />
    <div class="hero__frame-bottom-left absolute" aria-hidden="true" />
    <div class="hero__frame-bottom-right absolute" aria-hidden="true" />
    <ul
        class="hero__countdown list-none"
        aria-label="Event countdown"
        role="timer"
    >
        {UNITS.map(({ label, unit }) => (
            <li>
                <div
                    class="hero__countdown-number"
                    data-unit={unit}
                >
                    00
                </div>
                <div class="hero__countdown-label">{label}</div>
            </li>
        ))}
    </ul>
    <div class="hero__content shell relative">
        <div
            class="hero__meta flex flex-wrap items-center"
            data-scroll
        >
            <span class="hero__meta-item">VOL. 01 / EST. 2026</span>
            <span class="hero__meta-item">Cabana Club &middot; Austin TX</span>
            <span class="hero__meta-item"><time datetime="2026-07-18T19:00-05:00">07 &middot; 18 &middot; 2026 &mdash; 19:00 CDT</time></span>
        </div>
        <h1
            id="hero-title"
            class="hero__title"
            data-scroll
            data-scroll-delay="0.1"
        >
            Music<br />Video<br />Film <span class="hero__title-fest">Fest</span>
        </h1>
        <p
            class="hero__subtitle"
            data-scroll
            data-scroll-delay="0.2"
        >
            One night where Austin's music and film worlds collide. Twelve programmed acts, four screening blocks, one pool party.
        </p>
        <div
            class="flex flex-wrap items-center gap-3.5"
            data-scroll
            data-scroll-delay="0.3"
        >
            <a
                class="btn btn--primary"
                href={LINKS.sponsor}
                target="_blank"
            >
                Sponsor Us &rarr;
            </a>
            <a
                class="btn"
                href={LINKS.partner}
                target="_blank"
            >
                Partner Up
            </a>
        </div>
    </div>
</section>

<style>
    .hero {
        align-items: end;
        display: grid;
        isolation: isolate;
        min-height: calc(100vh - 70px);
    }

    .hero__background {
        inset: 0;
        z-index: -1;
    }

    .hero__background::after {
        background:
            linear-gradient(180deg, var(--color-night-40) 0%, transparent 30%, transparent 60%, var(--color-night) 100%),
            radial-gradient(ellipse at 50% 70%, transparent 30%, var(--color-night-70) 100%);
        content: '';
        inset: 0;
        position: absolute;
    }

    .hero__background video {
        filter: brightness(0.55) contrast(1.1) saturate(1.15);
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .hero__content {
        padding-bottom: clamp(40px, 8vh, 90px);
    }

    .hero__countdown {
        display: grid;
        gap: 18px;
        grid-template-columns: repeat(4, 1fr);
        position: absolute;
        right: var(--shell-pad);
        text-align: right;
        top: 60px;
        user-select: none;
    }

    .hero__countdown-label {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    .hero__countdown-number {
        color: var(--color-cream);
        font-family: var(--font-display);
        font-size: clamp(28px, 4.4vw, 56px);
        line-height: 0.9;
        margin-bottom: 4px;
    }

    .hero__frame-bottom-left,
    .hero__frame-bottom-right,
    .hero__frame-top-left,
    .hero__frame-top-right {
        border: 1px solid var(--color-cream);
        height: 28px;
        width: 28px;
    }

    .hero__frame-bottom-left {
        border-right: none;
        border-top: none;
        bottom: 24px;
        left: 24px;
    }

    .hero__frame-bottom-right {
        border-left: none;
        border-top: none;
        bottom: 24px;
        right: 24px;
    }

    .hero__frame-top-left {
        border-bottom: none;
        border-right: none;
        left: 24px;
        top: 24px;
    }

    .hero__frame-top-right {
        border-bottom: none;
        border-left: none;
        right: 24px;
        top: 24px;
    }

    .hero__meta {
        gap: 24px;
        margin-bottom: 24px;
    }

    .hero__meta-item {
        align-items: center;
        color: var(--color-cream-60);
        display: flex;
        font-family: var(--font-mono);
        font-size: 11px;
        gap: 8px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    .hero__meta-item::before {
        background: var(--color-cream-60);
        content: '';
        display: inline-block;
        height: 1px;
        width: 18px;
    }

    .hero__subtitle {
        color: var(--color-cream-60);
        font-family: var(--font-serif);
        font-size: clamp(20px, 2.4vw, 30px);
        font-style: italic;
        line-height: 1.3;
        margin-bottom: 32px;
        max-width: 540px;
    }

    .hero__title {
        font-size: clamp(64px, 15.7vw, 200px);
        font-weight: 400;
        letter-spacing: -0.02em;
        line-height: 0.86;
        margin-bottom: 18px;
        text-transform: uppercase;
    }

    .hero__title-fest {
        color: var(--color-coral);
        font-family: var(--font-serif);
        font-size: 0.85em;
        font-style: italic;
        padding: 0 0.05em;
        vertical-align: 0.05em;
    }

    @media (max-width: 1024px) {
        .hero__countdown {
            display: none;
        }
    }
</style>

<script>
    import { getCountdownParts, pad } from '@lib/utils';

    let heroInterval: Timer | undefined;

    function initHeroCountdown() {
        if (heroInterval) clearInterval(heroInterval);

        if (!document.querySelector('[data-unit="days"]')) return;

        updateHeroCountdown();
        heroInterval = setInterval(updateHeroCountdown, 1_000);
    }

    function updateHeroCountdown() {
        const days = document.querySelector('[data-unit="days"]');
        const hours = document.querySelector('[data-unit="hours"]');
        const minutes = document.querySelector('[data-unit="minutes"]');
        const seconds = document.querySelector('[data-unit="seconds"]');

        if (!days) return;

        const parts = getCountdownParts();

        if (parts.remaining <= 0) return;

        days.textContent = pad(parts.days);
        if (hours) hours.textContent = pad(parts.hours);
        if (minutes) minutes.textContent = pad(parts.minutes);
        if (seconds) seconds.textContent = pad(parts.seconds);
    }

    document.addEventListener('astro:page-load', initHeroCountdown);
</script>
