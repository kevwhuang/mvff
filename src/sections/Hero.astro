---
import { Image } from 'astro:assets';

import logo from '@images/logos/austin_music_video_film_festival.webp';
import poster from '@images/poster.webp';
import { LINKS } from '@lib/constants';
---

<section
    class="hero grid items-center overflow-hidden relative isolate"
    aria-labelledby="hero-title"
>
    <div
        class="hero__background absolute inset-0 -z-1"
        aria-hidden="true"
    >
        <video
            class="hero__video object-cover h-full w-full"
            autoplay
            loop
            muted
            playsinline
            poster={poster.src}
        >
            <source src="/videos/hero.webm" type="video/webm" />
        </video>
        <div class="grain absolute" aria-hidden="true" />
    </div>
    <div class="hero__corner hero__corner--top-left absolute border border-cream" aria-hidden="true" />
    <div class="hero__corner hero__corner--top-right absolute border border-cream" aria-hidden="true" />
    <div class="hero__corner hero__corner--bottom-left absolute border border-cream" aria-hidden="true" />
    <div class="hero__corner hero__corner--bottom-right absolute border border-cream" aria-hidden="true" />
    <dl class="hero__countdown hero__reveal absolute top-15 select-none">
        <dt class="sr-only">Status</dt>
        <dd class="hero__countdown-over font-display whitespace-nowrap text-coral">That's a wrap.</dd>
    </dl>
    <div class="hero__content shell relative">
        <ul class="hero__meta hero__reveal flex flex-wrap items-center gap-6 list-none">
            <li class="hero__meta-item flex items-center gap-2 font-mono uppercase text-cream-60">Vol. 01</li>
            <li class="hero__meta-item flex items-center gap-2 font-mono uppercase text-cream-60"><time datetime="2026-07-18">July 18, 2026</time></li>
            <li class="hero__meta-item flex items-center gap-2 font-mono uppercase text-cream-60">Cabana Club &middot; Austin, TX</li>
        </ul>
        <h1
            id="hero-title"
            class="hero__reveal hero__title"
        >
            <Image
                class="hero__logo block h-auto w-full"
                alt="Austin Music Video Film Festival"
                densities={[1, 2]}
                loading="eager"
                src={logo}
                width={640}
            />
        </h1>
        <p class="hero__reveal hero__subtitle font-serif italic text-cream-80">
            <span class="block">A red-carpet premiere for the music video.</span>
            <span class="block">Bold artists, from screen to stage.</span>
        </p>
        <div class="hero__actions hero__reveal flex flex-wrap items-center gap-4">
            <a
                class="button button--primary"
                href={LINKS.review}
                rel="noopener"
                target="_blank"
            >
                Leave a Review
            </a>
            <a
                class="button"
                aria-disabled="true"
                href={LINKS.partner}
                tabindex="-1"
            >
                Future Partnerships
            </a>
        </div>
    </div>
</section>

<style>
    .hero {
        --hero-corner-inset: clamp(12px, calc(5.33px + 2.08vw), 32px);
        --hero-corner-size: clamp(14px, calc(11.33px + 0.83vw), 22px);
        --hero-stagger: var(--duration-fast);
        min-height: calc(100svh - var(--header-height));
    }

    .hero__background::after {
        background:
            radial-gradient(ellipse 55% 40% at 100% 0%, var(--color-night-70), transparent),
            radial-gradient(ellipse 72% 60% at 84% 76%, var(--color-coral-15), transparent 66%),
            linear-gradient(90deg, var(--color-night-70) 0%, transparent min(65%, calc(50% + 192px))),
            linear-gradient(180deg, var(--color-night-40) 0%, transparent 30%, transparent 60%, var(--color-night) 100%),
            radial-gradient(ellipse at 50% 70%, var(--color-night-40) 38%, var(--color-night-70) 100%);
        content: '';
        inset: 0;
        position: absolute;
    }

    .hero__content {
        padding-block: clamp(20px, 6.25vw, 80px);
    }

    .hero__corner {
        height: var(--hero-corner-size);
        width: var(--hero-corner-size);
    }

    .hero__corner--bottom-left {
        border-right: none;
        border-top: none;
        bottom: var(--hero-corner-inset);
        left: var(--hero-corner-inset);
    }

    .hero__corner--bottom-right {
        border-left: none;
        border-top: none;
        bottom: var(--hero-corner-inset);
        right: var(--hero-corner-inset);
    }

    .hero__corner--top-left {
        border-bottom: none;
        border-right: none;
        left: var(--hero-corner-inset);
        top: var(--hero-corner-inset);
    }

    .hero__corner--top-right {
        border-bottom: none;
        border-left: none;
        right: var(--hero-corner-inset);
        top: var(--hero-corner-inset);
    }

    .hero__countdown {
        left: max(var(--shell-pad), calc((100% - var(--shell-max)) / 2 + var(--shell-pad)));
    }

    .hero__countdown.hero__reveal {
        animation-delay: calc(var(--hero-stagger) * 2);
    }

    .hero__countdown-over {
        font-size: clamp(36px, calc(24px + 3.75vw), 72px);
        line-height: 0.9;
    }

    .hero__logo {
        max-width: clamp(320px, calc(213.33px + 33.33vw), 640px);
    }

    .hero__meta {
        margin-bottom: clamp(20px, calc(16px + 1.25vw), 32px);
    }

    .hero__meta-item {
        font-size: 12px;
        letter-spacing: 0.16em;
    }

    .hero__meta-item::before {
        background: var(--color-cream-60);
        content: '';
        display: inline-block;
        height: 1px;
        width: 18px;
    }

    .hero__reveal {
        animation: hero__fade-up var(--duration-slower) ease-out both;
    }

    .hero__reveal:nth-child(1) {
        animation-delay: var(--hero-stagger);
    }

    .hero__reveal:nth-child(2) {
        animation-delay: calc(var(--hero-stagger) * 2);
    }

    .hero__reveal:nth-child(3) {
        animation-delay: calc(var(--hero-stagger) * 3);
    }

    .hero__reveal:nth-child(4) {
        animation-delay: calc(var(--hero-stagger) * 4);
    }

    .hero__reveal:nth-child(5) {
        animation-delay: calc(var(--hero-stagger) * 5);
    }

    .hero__subtitle {
        font-size: clamp(20px, calc(16px + 1.25vw), 32px);
        line-height: 1.3;
        margin-bottom: clamp(20px, calc(16px + 1.25vw), 32px);
        max-width: var(--measure-prose);
    }

    .hero__title {
        margin-bottom: clamp(20px, calc(16px + 1.25vw), 32px);
    }

    .hero__video {
        filter: brightness(0.62) contrast(1.08) saturate(1.2);
    }

    @media (max-width: 1024px) {
        .hero__actions {
            margin-bottom: clamp(20px, calc(16px + 1.25vw), 32px);
        }

        .hero__countdown {
            display: none;
        }
    }

    @media (max-width: 768px) {
        .hero__meta-item::before {
            display: none;
        }
    }

    @keyframes hero__fade-up {
        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    import { REDUCED_MOTION_QUERY } from '@lib/constants';
    import { initDisabledLinks, registerPageScript } from '@lib/utils';

    function initHero(signal: AbortSignal) {
        initDisabledLinks('.button[aria-disabled="true"]', signal);

        const reducedMotionQuery = window.matchMedia(REDUCED_MOTION_QUERY);

        syncHeroVideo(reducedMotionQuery.matches);
        reducedMotionQuery.addEventListener('change', event => syncHeroVideo(event.matches), { signal });
    }

    function syncHeroVideo(prefersReducedMotion: boolean) {
        const video = document.querySelector<HTMLVideoElement>('.hero__video');

        if (!video) return;

        if (prefersReducedMotion) {
            video.pause();
        } else {
            video.play().catch(() => {});
        }
    }

    registerPageScript(initHero);
</script>
