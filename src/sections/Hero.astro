---
import { Image } from 'astro:assets';

import logo from '@images/logos/austin_music_video_film_festival.webp';
import poster from '@images/poster.webp';
import { LINKS } from '@lib/constants';

const UNITS = [
    { label: 'Days', unit: 'days' },
    { label: 'Hours', unit: 'hours' },
    { label: 'Minutes', unit: 'minutes' },
    { label: 'Seconds', unit: 'seconds' },
] as const;
---

<section
    class="hero grid isolate overflow-hidden relative"
    aria-labelledby="hero-title"
>
    <div
        class="hero__background absolute"
        aria-hidden="true"
    >
        <video
            class="hero__video"
            autoplay
            loop
            muted
            playsinline
            poster={poster.src}
        >
            <source src="/videos/hero.webm" type="video/webm" />
        </video>
        <div class="grain absolute" aria-hidden="true" />
    </div>
    <div class="hero__frame-top-left absolute" aria-hidden="true" />
    <div class="hero__frame-top-right absolute" aria-hidden="true" />
    <div class="hero__frame-bottom-left absolute" aria-hidden="true" />
    <div class="hero__frame-bottom-right absolute" aria-hidden="true" />
    <dl
        class="hero__countdown hero__reveal absolute grid text-right select-none"
        aria-label="Event countdown"
        role="timer"
    >
        {UNITS.map(({ label, unit }) => (
            <div class="flex flex-col-reverse">
                <dt class="hero__countdown-label">{label}</dt>
                <dd
                    class="hero__countdown-number"
                    data-unit={unit}
                >
                    00
                </dd>
            </div>
        ))}
    </dl>
    <div class="hero__content shell relative">
        <div class="hero__meta hero__reveal flex flex-wrap items-center gap-6 mb-8">
            <span class="hero__meta-item flex items-center">Vol. 01</span>
            <span class="hero__meta-item flex items-center"><time datetime="2026-07-18">July 18, 2026</time></span>
            <span class="hero__meta-item flex items-center">Cabana Club &middot; Austin, TX</span>
        </div>
        <h1
            id="hero-title"
            class="hero__title hero__reveal mb-8"
        >
            <Image
                class="hero__logo block h-auto w-full"
                alt="Austin Music Video Film Festival"
                densities={[1, 2]}
                loading="eager"
                src={logo}
                width={620}
            />
        </h1>
        <p class="hero__subtitle hero__reveal">
            A red carpet music video film experience celebrating bold artists &mdash; screens to stage.
        </p>
        <div class="hero__reveal flex flex-wrap items-center gap-4">
            <a
                class="btn btn--primary"
                href={LINKS.posh}
                target="_blank"
            >
                Buy Tickets
            </a>
            <a
                class="btn"
                href={LINKS.sponsor}
                target="_blank"
            >
                Sponsor Us
            </a>
        </div>
    </div>
</section>

<style>
    .hero {
        align-items: center;
        height: calc(100svh - var(--header-height));
    }

    .hero__background {
        inset: 0;
        z-index: -1;
    }

    .hero__background::after {
        background:
            linear-gradient(90deg, var(--color-night-70) 0%, transparent 65%),
            linear-gradient(180deg, var(--color-night-40) 0%, transparent 30%, transparent 60%, var(--color-night) 100%),
            radial-gradient(ellipse at 50% 70%, var(--color-night-40) 30%, var(--color-night-70) 100%);
        content: '';
        inset: 0;
        position: absolute;
    }

    .hero__video {
        filter: brightness(0.55) contrast(1.1) saturate(1.15);
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .hero__content {
        padding-block: clamp(48px, calc(37.33px + 3.33vw), 80px);
    }

    .hero__countdown {
        animation-delay: 0.4s;
        gap: 24px;
        grid-template-columns: repeat(4, 1fr);
        right: var(--shell-pad);
        top: 60px;
    }

    .hero__countdown-label {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    .hero__countdown-number {
        color: var(--color-cream);
        font-family: var(--font-display);
        font-size: clamp(36px, calc(24px + 3.75vw), 72px);
        line-height: 0.9;
        margin-bottom: 8px;
    }

    .hero__frame-bottom-left,
    .hero__frame-bottom-right,
    .hero__frame-top-left,
    .hero__frame-top-right {
        border: 1px solid var(--color-cream);
        height: 28px;
        width: 28px;
    }

    .hero__frame-bottom-left {
        border-right: none;
        border-top: none;
        bottom: 24px;
        left: 24px;
    }

    .hero__frame-bottom-right {
        border-left: none;
        border-top: none;
        bottom: 24px;
        right: 24px;
    }

    .hero__frame-top-left {
        border-bottom: none;
        border-right: none;
        left: 24px;
        top: 24px;
    }

    .hero__frame-top-right {
        border-bottom: none;
        border-left: none;
        right: 24px;
        top: 24px;
    }

    .hero__logo {
        max-width: clamp(280px, calc(166.67px + 35.42vw), 620px);
    }

    .hero__meta-item {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 12px;
        gap: 8px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    .hero__meta-item::before {
        background: var(--color-cream-60);
        content: '';
        display: inline-block;
        height: 1px;
        width: 18px;
    }

    .hero__reveal {
        animation: hero__fade-up var(--duration-slower) ease both;
        opacity: 0;
    }

    .hero__reveal:nth-child(1) {
        animation-delay: 0.2s;
    }

    .hero__reveal:nth-child(2) {
        animation-delay: 0.4s;
    }

    .hero__reveal:nth-child(3) {
        animation-delay: 0.6s;
    }

    .hero__reveal:nth-child(4) {
        animation-delay: 0.8s;
    }

    .hero__subtitle {
        color: var(--color-cream-80);
        font-family: var(--font-serif);
        font-size: clamp(20px, calc(16.67px + 1.04vw), 30px);
        font-style: italic;
        line-height: 1.3;
        margin-bottom: 32px;
        max-width: 540px;
    }

    @media (max-width: 1024px) {
        .hero__countdown {
            display: none;
        }
    }

    @media (max-width: 768px) {
        .hero__meta-item::before {
            display: none;
        }
    }

    @keyframes hero__fade-up {
        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    import { pad, startCountdown } from '@lib/utils';

    const UNITS = ['days', 'hours', 'minutes', 'seconds'] as const;

    let stopHeroCountdown: (() => void) | undefined;

    function initHeroCountdown() {
        stopHeroCountdown?.();

        if (!document.querySelector('[data-unit="days"]')) return;

        stopHeroCountdown = startCountdown(renderHeroCountdown);
    }

    function renderHeroCountdown(parts: CountdownParts) {
        if (parts.remaining <= 0) return;

        UNITS.forEach((unit) => {
            const element = document.querySelector(`[data-unit="${unit}"]`);

            if (element) element.textContent = pad(parts[unit]);
        });
    }

    document.addEventListener('astro:before-swap', () => {
        stopHeroCountdown?.();
    });

    document.addEventListener('astro:page-load', initHeroCountdown);
</script>
