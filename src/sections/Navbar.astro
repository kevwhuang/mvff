---
import logo from '@images/logos/mvff.webp';
---

<nav
    class="nav sticky"
    aria-label="Main"
>
    <div class="nav__inner">
        <a class="nav__brand flex items-center" aria-label="ATX MVFF Home" href="/">
            <div class="nav__brand-mark">
                <img alt="MVFF" src={logo.src} />
            </div>
            <div class="nav__brand-text flex flex-col">
                <span class="nav__brand-t1">ATX MVFF</span>
                <span class="nav__brand-t2">EST. 2026 · AUSTIN TX</span>
            </div>
        </a>
        <div class="nav__links flex items-center justify-center">
            <a class="nav__link" href="/">Home</a>
            <a class="nav__link" href="/team">Team</a>
            <a class="nav__link" href="/shop">Shop</a>
            <a class="nav__link" href="/gallery">Gallery</a>
            <a class="nav__link" href="/info">Info</a>
            <a class="nav__link" href="/contact">Contact</a>
        </div>
        <div class="nav__actions flex items-center">
            <div class="nav__countdown" aria-label="Countdown to event">
                <span class="nav__pulse"></span>
                <span id="nav-countdown-text">T-00d 00:00:00</span>
            </div>
            <a
                class="nav__submit"
                href="https://filmfreeway.com/atxmusicvideofilmfestival"
                rel="noopener noreferrer"
                target="_blank"
            >
                Submit
            </a>
            <button
                class="nav__burger"
                aria-expanded="false"
                aria-label="Open menu"
                type="button"
            >&equiv;
            </button>
        </div>
    </div>
</nav>
<div class="mobile-menu fixed" aria-hidden="true">
    <button
        class="mobile-menu__close"
        aria-label="Close menu"
        type="button"
    >&times;
    </button>
    <a class="mobile-menu__link" href="/">Home</a>
    <a class="mobile-menu__link" href="/team">Team</a>
    <a class="mobile-menu__link" href="/shop">Shop</a>
    <a class="mobile-menu__link" href="/gallery">Gallery</a>
    <a class="mobile-menu__link" href="/info">Info</a>
    <a class="mobile-menu__link" href="/contact">Contact</a>
    <div class="mobile-menu__divider"></div>
    <a class="mobile-menu__link" href="pitch-deck.pdf" rel="noopener noreferrer" target="_blank">Pitch Deck →</a>
    <a class="mobile-menu__link" href="https://calendly.com/madewellanna99/30min" rel="noopener noreferrer" target="_blank">Schedule a Call →</a>
</div>

<style>
    .nav {
        backdrop-filter: blur(14px) saturate(120%);
        background: color-mix(in oklab, var(--color-night) 72%, transparent);
        border-bottom: 1px solid var(--color-cream-15);
        top: 0;
        z-index: 50;
        -webkit-backdrop-filter: blur(14px) saturate(120%);
    }

    .nav__inner {
        align-items: center;
        display: grid;
        gap: clamp(12px, 3vw, 28px);
        grid-template-columns: auto 1fr auto;
        margin: 0 auto;
        max-width: var(--shell-max);
        padding: 14px var(--shell-pad);
    }

    .nav__brand {
        cursor: pointer;
        gap: 14px;
        text-decoration: none;
        user-select: none;
    }

    .nav__brand-mark {
        background: var(--color-navy);
        border: 1px solid var(--color-cream-15);
        display: grid;
        filter: invert(var(--brand-invert, 0));
        height: 38px;
        place-items: center;
        width: 38px;
    }

    .nav__brand-mark img {
        display: block;
        height: auto;
        width: 78%;
    }

    .nav__brand-text {
        line-height: 1;
    }

    .nav__brand-t1 {
        color: var(--color-cream);
        font-family: var(--font-display);
        font-size: 18px;
        letter-spacing: 0.03em;
    }

    .nav__brand-t2 {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 9.5px;
        letter-spacing: 0.22em;
        margin-top: 3px;
        text-transform: uppercase;
    }

    .nav__links {
        gap: 4px;
    }

    .nav__link {
        color: var(--color-cream-60);
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: 11.5px;
        letter-spacing: 0.16em;
        padding: 10px 14px;
        position: relative;
        text-decoration: none;
        text-transform: uppercase;
        transition: color 0.18s ease;
    }

    .nav__link:hover {
        color: var(--color-cream);
    }

    .nav__link[aria-current='page'] {
        color: var(--color-cream);
    }

    .nav__link[aria-current='page']::before {
        background: var(--color-accent);
        bottom: 4px;
        content: '';
        height: 2px;
        left: 14px;
        position: absolute;
        right: 14px;
    }

    .nav__actions {
        gap: 10px;
        margin-left: auto;
    }

    .nav__countdown {
        align-items: baseline;
        background: var(--color-navy);
        border: 1px solid var(--color-cream-15);
        color: var(--color-cream);
        display: flex;
        font-family: var(--font-mono);
        font-size: 11px;
        gap: 6px;
        letter-spacing: 0.1em;
        padding: 6px 10px;
    }

    .nav__pulse {
        animation: pulse 1.6s ease-in-out infinite;
        background: var(--color-accent);
        border-radius: 50%;
        display: inline-block;
        height: 6px;
        margin-right: 6px;
        width: 6px;
    }

    @keyframes pulse {
        0%,
        100% {
            opacity: 0.4;
            transform: scale(0.9);
        }
        50% {
            box-shadow: 0 0 12px var(--color-accent);
            opacity: 1;
            transform: scale(1.2);
        }
    }

    .nav__submit {
        background: var(--color-accent);
        border: 1px solid var(--color-accent);
        color: var(--color-night);
        cursor: pointer;
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.16em;
        padding: 10px 16px;
        text-decoration: none;
        text-transform: uppercase;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .nav__submit:hover {
        background: var(--color-cream);
        border-color: var(--color-cream);
        color: var(--color-night);
    }

    .nav__burger {
        background: var(--color-navy);
        border: 1px solid var(--color-cream-15);
        color: var(--color-cream);
        cursor: pointer;
        display: none;
        height: 36px;
        place-items: center;
        width: 36px;
    }

    .mobile-menu {
        background: var(--color-night);
        display: flex;
        flex-direction: column;
        gap: 8px;
        inset: 0;
        padding: 80px 32px 32px;
        transform: translateX(100%);
        transition: transform 0.3s ease;
        z-index: 60;
    }

    .mobile-menu[data-open] {
        transform: translateX(0);
    }

    .mobile-menu__close {
        background: var(--color-navy);
        border: 1px solid var(--color-cream-15);
        color: var(--color-cream);
        cursor: pointer;
        height: 36px;
        position: absolute;
        right: 18px;
        top: 18px;
        width: 36px;
    }

    .mobile-menu__link {
        border-bottom: 1px solid var(--color-cream-15);
        color: var(--color-cream);
        font-family: var(--font-display);
        font-size: 28px;
        letter-spacing: 0.04em;
        padding: 14px 0;
        text-decoration: none;
        transition: color 0.18s ease;
    }

    .mobile-menu__link:hover {
        color: var(--color-accent);
    }

    .mobile-menu__divider {
        border-top: 1px solid var(--color-cream-15);
        margin: 8px 0;
    }

    @media (max-width: 1024px) {
        .nav__links {
            display: none;
        }

        .nav__countdown {
            display: none;
        }

        .nav__burger {
            display: grid;
        }
    }

    @media (max-width: 720px) {
        .nav__brand-text {
            display: none;
        }
    }
</style>

<script>
    import { getCountdownParts, pad } from '@lib/utils';

    const MS_PER_SECOND = 1_000;

    let navController: AbortController | undefined;
    let navInterval: ReturnType<typeof setInterval> | undefined;

    function initNavbar(): void {
        if (navInterval) clearInterval(navInterval);
        navController?.abort();
        navController = new AbortController();
        const { signal } = navController;

        updateNavCountdown();
        navInterval = setInterval(updateNavCountdown, MS_PER_SECOND);

        const burger = document.querySelector('.nav__burger');
        const mobileMenu = document.querySelector('.mobile-menu') as HTMLElement | null;
        const mobileClose = document.querySelector('.mobile-menu__close');

        if (burger && mobileMenu) {
            function closeMenu(): void {
                mobileMenu!.removeAttribute('data-open');
                mobileMenu!.setAttribute('aria-hidden', 'true');
                burger!.setAttribute('aria-expanded', 'false');
            }

            function openMenu(): void {
                mobileMenu!.setAttribute('data-open', '');
                mobileMenu!.setAttribute('aria-hidden', 'false');
                burger!.setAttribute('aria-expanded', 'true');
            }

            burger.addEventListener('click', () => {
                if (mobileMenu.hasAttribute('data-open')) {
                    closeMenu();
                } else {
                    openMenu();
                }
            }, { signal });

            if (mobileClose) {
                mobileClose.addEventListener('click', closeMenu, { signal });
            }

            document.addEventListener('keydown', (e: KeyboardEvent) => {
                if (e.key === 'Escape' && mobileMenu.hasAttribute('data-open')) {
                    closeMenu();
                }
            }, { signal });
        }

        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';

        document.querySelectorAll('.nav__link').forEach((link) => {
            const href = link.getAttribute('href')?.replace(/\/$/, '') || '/';

            if (href === currentPath) {
                link.setAttribute('aria-current', 'page');
            } else {
                link.removeAttribute('aria-current');
            }
        });
    }

    function updateNavCountdown(): void {
        const el = document.getElementById('nav-countdown-text');

        if (!el) return;

        const { remaining, d, h, m, s } = getCountdownParts();

        if (remaining <= 0) {
            el.textContent = 'HAPPENING NOW';
            return;
        }

        el.textContent = 'T-'
            + pad(d) + 'd '
            + pad(h) + ':'
            + pad(m) + ':'
            + pad(s);
    }

    document.addEventListener('astro:page-load', initNavbar);
</script>
