---
import logo from '@images/logos/mvff.png';
---

<nav class="nav sticky" aria-label="Main">
    <div class="nav__inner">
        <a class="nav__brand flex items-center" aria-label="ATX MVFF Home" href="/">
            <div class="nav__brand-mark">
                <img alt="MVFF" src={logo.src} />
            </div>
            <div class="nav__brand-text flex flex-col">
                <span class="nav__brand-t1">ATX MVFF</span>
                <span class="nav__brand-t2">EST. 2026 · AUSTIN TX</span>
            </div>
        </a>
        <div class="nav__links flex items-center justify-center">
            <a class="nav__link" href="/">Home</a>
            <a class="nav__link" href="/team">Team</a>
            <a class="nav__link" href="/shop">Shop</a>
            <a class="nav__link" href="/gallery">Gallery</a>
            <a class="nav__link" href="/info">Info</a>
            <a class="nav__link" href="/contact">Contact</a>
        </div>
        <div class="nav__actions flex items-center">
            <div class="nav__countdown" aria-label="Countdown to event">
                <span class="nav__pulse"></span>
                <span id="nav-countdown-text">T-00d 00:00:00</span>
            </div>
            <button class="nav__theme" aria-label="Toggle theme" type="button">☾</button>
            <a
                class="nav__submit"
                href="https://filmfreeway.com/atxmusicvideofilmfestival"
                rel="noopener noreferrer"
                target="_blank"
            >
                Submit
            </a>
            <button class="nav__burger" aria-expanded="false" aria-label="Open menu" type="button">≡</button>
        </div>
    </div>
</nav>
<div class="mobile-menu fixed" aria-hidden="true">
    <button class="mobile-menu__close" aria-label="Close menu" type="button">×</button>
    <a class="mobile-menu__link" href="/">Home</a>
    <a class="mobile-menu__link" href="/team">Team</a>
    <a class="mobile-menu__link" href="/shop">Shop</a>
    <a class="mobile-menu__link" href="/gallery">Gallery</a>
    <a class="mobile-menu__link" href="/info">Info</a>
    <a class="mobile-menu__link" href="/contact">Contact</a>
    <div class="mobile-menu__divider"></div>
    <a class="mobile-menu__link" href="pitch-deck.pdf" rel="noopener noreferrer" target="_blank">Pitch Deck →</a>
    <a class="mobile-menu__link" href="https://calendly.com/madewellanna99/30min" rel="noopener noreferrer" target="_blank">Schedule a Call →</a>
</div>

<style>
    .nav {
        backdrop-filter: blur(14px) saturate(120%);
        background: color-mix(in oklab, var(--ink) 72%, transparent);
        border-bottom: 1px solid var(--line);
        top: 0;
        z-index: 50;
        -webkit-backdrop-filter: blur(14px) saturate(120%);
    }

    .nav__inner {
        align-items: center;
        display: grid;
        gap: clamp(12px, 3vw, 28px);
        grid-template-columns: auto 1fr auto;
        margin: 0 auto;
        max-width: var(--shell-max);
        padding: 14px var(--shell-pad);
    }

    .nav__brand {
        cursor: pointer;
        gap: 14px;
        text-decoration: none;
        user-select: none;
    }

    .nav__brand-mark {
        background: var(--ink-2);
        border: 1px solid var(--line);
        display: grid;
        filter: invert(var(--brand-invert, 0));
        height: 38px;
        place-items: center;
        width: 38px;
    }

    [data-theme='light'] .nav__brand-mark {
        --brand-invert: 1;
    }

    .nav__brand-mark img {
        display: block;
        height: auto;
        width: 78%;
    }

    .nav__brand-text {
        line-height: 1;
    }

    .nav__brand-t1 {
        color: var(--paper);
        font-family: var(--ff-display);
        font-size: 18px;
        letter-spacing: 0.03em;
    }

    .nav__brand-t2 {
        color: var(--paper-dim);
        font-family: var(--ff-mono);
        font-size: 9.5px;
        letter-spacing: 0.22em;
        margin-top: 3px;
        text-transform: uppercase;
    }

    .nav__links {
        gap: 4px;
    }

    .nav__link {
        color: var(--paper-dim);
        cursor: pointer;
        font-family: var(--ff-mono);
        font-size: 11.5px;
        letter-spacing: 0.16em;
        padding: 10px 14px;
        position: relative;
        text-decoration: none;
        text-transform: uppercase;
        transition: color 180ms ease;
    }

    .nav__link:hover {
        color: var(--paper);
    }

    .nav__link[aria-current='page'] {
        color: var(--paper);
    }

    .nav__link[aria-current='page']::before {
        background: var(--accent);
        bottom: 4px;
        content: '';
        height: 2px;
        left: 14px;
        position: absolute;
        right: 14px;
    }

    .nav__actions {
        gap: 10px;
        margin-left: auto;
    }

    .nav__countdown {
        align-items: baseline;
        background: var(--ink-2);
        border: 1px solid var(--line);
        color: var(--paper);
        display: flex;
        font-family: var(--ff-mono);
        font-size: 11px;
        gap: 6px;
        letter-spacing: 0.1em;
        padding: 6px 10px;
    }

    .nav__pulse {
        animation: pulse 1.6s ease-in-out infinite;
        background: var(--accent);
        border-radius: 50%;
        display: inline-block;
        height: 6px;
        margin-right: 6px;
        width: 6px;
    }

    @keyframes pulse {
        0%,
        100% {
            opacity: 0.4;
            transform: scale(0.9);
        }
        50% {
            box-shadow: 0 0 12px var(--accent);
            opacity: 1;
            transform: scale(1.2);
        }
    }

    .nav__theme {
        background: var(--ink-2);
        border: 1px solid var(--line);
        color: var(--paper);
        cursor: pointer;
        display: grid;
        height: 36px;
        place-items: center;
        transition: all 200ms ease;
        width: 36px;
    }

    .nav__theme:hover {
        border-color: var(--accent);
        color: var(--accent);
    }

    .nav__submit {
        background: var(--accent);
        border: 1px solid var(--accent);
        color: var(--ink);
        cursor: pointer;
        display: inline-block;
        font-family: var(--ff-mono);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.16em;
        padding: 10px 16px;
        text-decoration: none;
        text-transform: uppercase;
        transition: all 200ms ease;
    }

    .nav__submit:hover {
        background: var(--paper);
        border-color: var(--paper);
        color: var(--ink);
    }

    .nav__burger {
        background: var(--ink-2);
        border: 1px solid var(--line);
        color: var(--paper);
        cursor: pointer;
        display: none;
        height: 36px;
        place-items: center;
        width: 36px;
    }

    .mobile-menu {
        background: var(--ink);
        display: flex;
        flex-direction: column;
        gap: 8px;
        inset: 0;
        padding: 80px 32px 32px;
        transform: translateX(100%);
        transition: transform 300ms ease;
        z-index: 60;
    }

    .mobile-menu[data-open] {
        transform: translateX(0);
    }

    .mobile-menu__close {
        background: var(--ink-2);
        border: 1px solid var(--line);
        color: var(--paper);
        cursor: pointer;
        height: 36px;
        position: absolute;
        right: 18px;
        top: 18px;
        width: 36px;
    }

    .mobile-menu__link {
        border-bottom: 1px solid var(--line);
        color: var(--paper);
        font-family: var(--ff-display);
        font-size: 28px;
        letter-spacing: 0.04em;
        padding: 14px 0;
        text-decoration: none;
        transition: color 180ms ease;
    }

    .mobile-menu__link:hover {
        color: var(--accent);
    }

    .mobile-menu__divider {
        border-top: 1px solid var(--line);
        margin: 8px 0;
    }

    @media (max-width: 1024px) {
        .nav__links {
            display: none;
        }

        .nav__countdown {
            display: none;
        }

        .nav__burger {
            display: grid;
        }
    }

    @media (max-width: 720px) {
        .nav__brand-text {
            display: none;
        }
    }
</style>

<script>
    const MS_PER_DAY = 86400000;
    const MS_PER_HOUR = 3600000;
    const MS_PER_MINUTE = 60000;
    const MS_PER_SECOND = 1000;
    const PAD_LENGTH = 2;
    const EVENT_DATE = new Date('2026-07-18T19:00:00-05:00').getTime();

    let navInterval: ReturnType<typeof setInterval> | undefined;
    let themeHandler: (() => void) | undefined;
    let burgerHandler: (() => void) | undefined;
    let closeHandler: (() => void) | undefined;
    let escapeHandler: ((e: KeyboardEvent) => void) | undefined;

    function updateNavCountdown(): void {
        const el = document.getElementById('nav-countdown-text');

        if (!el) return;

        const remaining = EVENT_DATE - Date.now();

        if (remaining <= 0) {
            el.textContent = 'HAPPENING NOW';
            return;
        }

        const d = Math.floor(remaining / MS_PER_DAY);
        const h = Math.floor((remaining % MS_PER_DAY) / MS_PER_HOUR);
        const m = Math.floor((remaining % MS_PER_HOUR) / MS_PER_MINUTE);
        const s = Math.floor((remaining % MS_PER_MINUTE) / MS_PER_SECOND);

        el.textContent = 'T-'
            + String(d).padStart(PAD_LENGTH, '0') + 'd '
            + String(h).padStart(PAD_LENGTH, '0') + ':'
            + String(m).padStart(PAD_LENGTH, '0') + ':'
            + String(s).padStart(PAD_LENGTH, '0');
    }

    function getStoredTheme(): string {
        try {
            return localStorage.getItem('mvff-theme') || 'dark';
        } catch {
            return 'dark';
        }
    }

    function applyTheme(theme: string): void {
        document.documentElement.setAttribute('data-theme', theme);

        const btn = document.querySelector('.nav__theme');

        if (btn) btn.textContent = theme === 'dark' ? '☾' : '☀';

        try {
            localStorage.setItem('mvff-theme', theme);
        } catch {
            /* noop */
        }
    }

    function initNavbar(): void {
        if (navInterval) clearInterval(navInterval);
        updateNavCountdown();
        navInterval = setInterval(updateNavCountdown, MS_PER_SECOND);

        const theme = getStoredTheme();
        const themeBtn = document.querySelector('.nav__theme');

        if (themeBtn) themeBtn.textContent = theme === 'dark' ? '☾' : '☀';
        const burger = document.querySelector('.nav__burger');
        const mobileMenu = document.querySelector('.mobile-menu') as HTMLElement | null;
        const mobileClose = document.querySelector('.mobile-menu__close');

        if (themeBtn) {
            if (themeHandler) themeBtn.removeEventListener('click', themeHandler);
            themeHandler = () => {
                const current = document.documentElement.getAttribute('data-theme') || 'dark';
                applyTheme(current === 'dark' ? 'light' : 'dark');
            };
            themeBtn.addEventListener('click', themeHandler);
        }

        if (burger && mobileMenu) {
            function openMenu(): void {
                mobileMenu!.setAttribute('data-open', '');
                mobileMenu!.setAttribute('aria-hidden', 'false');
                burger!.setAttribute('aria-expanded', 'true');
            }

            function closeMenu(): void {
                mobileMenu!.removeAttribute('data-open');
                mobileMenu!.setAttribute('aria-hidden', 'true');
                burger!.setAttribute('aria-expanded', 'false');
            }

            if (burgerHandler) burger.removeEventListener('click', burgerHandler);
            burgerHandler = () => {
                if (mobileMenu.hasAttribute('data-open')) {
                    closeMenu();
                } else {
                    openMenu();
                }
            };
            burger.addEventListener('click', burgerHandler);

            if (mobileClose) {
                if (closeHandler) mobileClose.removeEventListener('click', closeHandler);
                closeHandler = closeMenu;
                mobileClose.addEventListener('click', closeHandler);
            }

            if (escapeHandler) document.removeEventListener('keydown', escapeHandler);
            escapeHandler = (e: KeyboardEvent) => {
                if (e.key === 'Escape' && mobileMenu.hasAttribute('data-open')) {
                    closeMenu();
                }
            };
            document.addEventListener('keydown', escapeHandler);
        }

        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';

        document.querySelectorAll('.nav__link').forEach((link) => {
            const href = link.getAttribute('href')?.replace(/\/$/, '') || '/';

            if (href === currentPath) {
                link.setAttribute('aria-current', 'page');
            } else {
                link.removeAttribute('aria-current');
            }
        });
    }

    document.addEventListener('astro:page-load', initNavbar);
</script>
