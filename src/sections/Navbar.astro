---
import { Image } from 'astro:assets';

import IconMenu from '@components/IconMenu.astro';
import logo from '@images/logos/austin_music_video_film_festival.webp';
import { ROUTES } from '@lib/constants';
import { getExternalLinkProps } from '@lib/utils';

const CLASS_COUNTDOWN = 'navbar__countdown flex items-center gap-2 px-4 py-3 border border-cream-15 font-mono tracking-widest bg-navy text-cream select-none';
const CLASS_MENU_CLOSE = 'navbar__icon-button navbar__menu-close hidden place-items-center size-12 border border-cream-15 font-mono leading-none text-2xl bg-navy text-cream select-none';
---

<header
    class="navbar sticky top-0 z-50 border-b border-cream-15"
    transition:persist="navbar"
>
    <div class="navbar__inner shell grid items-center h-full">
        <a
            class="navbar__brand relative no-underline select-none"
            aria-label="Austin Music Video Film Festival Home"
            href="/"
        >
            <Image
                class="navbar__logo block h-auto"
                alt=""
                densities={[1, 2]}
                loading="eager"
                src={logo}
                width={80}
            />
        </a>
        <nav
            class="navbar__menu"
            aria-label="Primary"
        >
            <button
                class={CLASS_MENU_CLOSE}
                aria-label="Close navigation"
                type="button"
            >
                &times;
            </button>
            <ul class="navbar__menu-list flex items-center justify-center gap-1 list-none">
                {ROUTES.map(route => (
                    <li>
                        <a
                            class="navbar__menu-link block relative px-2 py-3 font-mono no-underline uppercase text-cream-60 select-none"
                            aria-disabled={route.isDisabled ? 'true' : undefined}
                            href={route.href}
                            tabindex={route.isDisabled ? '-1' : undefined}
                            {...(route.isDisabled ? {} : getExternalLinkProps(route.href))}
                        >
                            {route.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
        <div class="flex items-center justify-self-end gap-3">
            <div
                class={CLASS_COUNTDOWN}
                aria-hidden="true"
            >
                <span class="navbar__pulse inline-block size-1.5 rounded-full bg-coral" />
                <span>00:00:00:00</span>
            </div>
            <button
                class="navbar__icon-button navbar__toggle hidden place-items-center size-12 border border-cream-15 bg-navy text-cream select-none"
                aria-expanded="false"
                aria-label="Open navigation"
                type="button"
            >
                <IconMenu />
            </button>
        </div>
    </div>
</header>

<style>
    .navbar {
        height: var(--header-height);
    }

    .navbar::before {
        backdrop-filter: blur(14px) saturate(120%);
        background: var(--color-night-90);
        content: '';
        inset: 0;
        position: absolute;
        z-index: -1;
    }

    .navbar__brand {
        transition: opacity var(--duration-fast) ease;
    }

    .navbar__brand:active {
        opacity: 0.8;
    }

    .navbar__brand:hover {
        opacity: 0.8;
    }

    .navbar__brand::after {
        content: '';
        inset: -8px;
        position: absolute;
    }

    .navbar__countdown {
        font-size: 14px;
    }

    .navbar__icon-button {
        transition:
            border-color var(--duration-fast) ease,
            color var(--duration-fast) ease;
    }

    .navbar__icon-button:active {
        border-color: var(--color-coral);
        color: var(--color-coral);
    }

    .navbar__icon-button:focus-visible {
        border-color: var(--color-coral);
        color: var(--color-coral);
    }

    .navbar__icon-button:hover,
    .navbar__icon-button[data-hover] {
        border-color: var(--color-coral);
        color: var(--color-coral);
    }

    .navbar__inner {
        gap: clamp(12px, calc(5.33px + 2.08vw), 32px);
        grid-template-columns: auto 1fr auto;
    }

    .navbar__menu-link {
        font-size: 12px;
        letter-spacing: 0.16em;
        transition: color var(--duration-fast) ease;
    }

    .navbar__menu-link:active,
    .navbar__menu-link[aria-current='page']:active {
        color: var(--color-coral);
    }

    .navbar__menu-link:hover {
        color: var(--color-coral);
    }

    .navbar__menu-link::after {
        content: '';
        inset: -4px 0;
        position: absolute;
    }

    .navbar__menu-link::before {
        background: var(--color-coral);
        bottom: 4px;
        content: '';
        height: 2px;
        left: 8px;
        opacity: 0;
        position: absolute;
        right: 8px;
        transition: opacity var(--duration-fast) ease;
    }

    .navbar__menu-link[aria-current='page'] {
        color: var(--color-cream);
    }

    .navbar__menu-link[aria-current='page']:hover {
        color: var(--color-coral);
    }

    .navbar__menu-link[aria-current='page']::before {
        opacity: 1;
    }

    .navbar__menu-link[aria-disabled='true'] {
        color: var(--color-cream-60);
        cursor: not-allowed;
        opacity: 0.4;
    }

    .navbar__menu-link[aria-disabled='true']:active {
        color: var(--color-cream-60);
        transform: none;
    }

    .navbar__menu-link[aria-disabled='true']:hover {
        color: var(--color-cream-60);
        transform: none;
    }

    .navbar__pulse {
        animation: navbar__pulse var(--duration-pulse) ease-in-out infinite;
    }

    @media (max-width: 1024px) {
        .navbar__inner {
            grid-template-columns: auto 1fr;
        }

        .navbar__menu {
            background: var(--color-night);
            display: flex;
            flex-direction: column;
            inset: 0;
            padding: 96px 32px 32px;
            position: fixed;
            transform: translateX(100%);
            transition:
                transform var(--duration-base) ease,
                visibility 0s var(--duration-base);
            visibility: hidden;
            z-index: 1;
        }

        .navbar__menu[data-open] {
            transform: translateX(0);
            transition: transform var(--duration-base) ease;
            visibility: visible;
        }

        .navbar__menu[data-resizing] {
            transition: none;
        }

        .navbar__menu-close {
            display: grid;
            position: absolute;
            right: var(--shell-pad);
            top: calc((var(--header-height) - 1px - 48px) / 2);
        }

        .navbar__menu-link {
            border-bottom: 1px solid var(--color-cream-15);
            color: var(--color-cream);
            font-family: var(--font-display);
            font-size: 28px;
            letter-spacing: 0.04em;
            padding: 16px 0;
            text-transform: none;
            transition:
                color var(--duration-fast) ease,
                transform var(--duration-fast) ease;
        }

        .navbar__menu-link:active {
            transform: translateX(8px);
        }

        .navbar__menu-link:hover {
            transform: translateX(8px);
        }

        .navbar__menu-link::after {
            content: none;
        }

        .navbar__menu-link::before {
            content: none;
        }

        .navbar__menu-link[aria-current='page'] {
            color: var(--color-coral);
        }

        .navbar__menu-list {
            align-items: stretch;
            flex: 1 1 auto;
            flex-direction: column;
            gap: 8px;
            justify-content: flex-start;
            margin: -4px;
            min-height: 0;
            overflow-y: auto;
            overscroll-behavior: contain;
            padding: 4px;
        }

        .navbar__menu-list li:last-child .navbar__menu-link {
            border-bottom: none;
        }

        .navbar__toggle {
            display: grid;
        }
    }

    @media (max-width: 768px) {
        .navbar__countdown {
            display: none;
        }
    }

    @keyframes navbar__pulse {
        0%,
        100% {
            opacity: 0.4;
            transform: scale(0.9);
        }

        50% {
            opacity: 1;
            transform: scale(1.2);
        }
    }
</style>

<script>
    import { RESIZE_SETTLE_DELAY } from '@lib/constants';
    import { initDisabledLinks, registerPageScript } from '@lib/utils';

    const HOVER_QUERY = '(hover: hover)';
    const MOBILE_QUERY = '(max-width: 1024px)';
    const POINTER_UNSET = -1;

    let pointerX = POINTER_UNSET;
    let pointerY = POINTER_UNSET;
    let resizeSettleTimer: ReturnType<typeof setTimeout> | undefined;

    function closeMenu(menu: HTMLElement, toggle: HTMLElement, focusVisible: boolean) {
        document.documentElement.style.overflow = '';
        resetMenu(menu, toggle);
        focusElement(toggle, focusVisible);
        syncSwapHover(toggle);
    }

    function focusElement(element: HTMLElement, focusVisible: boolean) {
        if (focusVisible) element.focus();
        else element.focus({ focusVisible: false });
    }

    function handleAbort(menu: HTMLElement, toggle: HTMLElement) {
        document.documentElement.style.overflow = '';
        resetMenu(menu, toggle);
    }

    function handleMenuKeydown(event: KeyboardEvent, menu: HTMLElement, toggle: HTMLElement) {
        if (!menu.hasAttribute('data-open')) return;

        if (event.key === 'Escape') closeMenu(menu, toggle, true);
        else if (event.key === 'Tab') trapFocus(event, menu);
    }

    function handleMenuTransitionEnd(event: TransitionEvent, menu: HTMLElement, closeButton: HTMLElement, toggle: HTMLElement) {
        if (event.propertyName !== 'transform' || event.target !== menu) return;

        syncSwapHover(menu.hasAttribute('data-open') ? closeButton : toggle);
    }

    function handleMobileChange(event: MediaQueryListEvent, menu: HTMLElement, toggle: HTMLElement) {
        menu.setAttribute('data-resizing', '');
        clearTimeout(resizeSettleTimer);
        resizeSettleTimer = setTimeout(() => menu.removeAttribute('data-resizing'), RESIZE_SETTLE_DELAY);

        if (event.matches || !menu.hasAttribute('data-open')) return;

        closeMenu(menu, toggle, true);

        const brandLink = document.querySelector<HTMLElement>('.navbar__brand');
        const currentLink = menu.querySelector<HTMLElement>('.navbar__menu-link[aria-current="page"]');

        (currentLink ?? brandLink)?.focus();
    }

    function handlePointerMove(event: PointerEvent) {
        pointerX = event.clientX;
        pointerY = event.clientY;
    }

    function initNavbar(signal: AbortSignal) {
        const menu = document.querySelector<HTMLElement>('.navbar__menu');
        const toggle = document.querySelector<HTMLElement>('.navbar__toggle');

        if (!menu || !toggle) return;

        initDisabledLinks('.navbar__menu-link[aria-disabled="true"]', signal);

        const currentPath = normalizePath(window.location.pathname);

        document.querySelectorAll('.navbar__menu-link').forEach((link) => {
            const href = link.getAttribute('href');

            if (href && normalizePath(href) === currentPath) link.setAttribute('aria-current', 'page');
            else link.removeAttribute('aria-current');
        });

        const closeButton = menu.querySelector<HTMLElement>('.navbar__menu-close');

        if (!closeButton) return;

        const mobileQuery = window.matchMedia(MOBILE_QUERY);

        closeButton.addEventListener('click', event => closeMenu(menu, toggle, event.detail === 0), { signal });
        document.addEventListener('keydown', event => handleMenuKeydown(event, menu, toggle), { signal });
        menu.addEventListener('transitionend', event => handleMenuTransitionEnd(event, menu, closeButton, toggle), { signal });
        mobileQuery.addEventListener('change', event => handleMobileChange(event, menu, toggle), { signal });
        signal.addEventListener('abort', () => handleAbort(menu, toggle));

        toggle.addEventListener('click', (event) => {
            if (menu.hasAttribute('data-open')) closeMenu(menu, toggle, event.detail === 0);
            else openMenu(menu, toggle, closeButton, event.detail === 0);
        }, { signal });
    }

    function normalizePath(pathname: string) {
        return pathname.replace(/\/$/, '') || '/';
    }

    function openMenu(menu: HTMLElement, toggle: HTMLElement, closeButton: HTMLElement, focusVisible: boolean) {
        document.documentElement.style.overflow = 'hidden';
        menu.setAttribute('aria-modal', 'true');
        menu.setAttribute('data-open', '');
        menu.setAttribute('role', 'dialog');
        toggle.setAttribute('aria-expanded', 'true');
        focusElement(closeButton, focusVisible);
        syncSwapHover(closeButton);
    }

    function resetMenu(menu: HTMLElement, toggle: HTMLElement) {
        menu.querySelector('.navbar__menu-close')?.removeAttribute('data-hover');
        menu.removeAttribute('aria-modal');
        menu.removeAttribute('data-open');
        menu.removeAttribute('role');
        toggle.removeAttribute('data-hover');
        toggle.setAttribute('aria-expanded', 'false');
    }

    function syncSwapHover(button: HTMLElement) {
        if (button.hasAttribute('data-hover') || pointerX < 0 || pointerY < 0 || !window.matchMedia(HOVER_QUERY).matches) return;
        if (!button.contains(document.elementFromPoint(pointerX, pointerY))) return;

        button.setAttribute('data-hover', '');
        document.addEventListener('pointermove', () => button.removeAttribute('data-hover'), { once: true });
    }

    function trapFocus(event: KeyboardEvent, menu: HTMLElement) {
        const focusables = menu.querySelectorAll<HTMLElement>('a:not([tabindex="-1"]), button');

        const first = focusables[0];
        const isInCycle = Array.from(focusables).some(element => element === document.activeElement);
        const last = focusables[focusables.length - 1];

        if (!isInCycle) {
            event.preventDefault();
            (event.shiftKey ? last : first).focus();

            return;
        }

        if (document.activeElement === first && event.shiftKey) {
            event.preventDefault();
            last.focus();
        } else if (document.activeElement === last && !event.shiftKey) {
            event.preventDefault();
            first.focus();
        }
    }

    document.addEventListener('pointermove', handlePointerMove, { passive: true });
    registerPageScript(initNavbar);
</script>
