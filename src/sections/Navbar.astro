---
import { Image } from 'astro:assets';

import IconMenu from '@components/IconMenu.astro';
import logo from '@images/logos/austin_music_video_film_festival.webp';
import { ROUTES } from '@lib/constants';
import { externalLinkProps, normalizePath } from '@lib/utils';

const isHome = normalizePath(Astro.url.pathname) === '/';
---

<header
    class="navbar sticky top-0 z-50 border-b border-cream-15"
    transition:persist="navbar"
>
    <div class="navbar__inner shell grid items-center h-full">
        <a
            class="navbar__brand active:opacity-80 hover:opacity-80 relative no-underline select-none"
            aria-label="Austin Music Video Film Festival Home"
            href="/"
        >
            <Image
                class="navbar__logo block h-auto"
                alt=""
                densities={[1, 2]}
                loading="eager"
                src={logo}
                width={80}
            />
        </a>
        <nav
            class="navbar__menu"
            aria-label="Primary"
        >
            <button
                class="navbar__icon-button navbar__menu-close hidden size-9 border border-cream-15 font-mono leading-none text-xl bg-navy text-cream select-none"
                aria-label="Close navigation"
                type="button"
            >
                &times;
            </button>
            <ul class="navbar__menu-list flex items-center justify-center gap-1 list-none">
                {ROUTES.map((route) => {
                    const isDisabled = route.label === 'Store';

                    return (
                        <li>
                            <a
                                class="navbar__menu-link relative px-2 py-3 font-mono no-underline uppercase text-cream-60 select-none"
                                aria-disabled={isDisabled ? 'true' : undefined}
                                href={route.href}
                                tabindex={isDisabled ? -1 : undefined}
                                {...(isDisabled ? {} : externalLinkProps(route.href))}
                            >
                                {route.label}
                            </a>
                        </li>
                    );
                })}
            </ul>
        </nav>
        <div class="flex items-center justify-self-end gap-3">
            <div
                class="navbar__countdown flex items-center gap-2 px-4 py-3 border border-cream-15 font-mono tracking-widest bg-navy text-cream select-none"
                aria-hidden="true"
                data-visible={isHome ? 'false' : 'true'}
            >
                <span class="navbar__pulse inline-block size-1.5 rounded-full bg-red" />
                <span>00:00:00:00</span>
            </div>
            <button
                class="navbar__icon-button navbar__toggle hidden place-items-center relative size-9 border border-cream-15 bg-navy text-cream select-none"
                aria-expanded="false"
                aria-label="Open navigation"
                type="button"
            >
                <IconMenu />
            </button>
        </div>
    </div>
</header>

<style>
    .navbar {
        height: var(--header-height);
    }

    .navbar::before {
        backdrop-filter: blur(14px) saturate(120%);
        background: var(--color-night-90);
        content: '';
        inset: 0;
        position: absolute;
        z-index: -1;
    }

    .navbar__brand {
        transition: opacity var(--duration-fast) ease;
    }

    .navbar__brand::after {
        content: '';
        inset: -8px;
        position: absolute;
    }

    .navbar__countdown {
        font-size: 14px;
    }

    .navbar__countdown[data-observing] {
        transition: opacity var(--duration-base) ease;
    }

    .navbar__countdown[data-visible='false'] {
        opacity: 0;
        pointer-events: none;
    }

    .navbar__icon-button {
        transition:
            border-color var(--duration-fast) ease,
            color var(--duration-fast) ease;
    }

    .navbar__icon-button:active {
        border-color: var(--color-coral);
        color: var(--color-coral);
    }

    .navbar__icon-button::after {
        content: '';
        inset: -8px;
        position: absolute;
    }

    .navbar__inner {
        gap: clamp(12px, calc(5.33px + 2.08vw), 32px);
        grid-template-columns: auto 1fr auto;
    }

    .navbar__menu-link {
        font-size: 12px;
        letter-spacing: 0.16em;
        transition: color var(--duration-fast) ease;
    }

    .navbar__menu-link:active,
    .navbar__menu-link[aria-current='page']:active {
        color: var(--color-coral);
    }

    .navbar__menu-link::after {
        content: '';
        inset: -4px 0;
        position: absolute;
    }

    .navbar__menu-link::before {
        background: var(--color-coral);
        bottom: 4px;
        content: '';
        height: 2px;
        left: 8px;
        opacity: 0;
        position: absolute;
        right: 8px;
        transition: opacity var(--duration-fast) ease;
    }

    .navbar__menu-link[aria-current='page'] {
        color: var(--color-cream);
    }

    .navbar__menu-link[aria-current='page']::before {
        opacity: 1;
    }

    .navbar__menu-link[aria-disabled='true'] {
        color: var(--color-cream-60);
        cursor: not-allowed;
        opacity: 0.4;
    }

    .navbar__menu-link[aria-disabled='true']:active {
        color: var(--color-cream-60);
        transform: none;
    }

    .navbar__pulse {
        animation: navbar__pulse var(--duration-pulse) ease-in-out infinite;
    }

    @media (hover: hover) {
        .navbar__icon-button:hover {
            border-color: var(--color-coral);
            color: var(--color-coral);
        }

        .navbar__menu-link:hover {
            color: var(--color-coral);
        }

        .navbar__menu-link[aria-current='page']:hover {
            color: var(--color-coral);
        }

        .navbar__menu-link[aria-disabled='true']:hover {
            color: var(--color-cream-60);
            transform: none;
        }
    }

    @media (hover: hover) and (max-width: 1024px) {
        .navbar__menu-link:hover {
            transform: translateX(8px);
        }
    }

    @media (max-width: 1024px) {
        .navbar__countdown {
            display: none;
        }

        .navbar__inner {
            grid-template-columns: auto 1fr;
        }

        .navbar__menu {
            background: var(--color-night);
            display: flex;
            flex-direction: column;
            inset: 0;
            padding: 96px 32px 32px;
            position: fixed;
            transform: translateX(100%);
            transition:
                transform var(--duration-base) ease,
                visibility 0s var(--duration-base);
            visibility: hidden;
            z-index: 60;
        }

        .navbar__menu[data-open] {
            transform: translateX(0);
            transition:
                transform var(--duration-base) ease,
                visibility 0s;
            visibility: visible;
        }

        .navbar__menu[data-resizing] {
            transition: none;
        }

        .navbar__menu-close {
            display: block;
            position: absolute;
            right: 16px;
            top: 16px;
        }

        .navbar__menu-link {
            border-bottom: 1px solid var(--color-cream-15);
            color: var(--color-cream);
            display: block;
            font-family: var(--font-display);
            font-size: 28px;
            letter-spacing: 0.04em;
            padding: 16px 0;
            text-transform: none;
            transition:
                color var(--duration-fast) ease,
                transform var(--duration-fast) ease;
        }

        .navbar__menu-link:active {
            transform: translateX(8px);
        }

        .navbar__menu-link::after {
            content: none;
        }

        .navbar__menu-link::before {
            content: none;
        }

        .navbar__menu-link[aria-current='page'] {
            color: var(--color-coral);
        }

        .navbar__menu-list {
            align-items: stretch;
            flex: 1 1 auto;
            flex-direction: column;
            gap: 8px;
            justify-content: flex-start;
            min-height: 0;
            overflow-y: auto;
            overscroll-behavior: contain;
        }

        .navbar__toggle {
            display: grid;
        }
    }

    @keyframes navbar__pulse {
        0%,
        100% {
            opacity: 0.4;
            transform: scale(0.9);
        }

        50% {
            opacity: 1;
            transform: scale(1.2);
        }
    }
</style>

<script>
    import { initDisabledLinks, normalizePath, registerPageScript } from '@lib/utils';

    const RESIZE_SETTLE = 150;

    let resizeSettleTimer: ReturnType<typeof setTimeout> | undefined;

    function closeMenu(menu: HTMLElement, toggle: HTMLElement) {
        document.documentElement.style.overflow = '';
        resetMenu(menu, toggle);
        toggle.focus();
    }

    function handleMenuKeydown(event: KeyboardEvent, menu: HTMLElement, toggle: HTMLElement) {
        if (!menu.hasAttribute('data-open')) return;

        if (event.key === 'Escape') {
            closeMenu(menu, toggle);
        } else if (event.key === 'Tab') {
            trapFocus(event, menu);
        }
    }

    function handleResize(menu: HTMLElement) {
        menu.setAttribute('data-resizing', '');
        clearTimeout(resizeSettleTimer);
        resizeSettleTimer = setTimeout(() => menu.removeAttribute('data-resizing'), RESIZE_SETTLE);
    }

    function handleTeardown() {
        document.documentElement.style.overflow = '';
    }

    function handleToggleClick(menu: HTMLElement, toggle: HTMLElement) {
        if (menu.hasAttribute('data-open')) {
            closeMenu(menu, toggle);
        } else {
            openMenu(menu, toggle);
        }
    }

    function initNavbar(signal: AbortSignal) {
        const menu = document.querySelector<HTMLElement>('.navbar__menu')!;
        const toggle = document.querySelector<HTMLElement>('.navbar__toggle')!;

        signal.addEventListener('abort', handleTeardown);

        const closeButton = menu.querySelector<HTMLElement>('.navbar__menu-close')!;
        const desktopQuery = window.matchMedia('(min-width: 1025px)');

        closeButton.addEventListener('click', () => closeMenu(menu, toggle), { signal });

        desktopQuery.addEventListener('change', (event) => {
            if (event.matches && menu.hasAttribute('data-open')) closeMenu(menu, toggle);
        }, { signal });

        document.addEventListener('keydown', event => handleMenuKeydown(event, menu, toggle), { signal });

        signal.addEventListener('abort', () => {
            if (menu.hasAttribute('data-open')) closeMenu(menu, toggle);
            else resetMenu(menu, toggle);
        }, { once: true });

        toggle.addEventListener('click', () => handleToggleClick(menu, toggle), { signal });

        window.addEventListener('resize', () => handleResize(menu), { signal });

        const countdownChip = document.querySelector<HTMLElement>('.navbar__countdown')!;
        const heroCountdown = document.querySelector('.hero__countdown');

        if (heroCountdown) {
            const heroRect = heroCountdown.getBoundingClientRect();

            countdownChip.dataset.visible = heroRect.bottom > 0 && heroRect.top < window.innerHeight ? 'false' : 'true';

            const observer = new IntersectionObserver(([entry]) => {
                countdownChip.dataset.visible = entry.isIntersecting ? 'false' : 'true';
            });

            observer.observe(heroCountdown);
            signal.addEventListener('abort', () => observer.disconnect(), { once: true });
            requestAnimationFrame(() => countdownChip.setAttribute('data-observing', ''));
        } else {
            countdownChip.dataset.visible = 'true';
        }

        initDisabledLinks('.navbar__menu-link[aria-disabled="true"]', signal);

        const currentPath = normalizePath(window.location.pathname);

        document.querySelectorAll('.navbar__menu-link').forEach((link) => {
            const href = normalizePath(link.getAttribute('href')!);

            if (href === currentPath) {
                link.setAttribute('aria-current', 'page');
            } else {
                link.removeAttribute('aria-current');
            }
        });
    }

    function openMenu(menu: HTMLElement, toggle: HTMLElement) {
        document.documentElement.style.overflow = 'hidden';
        menu.setAttribute('aria-modal', 'true');
        menu.setAttribute('data-open', '');
        menu.setAttribute('role', 'dialog');
        toggle.setAttribute('aria-expanded', 'true');

        requestAnimationFrame(() => {
            requestAnimationFrame(() => menu.querySelector<HTMLElement>('.navbar__menu-close')!.focus());
        });
    }

    function resetMenu(menu: HTMLElement, toggle: HTMLElement) {
        menu.removeAttribute('aria-modal');
        menu.removeAttribute('data-open');
        menu.removeAttribute('role');
        toggle.setAttribute('aria-expanded', 'false');
    }

    function trapFocus(event: KeyboardEvent, menu: HTMLElement) {
        const focusables = menu.querySelectorAll<HTMLElement>('a:not([tabindex="-1"]), button');

        const first = focusables[0];
        const last = focusables[focusables.length - 1];

        if (document.activeElement === first && event.shiftKey) {
            event.preventDefault();
            last.focus();
        } else if (document.activeElement === last && !event.shiftKey) {
            event.preventDefault();
            first.focus();
        }
    }

    registerPageScript(initNavbar);
</script>
