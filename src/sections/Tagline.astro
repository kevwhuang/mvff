---

---

<section
    class="tagline relative text-center"
    aria-labelledby="tagline-title"
>
    <h2
        id="tagline-title"
        class="tagline__main select-none"
        data-typewriter
    >
        <span class="tagline__screens" data-typewriter-word>Screens</span>
        <span class="tagline__arrow">&rarr;</span>
        <span class="tagline__stage" data-typewriter-word>Stage</span>
    </h2>
</section>

<style>
    .tagline {
        padding: clamp(80px, 14vw, 180px) var(--shell-pad);
    }

    .tagline__arrow {
        color: var(--color-cream-60);
        font-family: var(--font-serif);
        font-size: 0.7em;
        font-style: italic;
        opacity: 0;
        padding: 0 0.15em;
        transition: opacity var(--duration-slow) ease;
    }

    .tagline__main {
        font-size: clamp(56px, 14.1vw, 180px);
        letter-spacing: -0.01em;
        line-height: 0.9;
        text-transform: uppercase;
    }

    .tagline__main[data-arrow-visible] .tagline__arrow {
        opacity: 1;
    }

    .tagline__screens {
        color: var(--color-cream);
    }

    .tagline__stage {
        color: var(--color-coral);
        font-family: var(--font-serif);
        font-size: 0.92em;
        font-style: italic;
    }

    [data-typewriter-word] {
        border-right: 0.06em solid transparent;
    }

    [data-typewriter-word][data-typing] {
        border-right-color: var(--color-cream-60);
    }
</style>

<script>
    interface TypewriterState {
        charIndex: number;
        container: HTMLElement;
        originals: string[];
        wordIndex: number;
        words: NodeListOf<HTMLElement>;
    }

    const ARROW_PAUSE = 350;
    const CHAR_DELAY = 65;

    let typewriterController: AbortController | undefined;
    let typewriterObserver: IntersectionObserver | undefined;
    let typewriterTimeouts: Timer[] = [];

    function clearTypewriterTimeouts() {
        typewriterTimeouts.forEach(clearTimeout);
        typewriterTimeouts = [];
    }

    function scheduleTimeout(fn: () => void, ms: number) {
        typewriterTimeouts.push(setTimeout(fn, ms));
    }

    function initTypewriter() {
        clearTypewriterTimeouts();
        typewriterObserver?.disconnect();
        typewriterController?.abort();
        typewriterController = new AbortController();

        const container = document.querySelector<HTMLElement>('[data-typewriter]');

        if (!container) return;

        const words = container.querySelectorAll<HTMLElement>('[data-typewriter-word]');
        const originals = Array.from(words, el => el.textContent || '');
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (container.hasAttribute('data-typed') || prefersReducedMotion) {
            words.forEach((el, i) => {
                el.textContent = originals[i];
            });
            container.setAttribute('data-typed', '');
            container.setAttribute('data-arrow-visible', '');

            return;
        }

        words.forEach((el) => {
            el.textContent = '';
        });

        typewriterObserver = new IntersectionObserver(([entry]) => {
            if (!entry.isIntersecting) return;

            typewriterObserver?.disconnect();
            typeNextWord({ charIndex: 0, container, originals, wordIndex: 0, words });
        }, { rootMargin: '0px 0px -15% 0px' });

        typewriterObserver.observe(container);
    }

    function typeChar(state: TypewriterState) {
        if (typewriterController?.signal.aborted) return;

        const { container, originals, words } = state;
        const word = words[state.wordIndex];
        const text = originals[state.wordIndex];

        if (state.charIndex < text.length) {
            word.textContent = text.slice(0, state.charIndex + 1);
            state.charIndex++;
            scheduleTimeout(() => typeChar(state), CHAR_DELAY);

            return;
        }

        word.removeAttribute('data-typing');
        state.wordIndex++;

        if (state.wordIndex === 1) {
            scheduleTimeout(() => {
                container.setAttribute('data-arrow-visible', '');
                scheduleTimeout(() => typeNextWord(state), ARROW_PAUSE);
            }, ARROW_PAUSE);
        } else {
            scheduleTimeout(() => typeNextWord(state), ARROW_PAUSE);
        }
    }

    function typeNextWord(state: TypewriterState) {
        if (typewriterController?.signal.aborted) return;

        if (state.wordIndex >= state.words.length) {
            state.container.setAttribute('data-typed', '');

            return;
        }

        state.charIndex = 0;
        state.words[state.wordIndex].setAttribute('data-typing', '');
        typeChar(state);
    }

    document.addEventListener('astro:before-swap', () => {
        clearTypewriterTimeouts();
        typewriterObserver?.disconnect();
        typewriterController?.abort();
    });

    document.addEventListener('astro:page-load', initTypewriter);
</script>
