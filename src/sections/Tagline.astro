---
import IconArrow from '@components/IconArrow.astro';
---

<section
    class="section tagline text-center"
    aria-labelledby="tagline-title"
>
    <div class="shell">
        <h2
            id="tagline-title"
            class="tagline__title uppercase select-none"
            aria-label="Screen to Stage"
            data-typewriter
        >
            <span
                class="tagline__screen"
                data-typewriter-word
            >
                Screen
            </span>
            <span class="tagline__arrow text-cream-60">
                <IconArrow />
            </span>
            <span
                class="tagline__stage font-serif italic text-coral"
                data-typewriter-word
            >
                Stage
            </span>
        </h2>
    </div>
</section>

<style>
    .tagline__arrow {
        opacity: 0;
        padding-left: 0.145em;
        padding-right: 0.165em;
        transition: opacity var(--duration-slow) ease;
    }

    .tagline__screen {
        border-right: 0.04em solid transparent;
    }

    .tagline__screen[data-typing] {
        border-right-color: var(--color-coral);
    }

    .tagline__stage {
        font-size: 0.92em;
    }

    .tagline__stage::after {
        background: var(--color-coral);
        content: '';
        display: inline-block;
        height: 1.3em;
        margin: -0.5em 0 -0.5em 0.12em;
        opacity: 0;
        transform: skewX(-13deg);
        vertical-align: 0.2em;
        width: 0.04em;
    }

    .tagline__stage[data-typing]::after {
        opacity: 1;
    }

    .tagline__title {
        font-size: clamp(44px, 13.75vw, 176px);
        letter-spacing: -0.01em;
        line-height: 0.9;
        white-space: nowrap;
    }

    .tagline__title[data-arrow-visible] .tagline__arrow {
        opacity: 1;
    }

    .tagline__title[data-typed] .tagline__stage::after {
        animation: tagline__blink 1.1s step-end infinite;
        opacity: 1;
    }

    @keyframes tagline__blink {
        0%,
        100% {
            opacity: 1;
        }

        50% {
            opacity: 0;
        }
    }
</style>

<script>
    import { REDUCED_MOTION_QUERY } from '@lib/constants';
    import { registerPageScript } from '@lib/utils';

    interface TypewriterState {
        characterIndex: number;
        container: HTMLElement;
        originalTexts: string[];
        wordIndex: number;
        words: NodeListOf<HTMLElement>;
    }

    const ARROW_PAUSE = 350;
    const CHARACTER_DELAY = 75;
    const TYPEWRITER_ROOT_MARGIN = '0px 0px -15% 0px';

    const reducedMotionQuery = window.matchMedia(REDUCED_MOTION_QUERY);

    let typewriterObserver: IntersectionObserver | undefined;
    let typewriterState: TypewriterState | undefined;
    let typewriterTimeouts: ReturnType<typeof setTimeout>[] = [];

    function clearTypewriterTimeouts() {
        typewriterTimeouts.forEach(clearTimeout);
        typewriterTimeouts = [];
    }

    function handleAbort() {
        clearTypewriterTimeouts();
        typewriterObserver?.disconnect();
        typewriterState = undefined;
    }

    function handleReducedMotionChange(event: MediaQueryListEvent) {
        if (!event.matches || !typewriterState) return;

        const { container, originalTexts, words } = typewriterState;

        clearTypewriterTimeouts();
        typewriterObserver?.disconnect();

        words.forEach((element, index) => {
            element.removeAttribute('data-typing');
            element.textContent = originalTexts[index];
        });

        container.setAttribute('data-arrow-visible', '');
        container.setAttribute('data-typed', '');
        typewriterState = undefined;
    }

    function handleTypewriterIntersect(entries: IntersectionObserverEntry[], observer: IntersectionObserver, state: TypewriterState) {
        if (!entries.some(entry => entry.isIntersecting)) return;

        observer.disconnect();
        typeNextWord(state);
    }

    function initTypewriter(signal: AbortSignal) {
        signal.addEventListener('abort', handleAbort);

        const container = document.querySelector<HTMLElement>('[data-typewriter]');

        if (!container) return;

        const prefersReducedMotion = reducedMotionQuery.matches;
        const words = container.querySelectorAll<HTMLElement>('[data-typewriter-word]');

        const originalTexts = Array.from(words, element => element.textContent);

        if (prefersReducedMotion) {
            container.setAttribute('data-arrow-visible', '');
            container.setAttribute('data-typed', '');

            return;
        }

        words.forEach((element) => {
            element.textContent = '';
        });

        const state = { characterIndex: 0, container, originalTexts, wordIndex: 0, words };

        typewriterObserver = new IntersectionObserver(
            (entries, observer) => handleTypewriterIntersect(entries, observer, state),
            { rootMargin: TYPEWRITER_ROOT_MARGIN },
        );

        typewriterState = state;
        typewriterObserver.observe(container);
    }

    function revealArrow(state: TypewriterState) {
        state.container.setAttribute('data-arrow-visible', '');
        scheduleTimeout(() => typeNextWord(state), ARROW_PAUSE);
    }

    function scheduleTimeout(callback: () => void, delay: number) {
        typewriterTimeouts.push(setTimeout(callback, delay));
    }

    function typeCharacter(state: TypewriterState) {
        const { originalTexts, words } = state;

        const text = originalTexts[state.wordIndex];
        const word = words[state.wordIndex];

        if (state.characterIndex < text.length) {
            word.textContent = text.slice(0, state.characterIndex + 1);
            state.characterIndex++;
            scheduleTimeout(() => typeCharacter(state), CHARACTER_DELAY);

            return;
        }

        word.removeAttribute('data-typing');
        state.wordIndex++;

        if (state.wordIndex === 1) scheduleTimeout(() => revealArrow(state), ARROW_PAUSE);
        else typeNextWord(state);
    }

    function typeNextWord(state: TypewriterState) {
        if (state.wordIndex >= state.words.length) {
            state.container.setAttribute('data-typed', '');

            return;
        }

        state.characterIndex = 0;
        state.words[state.wordIndex].setAttribute('data-typing', '');
        typeCharacter(state);
    }

    reducedMotionQuery.addEventListener('change', handleReducedMotionChange);
    registerPageScript(initTypewriter);
</script>
