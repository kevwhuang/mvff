---
import { Image, getImage } from 'astro:assets';

import SectionHeader from '@components/SectionHeader.astro';
import { getFigures } from '@lib/store';

import type { ImageMetadata } from 'astro';

const LANDSCAPE_WIDTH = 1_168;
const PORTRAIT_WIDTH = 514;

const figures = await getFigures();
const images = import.meta.glob<{ default: ImageMetadata }>('../images/gallery/*.webp', { eager: true });

const resolvedFigures = await Promise.all(figures.map(async (figure) => {
    const asset = images[`../images/gallery/${figure.id}.webp`];

    if (!asset) throw new Error(`Missing gallery asset: ${figure.id}.webp`);

    const metadata = asset.default;

    const isPortrait = metadata.height > metadata.width;
    const lightboxImage = await getImage({ src: metadata, width: metadata.width });

    return {
        alt: figure.alt,
        gridWidth: Math.min(isPortrait ? PORTRAIT_WIDTH : LANDSCAPE_WIDTH, metadata.width),
        image: metadata,
        isPortrait,
        label: figure.label,
        orientation: isPortrait ? 'portrait' : 'landscape',
        source: lightboxImage.src,
    };
}));
---

<section
    class="gallery section"
    aria-labelledby="gallery-title"
>
    <div class="shell">
        <SectionHeader
            headingId="gallery-title"
            level="h2"
        >
            The Wrap
        </SectionHeader>
        <ul
            class="gallery__grid flex flex-col list-none"
            data-scroll
            data-scroll-stagger="0.12"
        >
            {resolvedFigures.map(figure => (
                <li class:list={['gallery__figure', { 'gallery__figure--portrait': figure.isPortrait }, 'self-center w-full']}>
                    <figure class="flex flex-col gap-3">
                        <button
                            class:list={[
                                'gallery__frame',
                                figure.isPortrait ? 'aspect-2/3' : 'aspect-3/2',
                                'block overflow-hidden relative w-full p-0 border border-cream-15 bg-navy select-none',
                            ]}
                            aria-label={`View ${figure.label}`}
                            data-gallery-alt={figure.alt}
                            data-gallery-label={figure.label}
                            data-gallery-orientation={figure.orientation}
                            data-gallery-source={figure.source}
                            type="button"
                        >
                            <Image
                                class="gallery__image object-cover h-full w-full"
                                alt={figure.alt}
                                densities={[1, 2]}
                                draggable="false"
                                loading="lazy"
                                src={figure.image}
                                width={figure.gridWidth}
                            />
                        </button>
                        <figcaption class="gallery__meta flex font-mono uppercase text-cream-60">
                            <span>{figure.label}</span>
                        </figcaption>
                    </figure>
                </li>
            ))}
        </ul>
    </div>
    <div
        class="gallery__lightbox fixed grid inset-0 place-items-center z-200 bg-black-95 backdrop-blur-sm cursor-zoom-out"
        aria-hidden="true"
        aria-labelledby="lightbox-title"
        aria-modal="true"
        role="dialog"
    >
        <div
            class="gallery__lightbox-inner flex flex-col relative w-full gap-3 cursor-default"
            tabindex="-1"
        >
            <button
                class="gallery__lightbox-close absolute grid place-items-center right-4 top-4 z-1 size-12 border border-cream-15 font-mono leading-none text-2xl bg-navy text-cream select-none"
                aria-label="Close"
                type="button"
            >
                &times;
            </button>
            <h2
                id="lightbox-title"
                class="sr-only"
            >
                &nbsp;
            </h2>
            <img class="gallery__lightbox-image block object-contain h-auto w-full mx-auto border border-cream-15 select-none" alt="" draggable="false" />
            <div class="gallery__lightbox-meta flex justify-between font-mono uppercase text-cream-60">
                <span class="gallery__lightbox-label" />
            </div>
        </div>
    </div>
</section>

<style>
    .gallery__figure--portrait {
        width: 44%;
    }

    .gallery__frame {
        transition: transform var(--duration-base) ease;
    }

    .gallery__frame:active {
        transform: scale(0.99);
    }

    .gallery__frame:focus-visible:not(:active) {
        transform: scale(1.01);
    }

    .gallery__frame:focus-visible .gallery__image {
        filter: grayscale(0) contrast(1.08);
        transform: scale(1.03);
    }

    .gallery__frame:focus-visible::after {
        border-color: var(--color-coral);
    }

    .gallery__frame:hover:not(:active) {
        transform: scale(1.01);
    }

    .gallery__frame:hover .gallery__image {
        filter: grayscale(0) contrast(1.08);
        transform: scale(1.03);
    }

    .gallery__frame:hover::after {
        border-color: var(--color-coral);
    }

    .gallery__frame::after {
        border: 1px solid transparent;
        content: '';
        inset: 12px;
        pointer-events: none;
        position: absolute;
        transition: border-color var(--duration-base) ease;
    }

    .gallery__grid {
        gap: var(--section-padding-sm);
    }

    .gallery__image {
        filter: grayscale(0.25) contrast(1.05);
        transition:
            filter var(--duration-slow) ease,
            transform var(--duration-slower) ease;
    }

    .gallery__lightbox {
        --lightbox-frame: calc(100dvh - 2 * var(--lightbox-gutter-block) - 30px);
        --lightbox-gutter: clamp(40px, calc(13.33px + 8.33vw), 120px);
        --lightbox-gutter-block: min(var(--lightbox-gutter), 15dvh);
        opacity: 0;
        padding: var(--lightbox-gutter-block) var(--lightbox-gutter);
        transition:
            opacity var(--duration-fast) ease,
            visibility 0s var(--duration-fast);
        visibility: hidden;
    }

    .gallery__lightbox[data-gallery-orientation='landscape'] .gallery__lightbox-inner {
        max-width: min(calc(100dvw - 2 * var(--lightbox-gutter)), calc(var(--lightbox-frame) * 3 / 2));
    }

    .gallery__lightbox[data-gallery-orientation='portrait'] .gallery__lightbox-inner {
        max-width: min(calc(100dvw - 2 * var(--lightbox-gutter)), calc(var(--lightbox-frame) * 2 / 3));
    }

    .gallery__lightbox[data-open] {
        opacity: 1;
        transition: opacity var(--duration-fast) ease;
        visibility: visible;
    }

    .gallery__lightbox[data-open] .gallery__lightbox-inner {
        transform: scale(1);
    }

    .gallery__lightbox-close {
        transition:
            border-color var(--duration-fast) ease,
            color var(--duration-fast) ease;
    }

    .gallery__lightbox-close:active {
        border-color: var(--color-coral);
        color: var(--color-coral);
    }

    .gallery__lightbox-close:focus-visible {
        border-color: var(--color-coral);
        color: var(--color-coral);
    }

    .gallery__lightbox-close:hover {
        border-color: var(--color-coral);
        color: var(--color-coral);
    }

    .gallery__lightbox-image {
        max-height: var(--lightbox-frame);
        min-height: 0;
    }

    .gallery__lightbox-inner {
        max-height: calc(100dvh - 2 * var(--lightbox-gutter-block));
        max-width: calc(100dvw - 2 * var(--lightbox-gutter));
        transform: scale(0.97);
        transition: transform var(--duration-fast) ease;
    }

    .gallery__lightbox-meta {
        flex-shrink: 0;
        font-size: 12px;
        letter-spacing: 0.16em;
    }

    .gallery__meta {
        font-size: 12px;
        letter-spacing: 0.16em;
    }

    @media (max-width: 768px) {
        .gallery__figure--portrait {
            width: 64%;
        }

        .gallery__lightbox-close:not(:focus-visible) {
            clip-path: inset(50%);
            height: 1px;
            width: 1px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .gallery__lightbox-inner {
            transform: none;
            transition: none;
        }
    }
</style>

<script>
    import { registerPageScript } from '@lib/utils';

    const DOUBLE_CLICK_DETAIL = 2;

    let lastTrigger: HTMLElement | undefined;
    let lightbox: HTMLElement | null = null;
    let lightboxClose: HTMLElement | null = null;
    let lightboxImage: HTMLImageElement | null = null;
    let lightboxInner: HTMLElement | null = null;

    function closeLightbox() {
        if (!lightbox) return;

        document.documentElement.style.overflow = '';
        lightbox.removeAttribute('data-open');
        lightbox.setAttribute('aria-hidden', 'true');
        lastTrigger?.focus();
        lastTrigger = undefined;
    }

    function handleLightboxKeydown(event: KeyboardEvent) {
        if (!lightbox?.hasAttribute('data-open')) return;

        if (event.key === 'Escape') {
            closeLightbox();
        } else if (event.key === 'Tab') {
            event.preventDefault();
            lightboxClose?.focus();
        }
    }

    function initGallery(signal: AbortSignal) {
        lastTrigger = undefined;
        lightbox = document.querySelector<HTMLElement>('.gallery__lightbox');
        lightboxClose = null;
        lightboxImage = null;
        lightboxInner = null;

        signal.addEventListener('abort', () => {
            document.documentElement.style.overflow = '';
        });

        if (!lightbox) return;

        lightboxClose = lightbox.querySelector<HTMLElement>('.gallery__lightbox-close');
        lightboxImage = lightbox.querySelector<HTMLImageElement>('.gallery__lightbox-image');
        lightboxInner = lightbox.querySelector<HTMLElement>('.gallery__lightbox-inner');

        if (!lightboxClose || !lightboxImage || !lightboxInner) return;

        document.querySelectorAll<HTMLElement>('.gallery__frame').forEach((frame) => {
            frame.addEventListener('click', () => openLightbox(frame), { signal });
        });

        document.addEventListener('keydown', handleLightboxKeydown, { signal });

        lightbox.addEventListener('click', (event) => {
            if (event.detail < DOUBLE_CLICK_DETAIL) closeLightbox();
        }, { signal });

        lightboxClose.addEventListener('click', closeLightbox, { signal });
        lightboxImage.addEventListener('error', showLightboxImage, { signal });
        lightboxImage.addEventListener('load', showLightboxImage, { signal });
        lightboxInner.addEventListener('click', event => event.stopPropagation(), { signal });
    }

    function openLightbox(frame: HTMLElement) {
        if (!lightbox || !lightboxClose || !lightboxImage) return;

        const label = lightbox.querySelector<HTMLElement>('.gallery__lightbox-label');
        const title = lightbox.querySelector<HTMLElement>('#lightbox-title');

        if (!label || !title) return;

        const { galleryAlt = '', galleryLabel = '', galleryOrientation = '', gallerySource = '' } = frame.dataset;

        if (lightboxImage.getAttribute('src') !== gallerySource) lightboxImage.style.visibility = 'hidden';

        document.documentElement.style.overflow = 'hidden';
        label.textContent = galleryLabel;
        lastTrigger = frame;
        lightbox.dataset.galleryOrientation = galleryOrientation;
        lightboxImage.alt = galleryAlt;
        lightboxImage.src = gallerySource;
        title.textContent = galleryLabel;
        lightbox.removeAttribute('aria-hidden');
        lightbox.setAttribute('data-open', '');

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                if (lightbox?.hasAttribute('data-open')) lightboxClose?.focus();
            });
        });
    }

    function showLightboxImage() {
        lightboxImage?.style.removeProperty('visibility');
    }

    registerPageScript(initGallery);
</script>
