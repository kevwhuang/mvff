---
import { Image, getImage } from 'astro:assets';

import SectionHeader from '@components/SectionHeader.astro';
import { getFigures } from '@lib/store';

import type { ImageMetadata } from 'astro';

const LANDSCAPE_WIDTH = 920;
const PORTRAIT_WIDTH = 612;

const images = import.meta.glob<{ default: ImageMetadata }>('../images/gallery/*.webp', { eager: true });
const figures = await getFigures();

const resolvedFigures = await Promise.all(figures.map(async (figure) => {
    const asset = images[`../images/gallery/${figure.image}`];

    if (!asset) {
        throw new Error(`Missing gallery asset: ${figure.image}`);
    }

    const metadata = asset.default;
    const isPortrait = metadata.height > metadata.width;
    const lightboxImage = await getImage({ src: metadata, width: metadata.width });

    return {
        alt: figure.alt,
        gridWidth: Math.min(isPortrait ? PORTRAIT_WIDTH : LANDSCAPE_WIDTH, metadata.width),
        image: metadata,
        isPortrait,
        label: figure.label,
        orientation: isPortrait ? 'portrait' : 'landscape',
        source: lightboxImage.src,
    };
}));
---

<section
    id="gallery"
    class="gallery section"
    aria-labelledby="gallery-title"
>
    <div class="shell">
        <SectionHeader
            headingId="gallery-title"
            level="h2"
        >
            The Wrap
        </SectionHeader>
        <ul
            class="gallery__grid flex flex-col list-none"
            data-scroll
            data-scroll-stagger="0.12"
        >
            {resolvedFigures.map(figure => (
                <li class:list={['gallery__figure self-center', { 'gallery__figure--portrait': figure.isPortrait }]}>
                    <figure class="flex flex-col gap-3">
                        <button
                            class:list={[
                                'gallery__frame block overflow-hidden relative w-full p-0 border border-cream-15 bg-navy',
                                figure.isPortrait ? 'aspect-2/3' : 'aspect-3/2',
                            ]}
                            aria-label={`View ${figure.label}`}
                            data-gallery-alt={figure.alt}
                            data-gallery-label={figure.label}
                            data-gallery-orientation={figure.orientation}
                            data-gallery-source={figure.source}
                            type="button"
                        >
                            <Image
                                class="gallery__image object-cover h-full w-full"
                                alt={figure.alt}
                                densities={[1, 2]}
                                loading="lazy"
                                src={figure.image}
                                width={figure.gridWidth}
                            />
                        </button>
                        <figcaption class="gallery__meta flex font-mono uppercase text-cream-60">
                            <span>{figure.label}</span>
                        </figcaption>
                    </figure>
                </li>
            ))}
        </ul>
    </div>
    <div
        class="gallery__lightbox fixed grid inset-0 place-items-center z-200 bg-black-95 backdrop-blur-sm cursor-zoom-out"
        aria-hidden="true"
        aria-labelledby="lightbox-title"
        aria-modal="true"
        role="dialog"
    >
        <div
            class="gallery__lightbox-inner flex flex-col relative gap-3 cursor-default"
            tabindex="-1"
        >
            <h2
                id="lightbox-title"
                class="sr-only"
            >
                &nbsp;
            </h2>
            <img class="gallery__lightbox-image block border border-cream-15" alt="" />
            <div class="gallery__lightbox-meta flex justify-between font-mono uppercase text-cream-60">
                <span class="gallery__lightbox-label" />
            </div>
        </div>
    </div>
</section>

<style>
    .gallery__figure {
        width: 76%;
    }

    .gallery__figure--portrait {
        width: 44%;
    }

    .gallery__frame {
        color: inherit;
        transition: transform var(--duration-base) ease;
    }

    .gallery__frame:active {
        transform: scale(0.99);
    }

    .gallery__frame:focus-visible:not(:active) {
        transform: scale(1.01);
    }

    .gallery__frame:focus-visible .gallery__image {
        filter: grayscale(0) contrast(1.08);
        transform: scale(1.03);
    }

    .gallery__frame:focus-visible::after {
        border-color: var(--color-coral);
    }

    .gallery__frame::after {
        border: 1px solid var(--color-cream-15);
        content: '';
        inset: 12px;
        pointer-events: none;
        position: absolute;
        transition: border-color var(--duration-base) ease;
    }

    .gallery__grid {
        gap: var(--section-padding-sm);
    }

    .gallery__image {
        filter: grayscale(0.25) contrast(1.05);
        transition:
            filter var(--duration-slow) ease,
            transform var(--duration-slower) ease;
    }

    .gallery__lightbox {
        opacity: 0;
        padding: clamp(16px, 5vw, 64px);
        pointer-events: none;
        transition:
            opacity var(--duration-fast) ease,
            visibility 0s var(--duration-fast);
        visibility: hidden;
    }

    .gallery__lightbox[data-gallery-orientation='portrait'] .gallery__lightbox-inner {
        max-width: calc((100dvh - 128px) * 2 / 3);
    }

    .gallery__lightbox[data-open] {
        opacity: 1;
        pointer-events: auto;
        transition: opacity var(--duration-fast) ease;
        visibility: visible;
    }

    .gallery__lightbox[data-open] .gallery__lightbox-inner {
        transform: scale(1);
    }

    .gallery__lightbox-image {
        margin-inline: auto;
        max-height: 82dvh;
        max-width: 100%;
        object-fit: contain;
        width: auto;
    }

    .gallery__lightbox-inner {
        max-width: min(calc(1280px - 2 * var(--shell-pad)), calc((100dvh - 128px) * 3 / 2));
        transform: scale(0.97);
        transition: transform var(--duration-fast) ease;
        width: 100%;
    }

    .gallery__lightbox-meta {
        font-size: 12px;
        letter-spacing: 0.16em;
    }

    .gallery__meta {
        font-size: 12px;
        letter-spacing: 0.16em;
    }

    @media (hover: hover) {
        .gallery__frame:hover:not(:active) {
            transform: scale(1.01);
        }

        .gallery__frame:hover .gallery__image {
            filter: grayscale(0) contrast(1.08);
            transform: scale(1.03);
        }

        .gallery__frame:hover::after {
            border-color: var(--color-coral);
        }
    }

    @media (max-width: 768px) {
        .gallery__figure {
            width: 92%;
        }

        .gallery__figure--portrait {
            width: 64%;
        }

        .gallery__lightbox-image {
            max-height: 80dvh;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .gallery__lightbox-inner {
            transform: none;
            transition: none;
        }
    }
</style>

<script>
    import { registerPageScript } from '@lib/utils';

    let lastTrigger: HTMLElement | undefined;
    let lightbox: HTMLElement | null = null;

    function closeLightbox() {
        if (!lightbox?.hasAttribute('data-open')) return;

        document.documentElement.style.overflow = '';
        lightbox.removeAttribute('data-open');
        lightbox.setAttribute('aria-hidden', 'true');
        lastTrigger?.focus();
        lastTrigger = undefined;
    }

    function handleLightboxKeydown(event: KeyboardEvent) {
        if (!lightbox?.hasAttribute('data-open')) return;

        if (event.key === 'Escape') {
            closeLightbox();
        } else if (event.key === 'Tab') {
            event.preventDefault();
            lightbox.querySelector<HTMLElement>('.gallery__lightbox-inner')?.focus();
        }
    }

    function handleTeardown() {
        document.documentElement.style.overflow = '';
    }

    function initGallery(signal: AbortSignal) {
        lastTrigger = undefined;
        lightbox = document.querySelector<HTMLElement>('.gallery__lightbox');
        signal.addEventListener('abort', handleTeardown);

        if (!lightbox) return;

        const inner = lightbox.querySelector('.gallery__lightbox-inner');

        document.querySelectorAll<HTMLElement>('.gallery__frame').forEach((frame) => {
            frame.addEventListener('click', () => openLightbox(frame), { signal });
        });

        inner?.addEventListener('click', event => event.stopPropagation(), { signal });
        lightbox.addEventListener('click', closeLightbox, { signal });
        document.addEventListener('keydown', handleLightboxKeydown, { signal });
    }

    function openLightbox(frame: HTMLElement) {
        if (!lightbox) return;

        const image = lightbox.querySelector<HTMLImageElement>('.gallery__lightbox-image');
        const label = lightbox.querySelector<HTMLElement>('.gallery__lightbox-label');
        const title = lightbox.querySelector<HTMLElement>('#lightbox-title');

        if (!image || !label || !title) return;

        image.src = frame.dataset.gallerySource ?? '';
        image.alt = frame.dataset.galleryAlt ?? '';
        label.textContent = frame.dataset.galleryLabel || '';
        title.textContent = frame.dataset.galleryLabel || '';
        lightbox.dataset.galleryOrientation = frame.dataset.galleryOrientation ?? '';
        document.documentElement.style.overflow = 'hidden';
        lastTrigger = frame;
        lightbox.setAttribute('data-open', '');
        lightbox.removeAttribute('aria-hidden');
        lightbox.querySelector<HTMLElement>('.gallery__lightbox-inner')?.focus();
    }

    registerPageScript(initGallery);
</script>
