---
import SectionHeader from '@components/SectionHeader.astro';
import { LINKS } from '@lib/constants';
import { pad } from '@lib/utils';

const CHANNELS = [
    { href: LINKS.instagram, isExternal: true, label: 'Instagram', value: '@atxmvff' },
    { href: LINKS.email, isExternal: false, label: 'Email', value: 'contact@atxmusicvideofilmfestival.com' },
    { href: LINKS.phone, isExternal: false, label: 'Phone', value: '(281) 466-9387' },
] as const;
---

<section
    id="contact"
    class="contact section"
    aria-labelledby="contact-title"
>
    <div class="shell">
        <SectionHeader
            headingId="contact-title"
            level="h2"
        >
            Contact Us
        </SectionHeader>
        <ol
            class="contact__channels list-none"
            data-scroll
            data-scroll-stagger="0.08"
        >
            {CHANNELS.map((channel, index) => (
                <li class="contact__channel border-b border-cream-15">
                    <a
                        class="contact__channel-link grid items-center relative isolate no-underline text-cream"
                        href={channel.href}
                        rel={channel.isExternal ? 'noopener' : undefined}
                        target={channel.isExternal ? '_blank' : undefined}
                    >
                        <span
                            class="contact__channel-index font-mono text-cream-60 select-none"
                            aria-hidden="true"
                        >
                            / {pad(index + 1)}
                        </span>
                        <span class="contact__channel-label font-display uppercase">{channel.label}</span>
                        <span class="contact__channel-value flex items-baseline min-w-0 gap-2 font-serif italic wrap-anywhere text-cream-60">
                            <span class="min-w-0">{channel.value.split('@').flatMap((part, index) => (index === 0 ? [part] : [<wbr />, `@${part}`]))}</span>
                            {channel.isExternal && (
                                <span
                                    class="contact__channel-cue not-italic"
                                    aria-hidden="true"
                                >
                                    &rarr;
                                </span>
                            )}
                        </span>
                    </a>
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    .contact__channel:last-child {
        border-bottom: none;
    }

    .contact__channel-index {
        font-size: 14px;
        letter-spacing: 0.16em;
    }

    .contact__channel-label {
        font-size: clamp(32px, calc(21.33px + 3.33vw), 64px);
        line-height: 0.95;
        transition:
            color var(--duration-fast) ease,
            transform var(--duration-fast) ease;
    }

    .contact__channel-link {
        gap: 4px clamp(16px, calc(8px + 2.5vw), 40px);
        grid-template-columns: 80px 1fr 1.2fr;
        padding: clamp(24px, calc(20px + 1.25vw), 36px) 0;
    }

    .contact__channel-link:active .contact__channel-label {
        color: var(--color-coral);
        transform: translateX(8px);
    }

    .contact__channel-link:active .contact__channel-value {
        color: var(--color-cream);
    }

    .contact__channel-link:active::after {
        opacity: 1;
    }

    .contact__channel-link::after {
        background: linear-gradient(90deg, transparent, var(--color-coral-10), transparent);
        content: '';
        inset: 0;
        opacity: 0;
        pointer-events: none;
        position: absolute;
        transition: opacity var(--duration-fast) ease;
        z-index: -1;
    }

    .contact__channel-value {
        font-size: clamp(20px, calc(18.67px + 0.42vw), 24px);
        justify-content: flex-end;
        line-height: 1.4;
        text-align: right;
        transition: color var(--duration-fast) ease;
    }

    @media (hover: hover) {
        .contact__channel-link:hover .contact__channel-label {
            color: var(--color-coral);
            transform: translateX(8px);
        }

        .contact__channel-link:hover .contact__channel-value {
            color: var(--color-cream);
        }

        .contact__channel-link:hover::after {
            opacity: 1;
        }
    }

    @media (max-width: 768px) {
        .contact__channel-index {
            display: none;
        }

        .contact__channel-link {
            grid-template-columns: 1fr;
        }

        .contact__channel-value {
            justify-content: normal;
            text-align: left;
        }
    }
</style>
