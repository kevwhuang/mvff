---
const highlights = [
    { title: 'Screenings', tag: '28 selections', desc: '28 official selections across all genres. Four screening blocks featuring emerging and established artists.' },
    { title: 'Awards', tag: '6+ categories', desc: 'Best Music Video, Best Director, Best Producer, Best Song, Audience Choice, and partner organization awards.' },
    { title: 'Q&A Panel', tag: 'Live discussion', desc: 'Conversations with directors, producers, and artists after each screening block. Community partner spotlights.' },
    { title: 'Live Music', tag: 'Two sets', desc: 'Nominee performances across all music genres. Opening mixer and closing celebration set. Where Austin\'s music and film worlds collide.' },
    { title: 'Pool Party', tag: 'Until 2 AM', desc: 'Cabana Club night swim atmosphere. Red carpet meets pool party.' },
];
---

<section class="section" aria-labelledby="experience-heading">
    <div class="shell">
        <div class="section-head">
            <span class="section-num">[ 02 ]</span>
            <h2 id="experience-heading" class="section-title">The Experience</h2>
            <span class="section-meta">FIVE ACTS / ONE NIGHT</span>
        </div>
        <div>
            {highlights.map((h, i) => (
                <div class="highlight">
                    <span class="highlight__num">/ {String(i + 1).padStart(2, '0')}</span>
                    <h3 class="highlight__title">{h.title}</h3>
                    <p class="highlight__desc">{h.desc}</p>
                    <span class="highlight__tag">{h.tag}</span>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .highlight {
        align-items: baseline;
        border-bottom: 1px solid var(--line);
        cursor: pointer;
        display: grid;
        gap: clamp(16px, 3vw, 40px);
        grid-template-columns: 80px 1fr 1.2fr 80px;
        padding: clamp(28px, 4vw, 44px) 0;
        transition: padding 250ms ease;
    }

    .highlight:first-child {
        border-top: 1px solid var(--line);
    }

    .highlight:hover {
        background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--accent) 8%, transparent), transparent);
    }

    .highlight:hover .highlight__title {
        color: var(--accent);
        transform: translateX(8px);
    }

    .highlight__num {
        color: var(--paper-mute);
        font-family: var(--ff-mono);
        font-size: 12px;
        letter-spacing: 0.18em;
    }

    .highlight__title {
        font-size: clamp(34px, 5vw, 64px);
        line-height: 0.95;
        text-transform: uppercase;
        transition: all 250ms ease;
    }

    .highlight__desc {
        color: var(--paper-dim);
        font-family: var(--ff-serif);
        font-size: clamp(15px, 1.3vw, 17px);
        line-height: 1.45;
    }

    .highlight__tag {
        color: var(--accent);
        font-family: var(--ff-mono);
        font-size: 10px;
        letter-spacing: 0.18em;
        text-align: right;
        text-transform: uppercase;
    }

    @media (max-width: 720px) {
        .highlight {
            gap: 14px;
            grid-template-columns: 40px 1fr;
        }

        .highlight__desc,
        .highlight__tag {
            grid-column: 2 / -1;
        }

        .highlight__tag {
            margin-top: 6px;
            text-align: left;
        }
    }
</style>
