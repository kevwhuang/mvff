---
import SectionHead from '@components/SectionHead.astro';
import { pad } from '@lib/utils';

const HIGHLIGHTS = [
    { description: '28 official selections across all genres. Four screening blocks featuring emerging and established artists.', title: 'Screenings' },
    { description: 'Best Music Video, Best Director, Best Producer, Best Song, Audience Choice, and partner organization awards.', title: 'Awards' },
    { description: 'Conversations with directors, producers, and artists after each screening block. Community partner spotlights.', title: 'Q&A Panel' },
    { description: 'Nominee performances across all music genres. Opening mixer and closing celebration set. Where Austin\'s music and film worlds collide.', title: 'Live Music' },
    { description: 'Cabana Club night swim atmosphere. Red carpet meets pool party.', title: 'Pool Party' },
];
---

<section
    class="section"
    aria-labelledby="experience-title"
>
    <div class="shell">
        <SectionHead
            headingId="experience-title"
            level="h2"
            number="[ 02 ]"
        >
            The Experience
        </SectionHead>
        <ol
            class="list-none"
            data-scroll
            data-scroll-stagger="0.08"
        >
            {HIGHLIGHTS.map((highlight, index) => (
                <li class="highlight grid isolate relative items-baseline">
                    <span class="highlight__number select-none">/ {pad(index + 1)}</span>
                    <h3 class="highlight__title">{highlight.title}</h3>
                    <p class="highlight__description">{highlight.description}</p>
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    .highlight {
        border-bottom: 1px solid var(--color-cream-15);
        gap: clamp(16px, 3.13vw, 40px);
        grid-template-columns: 80px 1fr 1.2fr;
        padding: clamp(32px, 4vw, 48px) 0;
    }

    .highlight:first-child {
        border-top: 1px solid var(--color-cream-15);
    }

    .highlight:hover::after {
        opacity: 1;
    }

    .highlight:hover .highlight__title {
        color: var(--color-coral);
        transform: translateX(8px);
    }

    .highlight::after {
        background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--color-coral) 8%, transparent), transparent);
        content: '';
        inset: 0;
        opacity: 0;
        pointer-events: none;
        position: absolute;
        transition: opacity var(--duration-fast) ease;
        z-index: -1;
    }

    .highlight__description {
        color: var(--color-cream-60);
        font-family: var(--font-serif);
        font-size: clamp(15px, 1.33vw, 17px);
        line-height: 1.45;
    }

    .highlight__number {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.18em;
    }

    .highlight__title {
        font-size: clamp(34px, 5vw, 64px);
        line-height: 0.95;
        text-transform: uppercase;
        transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
    }

    @media (max-width: 768px) {
        .highlight {
            gap: 16px;
            grid-template-columns: 1fr;
        }

        .highlight__description {
            grid-column: 1 / -1;
        }

        .highlight__number {
            display: none;
        }
    }
</style>
