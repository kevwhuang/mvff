---
import SectionHeader from '@components/SectionHeader.astro';
import { pad } from '@lib/utils';

const HIGHLIGHTS = [
    { description: 'Three screening blocks, 22 official selections \u2014 the year\'s boldest music videos, from first-timers to veterans, back to back on the big screen.', title: 'Screenings' },
    { description: 'Ten jury awards and the Spotlight Partner Award, called at 11:45 PM \u2014 the directors behind the year\'s best videos, up on the stage.', title: 'Awards' },
    { description: 'A raffle and a filmmaker Q&A after every block \u2014 directors and artists in conversation with hosts Kay Cote, Lauren, and Carmela.', title: 'Q&A Panel' },
    { description: 'Live sets from nominee artists all night \u2014 flash mobs and a fire performer lighting up the floor.', title: 'Live Music' },
    { description: 'Glamour, then chlorine. When the awards wrap, the winners take the plunge off the pool deck \u2014 the last shot of the night, dressed to be seen.', title: 'Pool Party' },
] as const;
---

<section
    class="experience section"
    aria-labelledby="experience-title"
>
    <div class="shell">
        <SectionHeader
            headingId="experience-title"
            level="h2"
            marker="[ 02 ]"
        >
            The Experience
        </SectionHeader>
        <ol
            class="list-none"
            data-scroll
            data-scroll-stagger="0.08"
        >
            {HIGHLIGHTS.map((highlight, index) => (
                <li class="experience__highlight sweep grid items-center relative isolate border-b border-cream-15">
                    <span
                        class="experience__highlight-number font-mono text-cream-60 select-none"
                        aria-hidden="true"
                    >
                        / {pad(index + 1)}
                    </span>
                    <h3 class="experience__highlight-title uppercase">{highlight.title}</h3>
                    <p class="experience__highlight-description font-serif text-cream-60">{highlight.description}</p>
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    .experience__highlight {
        gap: 16px clamp(16px, calc(8px + 2.5vw), 40px);
        grid-template-columns: 80px 1fr 1.2fr;
        padding: clamp(32px, calc(26.67px + 1.67vw), 48px) 0;
    }

    .experience__highlight:last-child {
        border-bottom: none;
    }

    .experience__highlight-description {
        font-size: 20px;
        line-height: 1.4;
        transition: color var(--duration-fast) ease;
    }

    .experience__highlight-number {
        font-size: 12px;
        letter-spacing: 0.16em;
    }

    .experience__highlight-title {
        font-size: clamp(32px, calc(21.33px + 3.33vw), 64px);
        line-height: 0.95;
        transition:
            color var(--duration-fast) ease,
            transform var(--duration-fast) ease;
    }

    @media (hover: hover) {
        .experience__highlight:hover .experience__highlight-description {
            color: var(--color-cream);
        }

        .experience__highlight:hover .experience__highlight-title {
            color: var(--color-coral);
            transform: translateX(8px);
        }

        .experience__highlight:hover::after {
            opacity: 1;
        }
    }

    @media (max-width: 768px) {
        .experience__highlight {
            grid-template-columns: 1fr;
        }

        .experience__highlight-description {
            grid-column: 1 / -1;
        }

        .experience__highlight-number {
            display: none;
        }
    }
</style>
