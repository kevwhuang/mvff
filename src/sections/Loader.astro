---
import { Image } from 'astro:assets';

import logo from '@images/logos/austin_music_video_film_festival.webp';
import { LOADER_SHOWN_KEY, REDUCED_MOTION_QUERY } from '@lib/constants';
---

<div
    class="loader fixed flex inset-0 items-center justify-center z-300 bg-night"
    aria-hidden="true"
    aria-label="Loading."
    role="status"
>
    <div class="loader__inner flex flex-col items-center">
        <Image
            class="loader__logo block h-auto"
            alt=""
            decoding="sync"
            densities={[1, 2]}
            draggable="false"
            fetchpriority="high"
            loading="eager"
            src={logo}
            width={480}
        />
        <div class="loader__bar overflow-hidden relative h-1 w-full bg-cream-15"><div class="loader__progress absolute inset-0 bg-coral" /></div>
    </div>
</div>

<style>
    .loader {
        opacity: 0;
        padding: var(--shell-pad);
        pointer-events: none;
        transition:
            opacity var(--duration-slower) ease,
            visibility 0s var(--duration-slower);
        visibility: hidden;
    }

    .loader[data-open] {
        opacity: 1;
        pointer-events: auto;
        transition: opacity var(--duration-slower) ease;
        visibility: visible;
    }

    .loader[data-open] .loader__logo,
    .loader[data-open] .loader__progress {
        animation-play-state: running;
    }

    .loader__inner {
        gap: clamp(32px, calc(26.67px + 1.67vw), 48px);
    }

    .loader__logo {
        animation: loader__pulse var(--duration-pulse) ease-in-out infinite;
        animation-play-state: paused;
        width: clamp(240px, calc(160px + 25vw), 480px);
    }

    .loader__progress {
        animation: loader__sweep 1.4s ease-in-out infinite;
        animation-play-state: paused;
        width: 30%;
    }

    @media (prefers-reduced-motion: reduce) {
        .loader {
            display: none;
        }
    }

    @keyframes loader__pulse {
        0%,
        100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.85;
            transform: scale(1.05);
        }
    }

    @keyframes loader__sweep {
        0% {
            transform: translateX(-100%);
        }

        100% {
            transform: translateX(333%);
        }
    }
</style>

<script
    define:vars={{ loaderShownKey: LOADER_SHOWN_KEY, reducedMotionQuery: REDUCED_MOTION_QUERY }}
    is:inline
>
    const FAILSAFE_DELAY = 8_000;
    const MIN_DISPLAY_DURATION = 1_000;

    let isHidden = false;
    let loader;
    let motionQuery;
    let startTime;

    function completeHide() {
        loader.removeAttribute('data-open');
        loader.setAttribute('aria-hidden', 'true');
        motionQuery.removeEventListener('change', handleReducedMotionChange);
        window.removeEventListener('pageshow', handlePageShow);
        setSiblingsInert(false);
    }

    function handleContentLoaded() {
        if (isHidden) return;

        setSiblingsInert(true);
    }

    function handlePageShow(event) {
        if (event.persisted) hide();
    }

    function handleReducedMotionChange(event) {
        if (event.matches) hide();
    }

    function hide() {
        if (isHidden) return;

        isHidden = true;

        const elapsed = performance.now() - startTime;

        const remaining = Math.max(0, MIN_DISPLAY_DURATION - elapsed);

        setTimeout(completeHide, remaining);
    }

    function initLoader() {
        if (document.readyState !== 'loading') return;

        loader = document.querySelector('.loader');

        if (!loader) return;

        motionQuery = window.matchMedia(reducedMotionQuery);

        let hasShownLoader;

        try {
            hasShownLoader = Boolean(sessionStorage.getItem(loaderShownKey));
        } catch {
            hasShownLoader = false;
        }

        if (hasShownLoader || motionQuery.matches) return;

        document.addEventListener('DOMContentLoaded', handleContentLoaded, { once: true });
        document.addEventListener('astro:before-swap', () => setSiblingsInert(false), { once: true });
        motionQuery.addEventListener('change', handleReducedMotionChange);
        window.addEventListener('load', hide, { once: true });
        window.addEventListener('pageshow', handlePageShow);
        loader.removeAttribute('aria-hidden');
        loader.setAttribute('data-open', '');
        setSiblingsInert(true);
        setTimeout(hide, FAILSAFE_DELAY);
        startTime = performance.now();
    }

    function setSiblingsInert(isInert) {
        document.body.querySelectorAll(':scope > footer, :scope > header, :scope > main').forEach((sibling) => {
            sibling.inert = isInert;
        });
    }

    initLoader();
</script>
