---
import { Image } from 'astro:assets';

import logo from '@images/logos/atx_music_video_film_festival.webp';
---

<div
    class="loader fixed flex items-center justify-center"
    aria-hidden="true"
    role="presentation"
>
    <div class="loader__inner flex flex-col items-center">
        <div class="loader__mark grid place-items-center">
            <Image
                class="h-auto w-full"
                alt=""
                densities={[1, 2]}
                fetchpriority="high"
                loading="eager"
                src={logo}
                width={160}
            />
        </div>
        <div class="loader__text select-none">Loading reel &middot; 2026</div>
        <div class="loader__bar relative overflow-hidden"><div class="loader__progress absolute" /></div>
    </div>
</div>

<style>
    .loader {
        background: var(--color-night);
        inset: 0;
        padding: var(--shell-pad);
        transition: opacity var(--duration-slower) ease, visibility var(--duration-slower) ease;
        z-index: 300;
    }

    .loader[data-hidden] {
        opacity: 0;
        pointer-events: none;
        visibility: hidden;
    }

    .loader__bar {
        background: var(--color-cream-15);
        height: 2px;
        max-width: min(400px, 70vw);
        width: 100%;
    }

    .loader__mark {
        animation: loader__pulse 2s ease-in-out infinite;
        height: 160px;
        margin-bottom: 48px;
        width: 160px;
    }

    .loader__progress {
        animation: loader__sweep 1.4s ease-in-out infinite;
        background: var(--color-coral);
        inset: 0;
        width: 30%;
    }

    .loader__text {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 14px;
        letter-spacing: 0.2em;
        margin-bottom: 48px;
        text-transform: uppercase;
    }

    @media (prefers-reduced-motion: reduce) {
        .loader {
            display: none;
        }
    }

    @keyframes loader__pulse {
        0%,
        100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.6;
            transform: scale(1.05);
        }
    }

    @keyframes loader__sweep {
        0% {
            transform: translateX(-100%);
        }

        100% {
            transform: translateX(333%);
        }
    }
</style>

<script is:inline>
    function initLoader() {
        const FLAG = 'mvff-loaded';
        const MIN_DISPLAY = 700;
        const MAX_DISPLAY = 3000;

        const loader = document.querySelector('.loader');

        if (!loader) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (prefersReducedMotion || sessionStorage.getItem(FLAG)) {
            loader.setAttribute('data-hidden', '');
            return;
        }

        const start = performance.now();

        let hidden = false;

        function hide() {
            if (hidden) return;
            hidden = true;

            const elapsed = performance.now() - start;
            const remaining = Math.max(0, MIN_DISPLAY - elapsed);

            setTimeout(function () {
                loader.setAttribute('data-hidden', '');
                try {
                    sessionStorage.setItem(FLAG, '1');
                } catch {
                    return;
                }
            }, remaining);
        }

        if (document.readyState === 'complete') {
            hide();
        } else {
            window.addEventListener('load', hide, { once: true });
        }

        window.addEventListener('pageshow', function (event) {
            if (event.persisted) hide();
        });

        setTimeout(hide, MAX_DISPLAY);
    }

    document.addEventListener('astro:after-swap', function () {
        document.querySelector('.loader')?.setAttribute('data-hidden', '');
    });

    initLoader();
</script>
