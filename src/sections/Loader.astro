---
import { Image } from 'astro:assets';

import logo from '@images/logos/atx_music_video_film_festival.webp';
---

<div
    class="loader fixed flex items-center justify-center"
    aria-hidden="true"
>
    <div class="loader__inner text-center">
        <div class="loader__mark">
            <Image
                class="h-auto w-full"
                alt=""
                densities={[1, 2]}
                fetchpriority="high"
                loading="eager"
                src={logo}
                width={90}
            />
        </div>
        <div class="loader__text">Loading reel &middot; 2026</div>
        <div class="loader__bar"><div class="loader__progress" /></div>
    </div>
</div>

<style>
    .loader {
        background: var(--color-night);
        inset: 0;
        transition: opacity var(--duration-slower) ease, visibility var(--duration-slower) ease;
        z-index: 300;
    }

    .loader[data-hidden] {
        opacity: 0;
        visibility: hidden;
    }

    .loader__bar {
        background: var(--color-cream-15);
        height: 1px;
        margin: 0 auto;
        max-width: 60vw;
        overflow: hidden;
        position: relative;
        width: 280px;
    }

    .loader__mark {
        animation: loader__pulse 2s ease-in-out infinite;
        display: grid;
        height: 90px;
        margin: 0 auto 24px;
        place-items: center;
        width: 90px;
    }

    .loader__progress {
        animation: loader__sweep 1.4s ease-in-out infinite;
        background: var(--color-coral);
        bottom: 0;
        left: 0;
        position: absolute;
        top: 0;
        width: 30%;
    }

    .loader__text {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.3em;
        margin-bottom: 24px;
        text-transform: uppercase;
    }

    @media (prefers-reduced-motion: reduce) {
        .loader {
            display: none;
        }
    }

    @keyframes loader__pulse {
        0%,
        100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.6;
            transform: scale(1.05);
        }
    }

    @keyframes loader__sweep {
        0% {
            left: -30%;
        }

        100% {
            left: 100%;
        }
    }
</style>

<script is:inline>
    function initLoader() {
        const FLAG = 'mvff-loaded';
        const MAX_DISPLAY = 6_000;
        const MIN_DISPLAY = 1_100;

        const loader = document.querySelector('.loader');

        if (!loader) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (prefersReducedMotion || sessionStorage.getItem(FLAG)) {
            loader.setAttribute('data-hidden', '');
            return;
        }

        const start = performance.now();

        let hidden = false;

        function hide() {
            if (hidden) return;
            hidden = true;

            const elapsed = performance.now() - start;
            const remaining = Math.max(0, MIN_DISPLAY - elapsed);

            setTimeout(() => {
                loader.setAttribute('data-hidden', '');
                try {
                    sessionStorage.setItem(FLAG, '1');
                } catch {
                    return;
                }
            }, remaining);
        }

        if (document.readyState === 'complete') {
            hide();
        } else {
            window.addEventListener('load', hide, { once: true });
        }

        window.addEventListener('pageshow', (event) => {
            if (event.persisted) hide();
        });

        document.addEventListener('visibilitychange', () => {
            if (!document.hidden && performance.now() - start > MIN_DISPLAY) hide();
        });

        setTimeout(hide, MAX_DISPLAY);
    }

    document.addEventListener('astro:after-swap', () => {
        document.querySelector('.loader')?.setAttribute('data-hidden', '');
    });

    initLoader();
</script>
