---
import logo from '@images/logos/mvff.webp';
---

<div class="loader fixed flex items-center justify-center" aria-hidden="true">
    <div class="loader__inner text-center">
        <div class="loader__mark">
            <img alt="MVFF" fetchpriority="high" src={logo.src} />
        </div>
        <div class="loader__text">Loading reel · 2026</div>
        <div class="loader__bar"><div class="loader__progress"></div></div>
    </div>
</div>

<style>
    .loader {
        background: var(--color-night);
        inset: 0;
        transition: opacity 0.6s ease, visibility 0.6s ease;
        z-index: 300;
    }

    .loader[data-hidden] {
        opacity: 0;
        visibility: hidden;
    }

    .loader__mark {
        animation: spinpulse 2s ease-in-out infinite;
        display: grid;
        filter: invert(var(--brand-invert, 0));
        height: 90px;
        margin: 0 auto 24px;
        place-items: center;
        width: 90px;
    }

    .loader__mark img {
        width: 100%;
    }

    .loader__text {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
    }

    .loader__bar {
        background: var(--color-cream-15);
        height: 1px;
        margin: 24px auto 0;
        max-width: 60vw;
        overflow: hidden;
        position: relative;
        width: 280px;
    }

    .loader__progress {
        animation: loadbar 1.4s ease-in-out infinite;
        background: var(--color-accent);
        bottom: 0;
        left: 0;
        position: absolute;
        top: 0;
        width: 30%;
    }

    @keyframes loadbar {
        0% {
            left: -30%;
        }
        100% {
            left: 100%;
        }
    }

    @keyframes spinpulse {
        0%,
        100% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: 0.6;
            transform: scale(1.05);
        }
    }

    @media (prefers-reduced-motion: reduce), (hover: none), (pointer: coarse) {
        .loader {
            display: none;
        }
    }
</style>

<script is:inline>
    document.addEventListener('astro:after-swap', function () {
        const el = document.querySelector('.loader');
        if (el) el.setAttribute('data-hidden', '');
    });

    (function () {
        const FLAG = 'mvff-loaded';
        const MAX_DISPLAY = 6_000;
        const MIN_DISPLAY = 1_100;

        const loader = document.querySelector('.loader');

        if (!loader) return;

        const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (reducedMotion || sessionStorage.getItem(FLAG)) {
            loader.setAttribute('data-hidden', '');
            return;
        }

        const start = performance.now();
        let hidden = false;

        function hide() {
            if (hidden) return;
            hidden = true;

            const elapsed = performance.now() - start;
            const remaining = Math.max(0, MIN_DISPLAY - elapsed);

            setTimeout(function () {
                loader.setAttribute('data-hidden', '');
                try {
                    sessionStorage.setItem(FLAG, '1');
                } catch {
                    return;
                }
            }, remaining);
        }

        if (document.readyState === 'complete') {
            hide();
        } else {
            window.addEventListener('load', hide, { once: true });
        }

        window.addEventListener('pageshow', function (e) {
            if (e.persisted) hide();
        });

        document.addEventListener('visibilitychange', function () {
            if (!document.hidden && performance.now() - start > MIN_DISPLAY) hide();
        });

        setTimeout(hide, MAX_DISPLAY);
    })();
</script>
