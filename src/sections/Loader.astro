---
import { Image } from 'astro:assets';

import logo from '@images/logos/austin_music_video_film_festival.webp';
import { LOADER_SHOWN_KEY } from '@lib/constants';
---

<div
    class="loader fixed flex inset-0 items-center justify-center z-300 bg-night"
    aria-hidden="true"
>
    <div class="loader__inner flex flex-col items-center">
        <div class="loader__logo grid place-items-center">
            <Image
                class="h-auto w-full"
                alt=""
                densities={[1, 2]}
                fetchpriority="high"
                loading="eager"
                src={logo}
                width={160}
            />
        </div>
        <p class="loader__text font-mono uppercase text-cream-60 select-none">Loading reel</p>
        <div class="loader__bar overflow-hidden relative h-0.5 w-full bg-cream-15"><div class="loader__progress absolute inset-0 bg-coral" /></div>
    </div>
</div>

<style>
    .loader {
        padding: var(--shell-pad);
        transition:
            opacity var(--duration-slower) ease,
            visibility 0s;
    }

    .loader[data-hidden] {
        opacity: 0;
        pointer-events: none;
        transition:
            opacity var(--duration-slower) ease,
            visibility 0s var(--duration-slower);
        visibility: hidden;
    }

    .loader__inner {
        gap: clamp(32px, calc(26.67px + 1.67vw), 48px);
    }

    .loader__logo {
        animation: loader__pulse var(--duration-pulse) ease-in-out infinite;
        height: clamp(120px, calc(106.67px + 4.17vw), 160px);
        width: clamp(120px, calc(106.67px + 4.17vw), 160px);
    }

    .loader__progress {
        --loader-sweep-travel: 333%;
        --loader-sweep-width: 30%;
        animation: loader__sweep var(--duration-sweep) ease-in-out infinite;
        width: var(--loader-sweep-width);
    }

    .loader__text {
        font-size: 12px;
        letter-spacing: 0.16em;
    }

    @media (prefers-reduced-motion: reduce) {
        .loader {
            display: none;
        }
    }

    @keyframes loader__pulse {
        0%,
        100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.85;
            transform: scale(1.05);
        }
    }

    @keyframes loader__sweep {
        0% {
            transform: translateX(-100%);
        }

        100% {
            transform: translateX(var(--loader-sweep-travel));
        }
    }
</style>

<script
    define:vars={{ loaderShownKey: LOADER_SHOWN_KEY }}
    is:inline
>
    function initLoader() {
        const MIN_DISPLAY_DURATION = 300;

        const loader = document.querySelector('.loader');

        if (!loader) return;

        function handleLoaderKeydown(event) {
            if (event.key === 'Tab') event.preventDefault();
        }

        document.addEventListener('keydown', handleLoaderKeydown);

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        let hasShownLoader;

        try {
            hasShownLoader = Boolean(sessionStorage.getItem(loaderShownKey));
        } catch {
            hasShownLoader = false;
        }

        if (hasShownLoader || prefersReducedMotion) {
            loader.setAttribute('data-hidden', '');

            document.removeEventListener('keydown', handleLoaderKeydown);

            return;
        }

        const startTime = performance.now();

        let isHidden = false;

        function hide() {
            if (isHidden) return;

            isHidden = true;

            const elapsed = performance.now() - startTime;

            const remaining = Math.max(0, MIN_DISPLAY_DURATION - elapsed);

            setTimeout(() => {
                loader.setAttribute('data-hidden', '');

                document.removeEventListener('keydown', handleLoaderKeydown);

                try {
                    sessionStorage.setItem(loaderShownKey, '1');
                } catch {
                    return;
                }
            }, remaining);
        }

        if (document.readyState === 'complete') {
            hide();
        } else {
            window.addEventListener('load', hide, { once: true });
        }

        window.addEventListener('pageshow', (event) => {
            if (event.persisted) hide();
        });
    }

    document.addEventListener('astro:after-swap', () => {
        document.querySelector('.loader')?.setAttribute('data-hidden', '');
    });

    initLoader();
</script>
