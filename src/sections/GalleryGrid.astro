---
import { Image, getImage } from 'astro:assets';

import SectionHead from '@components/SectionHead.astro';
import teamSeated from '@images/gallery/team_seated.webp';
import teamStanding from '@images/gallery/team_standing.webp';
import { pad } from '@lib/utils';

const PALETTE = [
    ['#1f1424', '#5b2a4c'], ['#0e1d2c', '#2a4a6b'], ['#2a1a0e', '#7a3f1c'],
    ['#1a2614', '#3f6b2a'], ['#241a2a', '#5c3a8a'], ['#0e0e1a', '#3a3a6e'],
    ['#2c1414', '#7a2a2a'], ['#1c2424', '#4a6e6e'], ['#241c0e', '#8a6a2a'],
    ['#14242c', '#2a6a8a'], ['#2a2414', '#8a7a3a'], ['#1c1424', '#5a3a7a'],
    ['#0e1c14', '#2a8a4a'], ['#241414', '#8a4a4a'], ['#14241c', '#2a8a6a'],
] as const;

const PHOTOS = new Map([
    [0, { caption: 'The 2026 festival team, suited up in studio.', image: teamStanding, title: 'The 2026 Team' }],
    [7, { caption: 'The crew settles in ahead of the 2026 season.', image: teamSeated, title: 'Crew Portrait' }],
]);

const WIDE_INDICES = [0, 7, 11, 13, 14] as const;

const items = await Promise.all(PALETTE.map(async (gradient, index) => {
    const photo = PHOTOS.get(index);

    const fullImage = photo
        ? await getImage({ src: photo.image, width: 1600 })
        : undefined;

    return {
        background: fullImage
            ? `url('${fullImage.src}') center / cover no-repeat`
            : `linear-gradient(135deg, ${gradient[0]} 0%, ${gradient[1]} 100%)`,
        block: `BLK_${pad(index + 1, 3)}`,
        caption: photo?.caption ?? '',
        image: photo?.image,
        span: WIDE_INDICES.some(wideIndex => wideIndex === index) ? 'wide' : 'normal',
        title: photo?.title ?? `Frame ${pad(index + 1)}`,
        year: '2026',
    };
}));
---

<section
    class="gallery section"
    aria-labelledby="gallery-title"
>
    <div class="shell">
        <SectionHead
            headingId="gallery-title"
            marker="[ G ]"
        >
            Gallery
        </SectionHead>
        <ul
            class="gallery__grid grid list-none"
            data-scroll
            data-scroll-stagger="0.04"
        >
            {items.map(item => (
                <li class:list={['gallery__cell grid', `gallery__cell--${item.span}`]}>
                    <button
                        class="gallery__tile overflow-hidden relative text-left cursor-pointer"
                        aria-label={`View ${item.title}`}
                        data-gallery-background={item.background}
                        data-gallery-block={item.block}
                        data-gallery-caption={item.caption}
                        data-gallery-title={item.title}
                        data-gallery-year={item.year}
                        type="button"
                    >
                        {item.image
                            ? (
                                    <Image
                                        class="gallery__tile-image object-cover"
                                        alt=""
                                        densities={[1, 2]}
                                        loading="lazy"
                                        src={item.image}
                                        width={720}
                                    />
                                )
                            : (
                                    <span
                                        class="gallery__tile-image"
                                        style={`background: ${item.background};`}
                                    />
                                )}
                        <span class="gallery__tile-meta absolute flex justify-between select-none">
                            <span>{item.title}</span>
                            <span>{item.block}</span>
                        </span>
                    </button>
                </li>
            ))}
        </ul>
    </div>
    <div
        class="lightbox fixed"
        aria-describedby="lightbox-caption"
        aria-hidden="true"
        aria-labelledby="lightbox-title"
        aria-modal="true"
        role="dialog"
    >
        <div class="lightbox__inner grid relative cursor-default">
            <button
                class="lightbox__close absolute cursor-pointer"
                aria-label="Close lightbox"
                type="button"
            >
                &times;
            </button>
            <div class="lightbox__image" />
            <div class="lightbox__info flex flex-col gap-3 text-cream">
                <div class="lightbox__meta lightbox__meta--dynamic" />
                <h2
                    id="lightbox-title"
                    aria-hidden="true"
                >
                    &nbsp;
                </h2>
                <p
                    id="lightbox-caption"
                    class="lightbox__caption"
                >
                    Gallery content coming soon.
                </p>
                <div class="lightbox__meta">Shot by Austin Music Video Film Festival Media Team</div>
            </div>
        </div>
    </div>
</section>

<style>
    .gallery__cell--normal {
        grid-column: span 3;
        grid-row: span 3;
    }

    .gallery__cell--wide {
        grid-column: span 6;
        grid-row: span 3;
    }

    .gallery__grid {
        gap: 12px;
        grid-auto-flow: dense;
        grid-auto-rows: 80px;
        grid-template-columns: repeat(12, 1fr);
    }

    .gallery__tile {
        background: var(--color-navy);
        border: 1px solid var(--color-cream-15);
        color: inherit;
        font: inherit;
        padding: 0;
        transition: transform var(--duration-base) ease;
    }

    .gallery__tile:active {
        transform: scale(1);
    }

    .gallery__tile:hover {
        transform: scale(1.02);
        z-index: 2;
    }

    .gallery__tile:hover .gallery__tile-image {
        filter: grayscale(0) contrast(1.1);
    }

    .gallery__tile:hover .gallery__tile-meta {
        opacity: 1;
    }

    .gallery__tile-image {
        background-position: center;
        background-size: cover;
        filter: grayscale(0.5) contrast(1.05);
        inset: 0;
        position: absolute;
        transition: filter var(--duration-slow) ease;
    }

    .gallery__tile-meta {
        background: linear-gradient(transparent, var(--color-black-85));
        bottom: 0;
        color: var(--color-cream);
        font-family: var(--font-mono);
        font-size: 10px;
        left: 0;
        letter-spacing: 0.14em;
        opacity: 0;
        padding: 12px 16px;
        right: 0;
        transition: opacity var(--duration-fast) ease;
    }

    .lightbox {
        animation: lightbox__fade-in var(--duration-fast) ease;
        backdrop-filter: blur(8px);
        background: var(--color-black-95);
        cursor: zoom-out;
        display: none;
        inset: 0;
        padding: clamp(24px, calc(10.67px + 4.17vw), 64px);
        place-items: center;
        z-index: 200;
    }

    .lightbox[data-active] {
        display: grid;
    }

    .lightbox__close {
        background: none;
        border: 1px solid var(--color-cream);
        color: var(--color-cream);
        font-family: var(--font-mono);
        height: 32px;
        right: 0;
        top: -40px;
        transition:
            border-color var(--duration-fast) ease,
            color var(--duration-fast) ease;
        width: 32px;
    }

    .lightbox__close:active,
    .lightbox__close:hover {
        border-color: var(--color-coral);
        color: var(--color-coral);
    }

    .lightbox__close::after {
        content: '';
        inset: -8px;
        position: absolute;
    }

    .lightbox__image {
        aspect-ratio: 3 / 2;
        background-position: center;
        background-size: cover;
        border: 1px solid var(--color-cream-15);
    }

    .lightbox__info h2 {
        font-size: clamp(24px, calc(20px + 1.25vw), 36px);
    }

    .lightbox__info p {
        color: var(--color-cream-60);
        flex: 1;
        font-family: var(--font-serif);
        font-size: 16px;
        line-height: 1.5;
    }

    .lightbox__inner {
        gap: 32px;
        grid-template-columns: 1fr 280px;
        max-width: 1100px;
        width: 100%;
    }

    .lightbox__meta {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    @media (max-width: 768px) {
        .gallery__cell--normal {
            grid-column: span 2;
            grid-row: span 2;
        }

        .gallery__cell--wide {
            grid-column: span 4;
            grid-row: span 2;
        }

        .gallery__grid {
            grid-auto-rows: 52px;
            grid-template-columns: repeat(4, 1fr);
        }

        .lightbox__inner {
            grid-template-columns: 1fr;
        }
    }

    @keyframes lightbox__fade-in {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }
</style>

<script>
    let galleryController: AbortController | undefined;
    let lastTile: HTMLElement | undefined;
    let lightbox: HTMLElement | null = null;

    function closeLightbox() {
        if (!lightbox?.hasAttribute('data-active')) return;

        lightbox.removeAttribute('data-active');
        lightbox.setAttribute('aria-hidden', 'true');
        lastTile?.focus();
        lastTile = undefined;
    }

    function handleLightboxKeydown(event: KeyboardEvent) {
        if (event.key === 'Escape') {
            closeLightbox();
        } else if (event.key === 'Tab' && lightbox?.hasAttribute('data-active')) {
            event.preventDefault();
            lightbox.querySelector<HTMLElement>('.lightbox__close')?.focus();
        }
    }

    function initGallery() {
        galleryController?.abort();
        galleryController = new AbortController();
        lightbox = document.querySelector<HTMLElement>('.lightbox');

        const { signal } = galleryController;

        document.querySelectorAll<HTMLElement>('.gallery__tile').forEach((tile) => {
            tile.addEventListener('click', () => openLightbox(tile), { signal });
        });

        const close = lightbox?.querySelector('.lightbox__close');
        const inner = lightbox?.querySelector('.lightbox__inner');

        close?.addEventListener('click', closeLightbox, { signal });
        inner?.addEventListener('click', event => event.stopPropagation(), { signal });
        lightbox?.addEventListener('click', closeLightbox, { signal });
        document.addEventListener('keydown', handleLightboxKeydown, { signal });
    }

    function openLightbox(tile: HTMLElement) {
        if (!lightbox) return;

        const caption = lightbox.querySelector('.lightbox__caption');
        const image = lightbox.querySelector<HTMLElement>('.lightbox__image');
        const meta = lightbox.querySelector('.lightbox__meta--dynamic');
        const title = lightbox.querySelector<HTMLElement>('#lightbox-title');

        if (!caption || !image || !meta || !title) return;

        caption.textContent = tile.dataset.galleryCaption || 'Gallery content coming soon.';
        image.style.background = tile.dataset.galleryBackground || '';
        title.textContent = tile.dataset.galleryTitle || '';
        title.removeAttribute('aria-hidden');
        meta.textContent = `${tile.dataset.galleryBlock} \u00b7 ${tile.dataset.galleryYear}`;
        lastTile = tile;
        lightbox.setAttribute('data-active', '');
        lightbox.setAttribute('aria-hidden', 'false');
        lightbox.querySelector<HTMLElement>('.lightbox__close')?.focus();
    }

    document.addEventListener('astro:page-load', initGallery);
</script>
