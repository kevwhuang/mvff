---
import { Image, getImage } from 'astro:assets';

import SectionHead from '@components/SectionHead.astro';
import teamSeated from '@images/gallery/team_seated.webp';
import teamStanding from '@images/gallery/team_standing.webp';

const FIGURES = [
    {
        alt: 'The 2026 Austin Music Video Film Festival team posed together in a studio, standing shoulder to shoulder in mostly black outfits against a soft grey backdrop.',
        image: teamStanding,
        label: 'The Team, Standing',
        variant: 'lead',
        width: 880,
        year: '2026',
    },
    {
        alt: 'Members of the 2026 Austin Music Video Film Festival team gathered close to the studio floor, seated and leaning together for a relaxed group portrait.',
        image: teamSeated,
        label: 'The Team, Seated',
        variant: 'trail',
        width: 700,
        year: '2026',
    },
] as const;

const [lead, trail] = await Promise.all(FIGURES.map(async (figure) => {
    const rendered = await getImage({ src: figure.image, width: 1600 });

    return { ...figure, source: rendered.src };
}));
---

<section
    class="gallery section"
    aria-labelledby="gallery-title"
>
    <div class="shell">
        <SectionHead
            headingId="gallery-title"
            marker="[ G ]"
        >
            Gallery
        </SectionHead>
        <div
            class="gallery__composition grid"
            data-scroll
            data-scroll-stagger="0.14"
        >
            <figure class:list={['gallery__figure', `gallery__figure--${lead.variant}`, 'flex flex-col gap-3']}>
                <button
                    class="gallery__frame block overflow-hidden relative w-full cursor-pointer"
                    aria-label={`View ${lead.label}`}
                    data-gallery-label={lead.alt}
                    data-gallery-source={lead.source}
                    type="button"
                >
                    <Image
                        class="gallery__image object-cover"
                        alt={lead.alt}
                        densities={[1, 2]}
                        loading="lazy"
                        src={lead.image}
                        width={lead.width}
                    />
                </button>
                <figcaption class="gallery__meta flex justify-between select-none">
                    <span>{lead.label}</span>
                    <span class="gallery__year">{lead.year}</span>
                </figcaption>
            </figure>
            <div class="gallery__aside flex flex-col justify-between">
                <p class="gallery__note">Full event photography lands after July 18.</p>
                <figure class:list={['gallery__figure', `gallery__figure--${trail.variant}`, 'flex flex-col gap-3']}>
                    <button
                        class="gallery__frame block overflow-hidden relative w-full cursor-pointer"
                        aria-label={`View ${trail.label}`}
                        data-gallery-label={trail.alt}
                        data-gallery-source={trail.source}
                        type="button"
                    >
                        <Image
                            class="gallery__image object-cover"
                            alt={trail.alt}
                            densities={[1, 2]}
                            loading="lazy"
                            src={trail.image}
                            width={trail.width}
                        />
                    </button>
                    <figcaption class="gallery__meta flex justify-between select-none">
                        <span>{trail.label}</span>
                        <span class="gallery__year">{trail.year}</span>
                    </figcaption>
                </figure>
            </div>
        </div>
    </div>
    <div
        class="lightbox fixed"
        aria-hidden="true"
        aria-labelledby="lightbox-title"
        aria-modal="true"
        role="dialog"
    >
        <div class="lightbox__inner relative cursor-default">
            <button
                class="lightbox__close absolute cursor-pointer"
                aria-label="Close image"
                type="button"
            >
                &times;
            </button>
            <h2
                id="lightbox-title"
                class="sr-only"
            >
                &nbsp;
            </h2>
            <div class="lightbox__image" />
        </div>
    </div>
</section>

<style>
    .gallery__aside {
        gap: clamp(24px, calc(13.33px + 3.33vw), 56px);
    }

    .gallery__composition {
        column-gap: clamp(24px, calc(5.33px + 5.83vw), 80px);
        grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }

    .gallery__frame {
        aspect-ratio: 3 / 2;
        background: var(--color-navy);
        border: 1px solid var(--color-cream-15);
        color: inherit;
        font: inherit;
        padding: 0;
        transition: transform var(--duration-base) ease;
    }

    .gallery__frame:active {
        transform: scale(1);
    }

    .gallery__frame:hover {
        transform: scale(1.01);
    }

    .gallery__frame:hover .gallery__image {
        filter: grayscale(0) contrast(1.08);
        transform: scale(1.03);
    }

    .gallery__frame:hover::after {
        border-color: var(--color-coral);
    }

    .gallery__frame::after {
        border: 1px solid var(--color-cream-15);
        content: '';
        inset: 10px;
        pointer-events: none;
        position: absolute;
        transition: border-color var(--duration-base) ease;
    }

    .gallery__image {
        filter: grayscale(0.45) contrast(1.05);
        height: 100%;
        transition:
            filter var(--duration-slow) ease,
            transform var(--duration-slower) ease;
        width: 100%;
    }

    .gallery__meta {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .gallery__note {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.16em;
        text-align: right;
        text-transform: uppercase;
    }

    .gallery__year {
        color: var(--color-coral);
    }

    .lightbox {
        animation: lightbox__fade-in var(--duration-fast) ease;
        backdrop-filter: blur(8px);
        background: var(--color-black-95);
        cursor: zoom-out;
        display: none;
        inset: 0;
        padding: clamp(24px, calc(10.67px + 4.17vw), 64px);
        place-items: center;
        z-index: 200;
    }

    .lightbox[data-active] {
        display: grid;
    }

    .lightbox__close {
        background: none;
        border: 1px solid var(--color-cream);
        color: var(--color-cream);
        font-family: var(--font-mono);
        height: 32px;
        right: 0;
        top: -40px;
        transition:
            border-color var(--duration-fast) ease,
            color var(--duration-fast) ease;
        width: 32px;
    }

    .lightbox__close:active,
    .lightbox__close:hover {
        border-color: var(--color-coral);
        color: var(--color-coral);
    }

    .lightbox__close::after {
        content: '';
        inset: -8px;
        position: absolute;
    }

    .lightbox__image {
        aspect-ratio: 3 / 2;
        background-position: center;
        background-size: cover;
        border: 1px solid var(--color-cream-15);
        width: 100%;
    }

    .lightbox__inner {
        max-width: 1100px;
        width: 100%;
    }

    @media (max-width: 1024px) {
        .gallery__composition {
            column-gap: clamp(16px, calc(5.33px + 3.33vw), 48px);
            grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
        }
    }

    @media (max-width: 768px) {
        .gallery__aside {
            justify-content: normal;
        }

        .gallery__composition {
            gap: clamp(24px, calc(16px + 2.5vw), 48px);
            grid-template-columns: minmax(0, 1fr);
        }

        .gallery__note {
            order: 1;
        }
    }

    @keyframes lightbox__fade-in {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }
</style>

<script>
    let galleryController: AbortController | undefined;
    let lastTrigger: HTMLElement | undefined;
    let lightbox: HTMLElement | null = null;

    function closeLightbox() {
        if (!lightbox?.hasAttribute('data-active')) return;

        lightbox.removeAttribute('data-active');
        lightbox.setAttribute('aria-hidden', 'true');
        lastTrigger?.focus();
        lastTrigger = undefined;
    }

    function handleLightboxKeydown(event: KeyboardEvent) {
        if (!lightbox?.hasAttribute('data-active')) return;

        if (event.key === 'Escape') {
            closeLightbox();
        } else if (event.key === 'Tab') {
            event.preventDefault();
            lightbox.querySelector<HTMLElement>('.lightbox__close')?.focus();
        }
    }

    function initGallery() {
        galleryController?.abort();
        galleryController = new AbortController();
        lightbox = document.querySelector<HTMLElement>('.lightbox');

        if (!lightbox) return;

        const { signal } = galleryController;
        const closeButton = lightbox.querySelector('.lightbox__close');
        const inner = lightbox.querySelector('.lightbox__inner');

        document.querySelectorAll<HTMLElement>('.gallery__frame').forEach((frame) => {
            frame.addEventListener('click', () => openLightbox(frame), { signal });
        });

        closeButton?.addEventListener('click', closeLightbox, { signal });
        inner?.addEventListener('click', event => event.stopPropagation(), { signal });
        lightbox.addEventListener('click', closeLightbox, { signal });
        document.addEventListener('keydown', handleLightboxKeydown, { signal });
    }

    function openLightbox(frame: HTMLElement) {
        if (!lightbox) return;

        const image = lightbox.querySelector<HTMLElement>('.lightbox__image');
        const title = lightbox.querySelector<HTMLElement>('#lightbox-title');

        if (!image || !title) return;

        image.style.backgroundImage = `url('${frame.dataset.gallerySource}')`;
        title.textContent = frame.dataset.galleryLabel || '';
        lastTrigger = frame;
        lightbox.setAttribute('data-active', '');
        lightbox.setAttribute('aria-hidden', 'false');
        lightbox.querySelector<HTMLElement>('.lightbox__close')?.focus();
    }

    document.addEventListener('astro:page-load', initGallery);
</script>
