---
import SectionHead from '@components/SectionHead.astro';
---

<section
    class="details section"
    aria-labelledby="details-title"
>
    <div class="shell">
        <SectionHead
            headingId="details-title"
            level="h2"
            number="[ 01 ]"
        >
            The Coordinates
            <Fragment slot="meta">CABANA CLUB / AUSTIN TX<br />SAT &middot; JUL 18 &middot; 2026</Fragment>
        </SectionHead>
        <dl
            class="details__grid"
            data-scroll
            data-scroll-stagger="0.12"
        >
            <div class="details__cell">
                <dt class="details__label">Venue</dt>
                <dd class="details__value">Cabana Club</dd>
                <dd class="details__note">Indoor screening room, outdoor pool, full bar.</dd>
            </div>
            <div class="details__cell">
                <dt class="details__label">Date</dt>
                <dd class="details__value"><time datetime="2026-07-18">July 18</time></dd>
                <dd class="details__note">Saturday night, 2026.</dd>
            </div>
            <div class="details__cell">
                <dt class="details__label">Time</dt>
                <dd class="details__value">7 PM &rarr; 2 AM</dd>
                <dd class="details__note">Seven hours, twelve acts.</dd>
            </div>
        </dl>
    </div>
</section>

<style>
    .details__cell {
        border-right: 1px solid var(--color-cream-15);
        cursor: default;
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: clamp(28px, 4vw, 48px);
        position: relative;
        transition: background var(--duration-fast) ease;
    }

    .details__cell:hover {
        background: var(--color-slate);
    }

    .details__cell:last-child {
        border-right: none;
    }

    .details__grid {
        background: var(--color-navy);
        border: 1px solid var(--color-cream-15);
        display: grid;
        grid-template-columns: repeat(3, 1fr);
    }

    .details__label {
        color: var(--color-coral);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
    }

    .details__note {
        color: var(--color-cream-60);
        font-family: var(--font-serif);
        font-size: 16px;
        font-style: italic;
    }

    .details__value {
        font-family: var(--font-display);
        font-size: clamp(30px, 3.75vw, 48px);
        line-height: 1;
        margin-bottom: 4px;
        white-space: nowrap;
    }

    @media (max-width: 768px) {
        .details__cell {
            border-bottom: 1px solid var(--color-cream-15);
            border-right: none;
        }

        .details__cell:last-child {
            border-bottom: none;
        }

        .details__grid {
            grid-template-columns: 1fr;
        }
    }
</style>
