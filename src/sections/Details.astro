---

<section class="section" aria-labelledby="details-heading">
    <div class="shell">
        <div class="section-head">
            <span class="section-num">[ 01 ]</span>
            <h2 id="details-heading" class="section-title">The Coordinates</h2>
            <span class="section-meta">CABANA CLUB / ATX<br />SAT · JUL 18 · 2026</span>
        </div>
        <div class="details__grid">
            <div class="details__cell">
                <span class="details__lbl">Venue</span>
                <span class="details__val">Cabana Club</span>
                <span class="details__ext">Indoor screening room, outdoor pool, full bar.</span>
            </div>
            <div class="details__cell">
                <span class="details__lbl">Date</span>
                <span class="details__val">July 18</span>
                <span class="details__ext">Saturday night, 2026.</span>
            </div>
            <div class="details__cell">
                <span class="details__lbl">Time</span>
                <span class="details__val">7 PM → 2 AM</span>
                <span class="details__ext">Seven hours, twelve acts.</span>
            </div>
        </div>
    </div>
</section>

<style>
    .details__grid {
        background: var(--ink-2);
        border: 1px solid var(--line);
        display: grid;
        gap: 0;
        grid-template-columns: repeat(3, 1fr);
    }

    .details__cell {
        border-right: 1px solid var(--line);
        cursor: default;
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: clamp(28px, 4vw, 48px);
        position: relative;
        transition: background 200ms ease;
    }

    .details__cell:last-child {
        border-right: none;
    }

    .details__cell:hover {
        background: var(--ink-3);
    }

    .details__lbl {
        color: var(--accent);
        font-family: var(--ff-mono);
        font-size: 10px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
    }

    .details__val {
        font-family: var(--ff-display);
        font-size: clamp(30px, 3.6vw, 48px);
        line-height: 1;
        white-space: nowrap;
    }

    .details__ext {
        color: var(--paper-dim);
        font-family: var(--ff-serif);
        font-size: 16px;
        font-style: italic;
        margin-top: 4px;
    }

    @media (max-width: 720px) {
        .details__grid {
            grid-template-columns: 1fr;
        }

        .details__cell {
            border-bottom: 1px solid var(--line);
            border-right: none;
        }

        .details__cell:last-child {
            border-bottom: none;
        }
    }
</style>
