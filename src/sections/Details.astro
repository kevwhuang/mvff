---
import SectionHead from '@components/SectionHead.astro';
---

<section
    class="details section"
    aria-labelledby="details-title"
>
    <div class="shell">
        <SectionHead
            headingId="details-title"
            level="h2"
            marker="[ 01 ]"
        >
            The Coordinates
        </SectionHead>
        <dl
            class="details__grid grid grid-cols-3 border border-cream-15 bg-navy"
            data-scroll
            data-scroll-stagger="0.12"
        >
            <div class="details__cell flex flex-col relative gap-3 cursor-default">
                <dt class="details__label select-none">Venue</dt>
                <dd class="details__value">Cabana Club</dd>
                <dd class="details__note font-serif italic text-base text-cream-60">11703 Manchaca Rd, Austin, TX</dd>
            </div>
            <div class="details__cell flex flex-col relative gap-3 cursor-default">
                <dt class="details__label select-none">Date</dt>
                <dd class="details__value"><time datetime="2026-07-18">July 18</time></dd>
                <dd class="details__note font-serif italic text-base text-cream-60">Saturday night, 2026.</dd>
            </div>
            <div class="details__cell flex flex-col relative gap-3 cursor-default">
                <dt class="details__label select-none">Time</dt>
                <dd class="details__value">7 PM &ndash; 2 AM</dd>
                <dd class="details__note font-serif italic text-base text-cream-60">Seven hours, twelve acts.</dd>
            </div>
        </dl>
    </div>
</section>

<style>
    .details__cell {
        border-right: 1px solid var(--color-cream-15);
        padding: clamp(32px, calc(26.67px + 1.67vw), 48px);
        transition: background var(--duration-fast) ease;
    }

    .details__cell:hover {
        background: var(--color-slate);
    }

    .details__cell:last-child {
        border-right: none;
    }

    .details__label {
        color: var(--color-coral);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
    }

    .details__value {
        font-family: var(--font-display);
        font-size: clamp(30px, calc(24px + 1.88vw), 48px);
        line-height: 1;
        margin-bottom: 4px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    @media (max-width: 768px) {
        .details__cell {
            border-bottom: 1px solid var(--color-cream-15);
            border-right: none;
        }

        .details__cell:last-child {
            border-bottom: none;
        }

        .details__grid {
            grid-template-columns: 1fr;
        }
    }
</style>
