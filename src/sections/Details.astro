---
import SectionHeader from '@components/SectionHeader.astro';
---

<section
    class="details section"
    aria-labelledby="details-title"
>
    <div class="shell">
        <SectionHeader
            headingId="details-title"
            level="h2"
            marker="[ 01 ]"
        >
            The Coordinates
        </SectionHeader>
        <dl
            class="details__grid grid grid-cols-3 border border-cream-15 bg-navy"
            data-scroll
            data-scroll-stagger="0.12"
        >
            <div class="details__cell sweep flex flex-col relative isolate gap-2 border-cream-15 border-r">
                <dt class="details__label font-mono uppercase text-cream-60">Date</dt>
                <dd class="details__value font-display leading-none truncate"><time datetime="2026-07-18">July 18, 2026</time></dd>
            </div>
            <div class="details__cell sweep flex flex-col relative isolate gap-2 border-cream-15 border-r">
                <dt class="details__label font-mono uppercase text-cream-60">Time</dt>
                <dd class="details__value font-display leading-none truncate"><time datetime="2026-07-18T19:00-05:00">7 PM</time>&nbsp;&ndash;&nbsp;<time datetime="2026-07-19T02:00-05:00">2 AM</time></dd>
            </div>
            <div class="details__cell sweep flex flex-col relative isolate gap-2 border-cream-15 border-r">
                <dt class="details__label font-mono uppercase text-cream-60">Venue</dt>
                <dd class="details__value font-display leading-none truncate">Cabana Club</dd>
            </div>
        </dl>
    </div>
</section>

<style>
    .details__cell {
        padding: clamp(32px, calc(26.67px + 1.67vw), 48px);
    }

    .details__cell:hover .details__value {
        color: var(--color-coral);
    }

    .details__cell:hover::after {
        opacity: 0.5;
    }

    .details__cell:last-child {
        border-right: none;
    }

    .details__label {
        font-size: 10px;
        letter-spacing: 0.2em;
    }

    .details__value {
        font-size: clamp(28px, calc(21.33px + 2.08vw), 48px);
        transition: color var(--duration-fast) ease;
    }

    @media (max-width: 1024px) {
        .details__cell {
            border-bottom: 1px solid var(--color-cream-15);
            border-right: none;
        }

        .details__cell:last-child {
            border-bottom: none;
        }

        .details__grid {
            grid-template-columns: 1fr;
        }
    }
</style>
