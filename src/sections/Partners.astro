---
import { Image } from 'astro:assets';

import logoCabanaClub from '@images/logos/cabana_club.webp';
import logoMadewellProductions from '@images/logos/madewell_productions.webp';

const MARQUEE_COPIES = 6;
---

<section
    class="partners section border-cream-15 border-y bg-navy select-none"
    aria-label="Partners"
    data-scroll
>
    <div class="partners__viewport overflow-x-clip">
        <ul
            class="partners__track flex items-center w-max list-none"
            style={`--partners-copies: ${MARQUEE_COPIES}`}
        >
            {Array.from({ length: MARQUEE_COPIES }).map((_, copyIndex) => (
                <Fragment>
                    <li
                        class="partners__item flex items-center font-display leading-none uppercase whitespace-nowrap text-cream"
                        aria-hidden={copyIndex > 0 ? 'true' : undefined}
                    >
                        <Image
                            class="partners__logo partners__logo--madewell object-contain w-auto align-middle"
                            alt=""
                            aria-hidden="true"
                            densities={[1, 2]}
                            src={logoMadewellProductions}
                            width={99}
                        />
                        <span>Madewell Productions</span>
                    </li>
                    <li
                        class="partners__item flex items-center font-display leading-none uppercase whitespace-nowrap text-cream"
                        aria-hidden={copyIndex > 0 ? 'true' : undefined}
                    >
                        <Image
                            class="partners__logo object-contain w-auto align-middle"
                            alt="Cabana Club"
                            densities={[1, 2]}
                            src={logoCabanaClub}
                            width={375}
                        />
                    </li>
                </Fragment>
            ))}
        </ul>
    </div>
</section>

<style>
    .partners {
        margin-bottom: var(--section-padding);
        padding-block: var(--section-padding-sm);
    }

    .partners__item {
        font-size: var(--partners-gap);
        gap: var(--partners-gap);
        letter-spacing: 0.04em;
    }

    .partners__item span {
        transform: translateY(0.08em);
    }

    .partners__item::after {
        background: var(--color-coral);
        content: '';
        flex-shrink: 0;
        height: 14px;
        transform: translateY(0.08em) rotate(45deg);
        width: 14px;
    }

    .partners__logo {
        filter: brightness(0) invert(0.82) sepia(0.16);
        height: clamp(40px, calc(30px + 3.125vw), 70px);
    }

    .partners__logo--madewell {
        filter: invert(0.82) sepia(0.16);
    }

    .partners__track {
        --partners-gap: clamp(40px, calc(26.67px + 4.17vw), 80px);
        animation: partners__scroll var(--duration-marquee) linear infinite;
        gap: var(--partners-gap);
    }

    @media (prefers-reduced-motion: reduce) {
        .partners__item {
            white-space: normal;
        }

        .partners__item::after {
            content: none;
        }

        .partners__track {
            animation: none;
            flex-wrap: wrap;
            justify-content: center;
            width: auto;
        }

        .partners__track li:nth-child(n + 3) {
            display: none;
        }
    }

    @keyframes partners__scroll {
        to {
            transform: translateX(calc((-100% - var(--partners-gap)) / var(--partners-copies)));
        }
    }
</style>
