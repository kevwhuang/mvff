---
import { Image } from 'astro:assets';

import logoCabanaClub from '@images/logos/cabana_club.webp';
import logoMadewellProductions from '@images/logos/madewell_productions.webp';

const MARQUEE_COPIES = 2;
---

<section
    class="partners section border-y border-cream-15 bg-navy select-none"
    aria-label="Partners"
    data-scroll
>
    <div class="partners__viewport overflow-x-clip">
        <ul class="partners__track flex items-center w-max list-none">
            {Array.from({ length: MARQUEE_COPIES }).flatMap((_, copy) => [
                <li
                    class="partners__item flex items-center font-display leading-none uppercase whitespace-nowrap text-cream-80"
                    aria-hidden={copy > 0 ? 'true' : undefined}
                >
                    <Image
                        class="partners__logo partners__logo--madewell object-contain w-auto align-middle opacity-75"
                        alt=""
                        aria-hidden="true"
                        densities={[1, 2]}
                        src={logoMadewellProductions}
                        width={99}
                    />
                    <span>Madewell Productions</span>
                </li>,
                <li
                    class="partners__item flex items-center font-display leading-none uppercase text-cream-80"
                    aria-hidden="true"
                >
                    <span class="partners__diamond inline-block shrink-0 aspect-square w-3.5 bg-coral rotate-45" />
                </li>,
                <li
                    class="partners__item flex items-center font-display leading-none uppercase whitespace-nowrap text-cream-80"
                    aria-hidden={copy > 0 ? 'true' : undefined}
                >
                    <Image
                        class="partners__logo object-contain w-auto align-middle opacity-75"
                        alt="Cabana Club"
                        densities={[1, 2]}
                        src={logoCabanaClub}
                        width={375}
                    />
                </li>,
                <li
                    class="partners__item flex items-center font-display leading-none uppercase text-cream-80"
                    aria-hidden="true"
                >
                    <span class="partners__diamond inline-block shrink-0 aspect-square w-3.5 bg-coral rotate-45" />
                </li>,
            ])}
        </ul>
    </div>
</section>

<style>
    .partners {
        margin-bottom: var(--section-padding);
        padding-block: var(--section-padding-sm);
    }

    .partners__item {
        font-size: clamp(40px, calc(26.67px + 4.17vw), 80px);
        gap: var(--partners-gap);
        letter-spacing: 0.04em;
    }

    .partners__item span {
        transform: translateY(0.08em);
    }

    .partners__logo {
        filter: brightness(0) invert(0.82) sepia(0.16);
        height: clamp(40px, calc(30px + 3.125vw), 70px);
    }

    .partners__logo--madewell {
        filter: invert(0.82) sepia(0.16);
    }

    .partners__track {
        --partners-gap: clamp(40px, calc(26.67px + 4.17vw), 80px);
        animation: partners__scroll var(--duration-marquee) linear infinite;
        gap: var(--partners-gap);
    }

    @media (prefers-reduced-motion: reduce) {
        .partners__track {
            animation: none;
            flex-wrap: wrap;
            justify-content: center;
            width: auto;
        }
    }

    @keyframes partners__scroll {
        to {
            transform: translateX(calc(-50% - var(--partners-gap) / 2));
        }
    }
</style>
