---
import { Image } from 'astro:assets';

import logoCabanaClub from '@images/logos/cabana_club.webp';
import logoMadewellProductions from '@images/logos/madewell_productions.webp';
---

<section
    class="marquee relative select-none"
    aria-label="Partners"
    data-scroll
>
    <div class="marquee__track flex items-center">
        {Array.from({ length: 2 }).flatMap((_, copy) => [
            <div
                class="marquee__item flex items-center whitespace-nowrap"
                aria-hidden={copy > 0 ? 'true' : undefined}
            >
                <Image
                    class="marquee__logo marquee__logo--madewell"
                    alt=""
                    aria-hidden="true"
                    densities={[1, 2]}
                    src={logoMadewellProductions}
                    width={99}
                />
                <span>Madewell Productions</span>
            </div>,
            <div
                class="marquee__item flex items-center"
                aria-hidden="true"
            >
                <span class="marquee__diamond inline-block" />
            </div>,
            <div
                class="marquee__item flex items-center whitespace-nowrap"
                aria-hidden={copy > 0 ? 'true' : undefined}
            >
                <Image
                    class="marquee__logo"
                    alt=""
                    aria-hidden="true"
                    densities={[1, 2]}
                    src={logoCabanaClub}
                    width={180}
                />
                <span>Cabana Club</span>
            </div>,
            <div
                class="marquee__item flex items-center"
                aria-hidden="true"
            >
                <span class="marquee__diamond inline-block" />
            </div>,
        ])}
    </div>
</section>

<style>
    .marquee {
        background: var(--color-navy);
        border-bottom: 1px solid var(--color-cream-15);
        border-top: 1px solid var(--color-cream-15);
        overflow-x: clip;
        padding: clamp(48px, calc(37.33px + 3.33vw), 80px) 0;
    }

    .marquee__diamond {
        aspect-ratio: 1;
        background: var(--color-coral);
        flex-shrink: 0;
        rotate: 45deg;
        width: 14px;
    }

    .marquee__item {
        color: var(--color-cream-60);
        font-family: var(--font-display);
        font-size: clamp(40px, calc(26.67px + 4.17vw), 80px);
        gap: 32px;
        letter-spacing: 0.04em;
        line-height: 1;
        text-transform: uppercase;
    }

    .marquee__item span {
        transform: translateY(0.08em);
    }

    .marquee__logo {
        height: clamp(40px, calc(30px + 3.13vw), 70px);
        object-fit: contain;
        opacity: 0.85;
        vertical-align: middle;
        width: auto;
    }

    .marquee__logo--madewell {
        filter: invert(0.85);
    }

    .marquee__track {
        --marquee-gap: clamp(40px, calc(26.67px + 4.17vw), 80px);
        animation: marquee__scroll 28s linear infinite;
        gap: var(--marquee-gap);
        width: max-content;
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee__track {
            animation: none;
        }
    }

    @keyframes marquee__scroll {
        to {
            transform: translateX(calc(-50% - var(--marquee-gap) / 2));
        }
    }
</style>
