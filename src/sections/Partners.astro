---
import logoCabana from '@images/logos/cabana.png';
import logoMadewell from '@images/logos/madewell.png';
---

<section class="marquee" aria-label="Partners">
    <div class="marquee__track flex items-center">
        {Array.from({ length: 2 }).flatMap((_, k) => [
            <div class="marquee__item flex items-center" key={`a-${k}`}>
                <img class="marquee__logo marquee__logo--madewell" alt={k === 0 ? 'Madewell Productions' : ''} aria-hidden={k > 0 ? 'true' : undefined} src={logoMadewell.src} />
                <span>Madewell Productions</span>
            </div>,
            <div class="marquee__item" key={`s1-${k}`} aria-hidden="true"><span class="marquee__diamond"></span></div>,
            <div class="marquee__item flex items-center" key={`b-${k}`}>
                <img class="marquee__logo" alt={k === 0 ? 'Cabana Club' : ''} aria-hidden={k > 0 ? 'true' : undefined} src={logoCabana.src} />
                <span>Cabana Club</span>
            </div>,
            <div class="marquee__item" key={`s2-${k}`} aria-hidden="true"><span class="marquee__diamond"></span></div>,
            <div class="marquee__item" key={`c-${k}`} aria-hidden="true"><span>EST · 2026</span></div>,
            <div class="marquee__item" key={`s3-${k}`} aria-hidden="true"><span class="marquee__diamond"></span></div>,
            <div class="marquee__item" key={`d-${k}`} aria-hidden="true"><span>AUSTIN TEXAS</span></div>,
            <div class="marquee__item" key={`s4-${k}`} aria-hidden="true"><span class="marquee__diamond"></span></div>,
        ])}
    </div>
</section>

<style>
    .marquee {
        background: var(--ink-2);
        border-bottom: 1px solid var(--line);
        border-top: 1px solid var(--line);
        overflow: hidden;
        padding: clamp(40px, 6vh, 64px) 0;
        position: relative;
    }

    .marquee__track {
        animation: marquee 28s linear infinite;
        gap: clamp(40px, 6vw, 80px);
        width: max-content;
    }

    .marquee__item {
        color: var(--paper-dim);
        font-family: var(--ff-display);
        font-size: clamp(40px, 6vw, 80px);
        gap: 24px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .marquee__logo {
        height: clamp(40px, 6vw, 70px);
        opacity: 0.85;
        width: auto;
    }

    .marquee__logo--madewell {
        filter: invert(0.85);
    }

    [data-theme='light'] .marquee__logo--madewell {
        filter: invert(0);
    }

    .marquee__diamond {
        background: var(--accent);
        display: inline-block;
        height: 14px;
        transform: rotate(45deg);
        width: 14px;
    }

    @keyframes marquee {
        to {
            transform: translateX(calc(-50% - 40px));
        }
    }
</style>
