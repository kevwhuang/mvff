---
import SectionHeader from '@components/SectionHeader.astro';

const FAQ = [
    { answer: 'A one-night music video festival at Cabana Club in East Austin: live sets, three screening blocks, filmmaker Q&A panels, an awards ceremony, and an after party.', question: 'What is the Austin Music Video Film Festival?' },
    { answer: 'Yes. 21+, doors to close.', question: 'Was there an age requirement?' },
    { answer: 'Silk, tuxedos, and the occasional swimsuit. Red-carpet attire was optional, and guests dressed to be photographed.', question: 'What did people wear?' },
    { answer: 'Onsite parking at Cabana Club, plus street parking around the venue for overflow. Rideshare covered the rest.', question: 'How did guests get there?' },
    { answer: 'Yes. Food vendors served, and the full bar poured all night.', question: 'Was there food and drink?' },
    { answer: 'Cameras were everywhere. Guests shot the night from the floor, and several media members worked alongside them.', question: 'Were cameras allowed?' },
    { answer: 'Submissions for 2026 are closed. The official selections screened across the three blocks on July 18. Follow @atxmvff on Instagram for the next open call.', question: 'How do I submit a music video?' },
    { answer: 'Sponsorships and partnerships are open for next year. Start with the pitch deck in the footer, then apply through Future Partnerships.', question: 'How do brands get involved?' },
] as const;

const SCHEDULE = [
    { datetime: '2026-07-18T19:00-05:00', event: 'Ryley Hall', tag: 'Live', time: '7:00 PM' },
    { datetime: '2026-07-18T19:25-05:00', event: 'Dasmayan Daydreamers', tag: 'Live', time: '7:25 PM' },
    { datetime: '2026-07-18T20:00-05:00', event: 'Tipping Culture', tag: 'Live', time: '8:00 PM' },
    { datetime: '2026-07-18T20:35-05:00', event: 'Anna Madewell', tag: 'Live', time: '8:35 PM' },
    { datetime: '2026-07-18T21:30-05:00', event: 'Music Video Block\u00A0One', tag: 'Screening', time: '9:30 PM' },
    { datetime: '2026-07-18T22:00-05:00', event: 'Raffle & Q&A', tag: 'Panel', time: '10:00 PM' },
    { datetime: '2026-07-18T22:15-05:00', event: 'Music Video Block\u00A0Two', tag: 'Screening', time: '10:15 PM' },
    { datetime: '2026-07-18T22:45-05:00', event: 'Raffle & Q&A', tag: 'Panel', time: '10:45 PM' },
    { datetime: '2026-07-18T23:00-05:00', event: 'Music Video Block\u00A0Three', tag: 'Screening', time: '11:00 PM' },
    { datetime: '2026-07-18T23:30-05:00', event: 'Raffle & Q&A', tag: 'Panel', time: '11:30 PM' },
    { datetime: '2026-07-18T23:45-05:00', event: 'Awards Ceremony', tag: 'Awards', time: '11:45 PM' },
    { datetime: '2026-07-19T00:05-05:00', event: 'Jyme', tag: 'After Party', time: '12:05 AM' },
    { datetime: '2026-07-19T00:35-05:00', event: 'Natia', tag: 'After Party', time: '12:35 AM' },
    { datetime: '2026-07-19T01:05-05:00', event: 'Amiri Tafari', tag: 'After Party', time: '1:05 AM' },
    { datetime: '2026-07-19T01:35-05:00', event: 'Surprise Set', tag: 'After Party', time: '1:35 AM' },
    { datetime: '2026-07-19T02:00-05:00', event: 'Lights Up', tag: 'Close', time: '2:00 AM' },
] as const;
---

<section
    class="info section"
    aria-labelledby="info-title"
>
    <div class="shell">
        <SectionHeader headingId="info-title">
            Guest Info
        </SectionHeader>
        <div
            class="info__stack flex flex-col"
            data-scroll
            data-scroll-stagger="0.12"
        >
            <div>
                <h2 class="info__subheading mb-6 pb-3 border-b border-cream-15 uppercase">Venue</h2>
                <div class="info__venue sweep relative isolate border border-cream-15 bg-navy">
                    <h3 class="info__venue-name mb-2">Cabana Club</h3>
                    <p class="info__venue-address mb-4 font-mono uppercase text-cream-60">5012 E 7th St &middot; Austin, TX</p>
                    <p class="info__venue-description font-serif text-xl text-cream-60">An indoor-outdoor club in East Austin, where an open-air screen lit the pool deck, a live stage carried the music, and high tables sat under the patio roof. A small red-carpet section set the tone, and the night ran 7 PM straight to the 2 AM close.</p>
                    <ul class="info__venue-features grid grid-cols-3 gap-x-6 gap-y-3 list-none">
                        <li>Big screen</li>
                        <li>Live stage</li>
                        <li>Outdoor pool</li>
                        <li>Full bar</li>
                        <li>21+ only</li>
                        <li>ADA access</li>
                    </ul>
                </div>
            </div>
            <div>
                <h2 class="info__subheading mb-6 pb-3 border-b border-cream-15 uppercase">Program</h2>
                <ol class="info__schedule flex flex-col list-none">
                    {SCHEDULE.map(({ datetime, event, tag, time }) => (
                        <li class="info__schedule-row grid items-baseline relative py-4 border-b border-cream-15">
                            <time
                                class="info__schedule-time font-mono tracking-widest whitespace-nowrap"
                                datetime={datetime}
                            >
                                {time}
                            </time>
                            <span class="info__schedule-event font-display">{event}</span>
                            <span class="sr-only">, </span>
                            <span class:list={['info__schedule-tag font-mono uppercase', tag === 'Awards' || tag === 'Screening' ? 'text-coral' : 'text-cream-60']}>{tag}</span>
                        </li>
                    ))}
                </ol>
            </div>
        </div>
        <div
            class="relative"
            data-scroll
        >
            <h2 class="info__subheading flex items-baseline justify-between mb-6 pb-3 border-b border-cream-15 uppercase">Frequently Asked Questions <span class="info__subheading-badge font-mono whitespace-nowrap text-coral">{FAQ.length} Entries</span></h2>
            <div class="info__faq flex flex-col">
                {FAQ.map(entry => (
                    <details
                        class="info__faq-item border-b border-cream-15"
                        name="faq"
                    >
                        <summary class="info__faq-question flex items-center justify-between gap-4 py-4 font-display list-none text-cream cursor-pointer select-none">
                            <span class="info__faq-text">{entry.question}</span>
                            <span
                                class="info__faq-icon font-mono text-coral"
                                aria-hidden="true"
                            >
                                +
                            </span>
                        </summary>
                        <p class="info__faq-answer pb-6 font-serif text-xl text-cream-60">
                            {entry.answer}
                        </p>
                    </details>
                ))}
            </div>
        </div>
    </div>
</section>

<style>
    .info__faq {
        interpolate-size: allow-keywords;
    }

    .info__faq-answer {
        max-width: var(--measure-wide);
    }

    .info__faq-icon {
        font-size: 20px;
        transition: transform var(--duration-fast) ease;
    }

    .info__faq-item::details-content {
        content-visibility: hidden;
        height: 0;
        opacity: 0;
        overflow: hidden;
        transition:
            content-visibility var(--duration-base) allow-discrete,
            height var(--duration-base) ease,
            opacity var(--duration-base) ease;
    }

    .info__faq-item[open] .info__faq-icon {
        transform: rotate(45deg);
    }

    .info__faq-item[open] .info__faq-question {
        color: var(--color-coral);
    }

    .info__faq-item[open]::details-content {
        content-visibility: visible;
        height: auto;
        opacity: 1;
    }

    .info__faq-question {
        font-size: 20px;
        letter-spacing: 0.02em;
        transition: color var(--duration-fast) ease;
    }

    .info__faq-question:active {
        color: var(--color-coral);
    }

    .info__faq-question:hover .info__faq-text {
        transform: translateX(8px);
    }

    .info__faq-text {
        transition: transform var(--duration-fast) ease;
    }

    .info__schedule-event {
        font-size: 20px;
        letter-spacing: 0.02em;
        transition:
            color var(--duration-fast) ease,
            transform var(--duration-fast) ease;
    }

    .info__schedule-row {
        gap: clamp(8px, calc(5.33px + 0.83vw), 16px);
        grid-template-columns: clamp(80px, calc(73.33px + 2.08vw), 100px) minmax(0, 1fr) minmax(min-content, max-content);
    }

    .info__schedule-row:hover .info__schedule-event {
        color: var(--color-coral);
    }

    .info__schedule-row:hover .info__schedule-event,
    .info__schedule-row:hover .info__schedule-time {
        transform: translateX(8px);
    }

    .info__schedule-tag {
        font-size: 10px;
        letter-spacing: 0.2em;
    }

    .info__schedule-time {
        font-size: 14px;
        transition: transform var(--duration-fast) ease;
    }

    .info__stack {
        gap: var(--section-padding-sm);
        margin-bottom: var(--section-padding-sm);
    }

    .info__subheading {
        font-size: clamp(28px, calc(22.67px + 1.67vw), 44px);
    }

    .info__subheading-badge {
        font-size: 10px;
        letter-spacing: 0.2em;
    }

    .info__venue {
        padding: clamp(32px, calc(26.67px + 1.67vw), 48px);
    }

    .info__venue:hover .info__venue-name {
        color: var(--color-coral);
    }

    .info__venue:hover::after {
        opacity: 0.5;
    }

    .info__venue-address {
        font-size: 12px;
        letter-spacing: 0.16em;
    }

    .info__venue-description {
        margin-bottom: clamp(24px, calc(21.33px + 0.83vw), 32px);
        max-width: var(--measure-wide);
    }

    .info__venue-features li {
        align-items: baseline;
        color: var(--color-cream);
        display: flex;
        font-family: var(--font-mono);
        font-size: 12px;
        gap: 8px;
        letter-spacing: 0.16em;
    }

    .info__venue-features li::before {
        color: var(--color-coral);
        content: '+' / '';
        font-weight: 600;
    }

    .info__venue-name {
        font-size: clamp(24px, calc(20px + 1.25vw), 36px);
        line-height: 1;
        transition: color var(--duration-fast) ease;
    }

    @media (max-width: 768px) {
        .info__faq-question:hover .info__faq-text {
            transform: none;
        }

        .info__schedule-event {
            grid-area: event;
            line-height: 1;
        }

        .info__schedule-row {
            grid-template-areas:
                'time tag'
                'event event';
            grid-template-columns: minmax(0, 1fr) max-content;
            row-gap: 8px;
        }

        .info__schedule-tag {
            align-self: center;
            grid-area: tag;
            line-height: 1;
        }

        .info__schedule-time {
            grid-area: time;
            line-height: 1;
        }

        .info__subheading {
            align-items: flex-start;
            flex-direction: column;
            gap: 8px;
        }

        .info__venue-features {
            grid-template-columns: 1fr;
            row-gap: 8px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .info__faq-item::details-content {
            transition: none;
        }
    }
</style>
