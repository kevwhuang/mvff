---
import { Image } from 'astro:assets';

import SectionHead from '@components/SectionHead.astro';
import amiiri from '@images/team/amiiri.webp';
import anna from '@images/team/anna.webp';
import jasmine from '@images/team/jasmine.webp';
import jymes from '@images/team/jymes.webp';
import marissa from '@images/team/marissa.webp';
import rocky from '@images/team/rocky.webp';
import { pad } from '@lib/utils';

const TEAM = [
    { image: anna, name: 'Anna', role: 'Executive Festival Director' },
    { name: 'Ashleigh', role: 'Marketing Director' },
    { image: jymes, name: 'Jyme', role: 'Film Programming Director' },
    { name: 'Dan', role: 'Operations Director' },
    { image: amiiri, name: 'Amiiri', role: 'Partnerships Director' },
    { image: rocky, name: 'Rocky', role: 'Sponsorship Admin Lead' },
    { name: 'Greta', role: 'Content Strategist' },
    { image: marissa, name: 'Marissa', role: 'Graphics Director' },
    { image: jasmine, name: 'Jasmine', role: 'Event Coordinator' },
] as const;
---

<section
    class="roster section"
    aria-labelledby="roster-title"
>
    <div class="shell">
        <SectionHead
            headingId="roster-title"
            marker="[ T ]"
        >
            2026 Team
        </SectionHead>
        <ul
            class="roster__grid grid list-none"
            data-scroll
            data-scroll-stagger="0.04"
        >
            {TEAM.map((member, index) => (
                <li>
                    <article class="roster__card flex flex-col">
                        <div class="roster__frame overflow-hidden relative">
                            <span
                                class="roster__index absolute select-none"
                                aria-hidden="true"
                            >
                                {pad(index + 1)}
                            </span>
                            {'image' in member
                                ? (
                                        <Image
                                            class="roster__image object-cover"
                                            alt={`${member.name}, ${member.role}`}
                                            densities={[1, 2]}
                                            loading="lazy"
                                            src={member.image}
                                            width={400}
                                        />
                                    )
                                : (
                                        <span
                                            class="roster__monogram flex items-center justify-center h-full w-full select-none"
                                            aria-hidden="true"
                                        >
                                            {member.name.charAt(0)}
                                        </span>
                                    )}
                        </div>
                        <div class="roster__body flex flex-1 flex-col gap-2">
                            <h2 class="roster__name">{member.name}</h2>
                            <span class="roster__role">{member.role}</span>
                        </div>
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .roster__body {
        border-top: 1px solid var(--color-cream-15);
        padding: clamp(16px, calc(13.33px + 0.83vw), 24px);
    }

    .roster__card {
        background: var(--color-navy);
        border: 1px solid var(--color-cream-15);
        height: 100%;
        transition:
            border-color var(--duration-base) ease,
            box-shadow var(--duration-base) ease,
            transform var(--duration-base) ease;
    }

    .roster__card:hover {
        border-color: var(--color-coral);
        box-shadow: 0 24px 48px -16px color-mix(in oklab, var(--color-coral) 35%, transparent);
        transform: translateY(-4px);
    }

    .roster__card:hover .roster__image {
        filter: grayscale(0) brightness(1) contrast(1.05);
        transform: scale(1.05);
    }

    .roster__card:hover .roster__index {
        border-color: var(--color-coral);
        color: var(--color-coral);
    }

    .roster__card:hover .roster__monogram {
        color: var(--color-coral);
        transform: scale(1.05);
    }

    .roster__card:hover .roster__role {
        color: var(--color-coral);
    }

    .roster__frame {
        aspect-ratio: 4 / 5;
        background: var(--color-slate);
    }

    .roster__frame::after {
        background: linear-gradient(180deg, transparent 55%, var(--color-black-55) 100%);
        content: '';
        inset: 0;
        pointer-events: none;
        position: absolute;
    }

    .roster__grid {
        gap: clamp(16px, calc(13.33px + 0.83vw), 24px);
        grid-template-columns: repeat(4, 1fr);
    }

    .roster__image {
        display: block;
        filter: grayscale(0.9) brightness(0.95) contrast(1.05);
        height: 100%;
        transition:
            filter var(--duration-slow) ease,
            transform var(--duration-slower) ease;
        width: 100%;
    }

    .roster__index {
        background: var(--color-night-70);
        border: 1px solid var(--color-cream-15);
        color: var(--color-cream);
        font-family: var(--font-mono);
        font-size: 10px;
        left: 12px;
        letter-spacing: 0.16em;
        padding: 4px 8px;
        top: 12px;
        transition:
            border-color var(--duration-fast) ease,
            color var(--duration-fast) ease;
        z-index: 2;
    }

    .roster__monogram {
        color: var(--color-cream-15);
        font-family: var(--font-display);
        font-size: clamp(80px, calc(48px + 10vw), 176px);
        line-height: 1;
        transition:
            color var(--duration-slow) ease,
            transform var(--duration-slower) ease;
    }

    .roster__name {
        font-size: clamp(22px, calc(20px + 0.63vw), 28px);
        line-height: 1;
    }

    .roster__role {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        transition: color var(--duration-fast) ease;
    }

    @media (max-width: 1024px) {
        .roster__grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (max-width: 768px) {
        .roster__grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
