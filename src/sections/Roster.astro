---
import { Image } from 'astro:assets';

import SectionHead from '@components/SectionHead.astro';
import amiiri from '@images/team/amiiri.webp';
import anna from '@images/team/anna.webp';
import ben from '@images/team/ben.webp';
import donovan from '@images/team/donovan.webp';
import jasmine from '@images/team/jasmine.webp';
import jymes from '@images/team/jymes.webp';
import killian from '@images/team/killian.webp';
import marissa from '@images/team/marissa.webp';
import phillip from '@images/team/phillip.webp';
import rocky from '@images/team/rocky.webp';
import sebastian from '@images/team/sebastian.webp';
import { pad } from '@lib/utils';

const TEAM = [
    { image: anna, name: 'Anna', role: 'Founder & Director' },
    { image: rocky, name: 'Rocky', role: 'Film Director' },
    { image: jasmine, name: 'Jasmine', role: 'Event Coordinator' },
    { image: jymes, name: 'Jymes', role: 'Talent Programmer' },
    { image: amiiri, name: 'Amiiri', role: 'Promotions Queen' },
    { image: donovan, name: 'Donovan', role: 'Social Media Manager' },
    { image: marissa, name: 'Marissa', role: 'Graphic Designer' },
    { image: sebastian, name: 'Sebastian', role: 'Community Outreach' },
    { image: phillip, name: 'Phillip', role: 'Volunteer Coordinator' },
    { image: killian, name: 'Killian', role: 'Visual Tech' },
    { image: ben, name: 'Ben', role: 'Audio Tech' },
];
---

<section
    class="roster section"
    aria-labelledby="roster-title"
>
    <div class="shell">
        <SectionHead
            headingId="roster-title"
            number="[ T ]"
        >
            2026 Team
            <Fragment slot="meta">11 CREDITS<br />FOUNDED BY ANNA MADEWELL</Fragment>
        </SectionHead>
        <ul
            class="roster__grid list-none"
            data-scroll
            data-scroll-stagger="0.05"
        >
            {TEAM.map((member, index) => (
                <li class="roster__card">
                    <span class="roster__number">{pad(index + 1)}</span>
                    <div class="roster__photo">
                        <Image
                            class="roster__image"
                            alt={member.name}
                            height={250}
                            loading="lazy"
                            src={member.image}
                            width={250}
                        />
                    </div>
                    <div class="flex flex-col gap-1 pb-5 pt-4 px-4.5 border-t border-cream-15">
                        <h2 class="roster__name">{member.name}</h2>
                        <span class="roster__role">{member.role}</span>
                    </div>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .roster__card {
        background: var(--color-navy);
        overflow: hidden;
        position: relative;
    }

    .roster__card:hover .roster__image {
        filter: grayscale(0) contrast(1.05) brightness(1);
        transform: scale(1.05);
    }

    .roster__grid {
        background: var(--color-cream-15);
        border: 1px solid var(--color-cream-15);
        display: grid;
        gap: 1px;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    }

    .roster__image {
        filter: grayscale(0.85) contrast(1.1) brightness(0.95);
        height: 100%;
        object-fit: cover;
        transition: filter var(--duration-slow) ease, transform var(--duration-slower) ease;
        width: 100%;
    }

    .roster__name {
        font-family: var(--font-display);
        font-size: 26px;
        letter-spacing: normal;
        line-height: 1;
        margin-bottom: 0;
    }

    .roster__number {
        color: var(--color-cream);
        font-family: var(--font-mono);
        font-size: 10px;
        left: 12px;
        letter-spacing: 0.16em;
        mix-blend-mode: difference;
        position: absolute;
        top: 10px;
        z-index: 2;
    }

    .roster__photo {
        aspect-ratio: 4 / 5;
        background: var(--color-slate);
        overflow: hidden;
        position: relative;
    }

    .roster__photo::after {
        background: linear-gradient(180deg, transparent 50%, var(--color-black-70) 100%);
        content: '';
        inset: 0;
        pointer-events: none;
        position: absolute;
    }

    .roster__role {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }
</style>
