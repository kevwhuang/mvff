---
import SectionHead from '@components/SectionHead.astro';

const FAQ = [
    { answer: 'One night in Austin where the music video takes center stage \u2014 three screening blocks, live sets from nominee artists, filmmaker Q&A panels, an awards ceremony, and a pool party to close. One venue, every screen and stage lit.', question: 'What exactly is the Austin Music Video Film Festival?' },
    { answer: 'Saturday, July 18, 2026, from 7 PM to 2 AM at Cabana Club \u2014 5012 E 7th St, Austin, TX. Live sets, three screening blocks, and an awards ceremony, indoors and out.', question: 'When and where is it happening?' },
    { answer: 'Just before midnight \u2014 11:45 PM, right after the third and final screening block. The after party runs from there to the 2 AM close.', question: 'What time is the award ceremony?' },
    { answer: 'Submissions for 2026 are closed \u2014 the official selections are locked and screening July 18. Follow us on Instagram for the next open call.', question: 'How do I submit a music video?' },
    { answer: 'Yes \u2014 21+ with valid ID, no exceptions. Full bar all night, and doors close at 2 AM.', question: 'Is there an age requirement?' },
    { answer: 'Red carpet attire \u2014 silk, tuxedos, and a swimsuit if you\'re feeling bold. Dress to be photographed; the pool deck\'s open under the stars.', question: 'What do I wear?' },
    { answer: 'Phones and small personal cameras, absolutely. Accredited press and media \u2014 reach out through the contact form ahead of the night.', question: 'Can I bring a camera?' },
    { answer: 'Street parking is available around the venue, but with a 2 AM close, rideshare is the move.', question: 'Where do I park?' },
    { answer: 'Cabana Club\'s full bar is open all night \u2014 21+ with valid ID. Outside food and drinks aren\'t permitted.', question: 'Will there be food and drinks?' },
] as const;

const SCHEDULE = [
    ['7:00 PM', 'Doors \u00B7 Ryley Hall', 'Live'],
    ['7:25 PM', 'Dasmayan Daydreamers', 'Live'],
    ['8:00 PM', 'Tipping Culture', 'Live'],
    ['8:35 PM', 'Anna Madewell', 'Live'],
    ['9:30 PM', 'Music Video Block 1', 'Screening'],
    ['10:00 PM', 'Raffle + Q&A with Kay Cote', 'Panel'],
    ['10:15 PM', 'Music Video Block 2', 'Screening'],
    ['10:45 PM', 'Raffle + Q&A with Lauren', 'Panel'],
    ['11:00 PM', 'Music Video Block 3', 'Screening'],
    ['11:30 PM', 'Raffle + Q&A with Carmela', 'Panel'],
    ['11:45 PM', 'Award Ceremony', 'Awards'],
    ['12:05 AM', 'Jyme', 'After Party'],
    ['12:35 AM', 'Natia', 'After Party'],
    ['1:05 AM', 'Amiiri Tafari', 'After Party'],
    ['1:35 AM', 'Surprise', 'After Party'],
    ['2:00 AM', 'Lights Up', 'Close'],
] as const;
---

<section
    class="info section"
    aria-labelledby="info-title"
>
    <div class="shell">
        <SectionHead
            headingId="info-title"
            marker="[ I ]"
        >
            Info
        </SectionHead>
        <div
            class="info__grid grid"
            data-scroll
            data-scroll-stagger="0.1"
        >
            <div>
                <h2 class="subhead flex items-baseline justify-between">Program <span class="subhead__badge">7 PM&ndash;2 AM</span></h2>
                <ol class="schedule flex flex-col list-none">
                    {SCHEDULE.map(([time, event, tag]) => (
                        <li class="schedule__row grid items-baseline relative">
                            <span class="schedule__time">{time}</span>
                            <span class="schedule__event">{event}</span>
                            <span class="schedule__tag">{tag}</span>
                        </li>
                    ))}
                </ol>
                <p class="schedule__note font-serif italic text-cream-60">Live schedule &mdash; subject to change.</p>
            </div>
            <div>
                <h2 class="subhead flex items-baseline justify-between">Venue <span class="subhead__badge">Cap 300</span></h2>
                <div class="venue border border-cream-15 bg-navy">
                    <h3 class="venue__name">Cabana Club</h3>
                    <span class="mb-4 font-mono text-xs tracking-widest uppercase text-cream-60">5012 E 7th St &middot; Austin, TX</span>
                    <p class="venue__description">A single screening room and an open-air pool deck, capped at 300 &mdash; full bar, red carpet, and a dedicated VIP lounge.</p>
                    <ul class="venue__features grid grid-cols-2 list-none gap-2">
                        <li>Indoor screen</li>
                        <li>Outdoor pool</li>
                        <li>Full bar</li>
                        <li>VIP lounge</li>
                        <li>Red carpet</li>
                        <li>ADA access</li>
                    </ul>
                </div>
            </div>
        </div>
        <div
            class="relative"
            data-scroll
        >
            <h2 class="subhead flex items-baseline justify-between">Frequently Asked Questions <span class="subhead__badge">{FAQ.length} Entries</span></h2>
            <div class="faq flex flex-col">
                {FAQ.map(entry => (
                    <details
                        class="faq__item border-b border-cream-15"
                        name="faq"
                    >
                        <summary class="faq__question flex items-center justify-between cursor-pointer select-none">
                            <span>{entry.question}</span>
                            <span
                                class="faq__icon"
                                aria-hidden="true"
                            >
                                +
                            </span>
                        </summary>
                        <p class="faq__answer">
                            {entry.answer}
                        </p>
                    </details>
                ))}
            </div>
        </div>
    </div>
</section>

<style>
    .faq__answer {
        color: var(--color-cream-60);
        font-family: var(--font-serif);
        font-size: 16px;
        line-height: 1.55;
        padding: 0 0 24px;
    }

    .faq__icon {
        color: var(--color-coral);
        font-family: var(--font-mono);
        font-size: 20px;
        transition: transform var(--duration-fast) ease;
    }

    .faq__item[open] .faq__icon {
        transform: rotate(45deg);
    }

    .faq__question {
        color: var(--color-cream);
        font-family: var(--font-display);
        font-size: 20px;
        gap: 16px;
        letter-spacing: 0.02em;
        list-style: none;
        padding: 16px 0;
        transition: color var(--duration-fast) ease;
    }

    .faq__question:active,
    .faq__question:hover {
        color: var(--color-coral);
    }

    .faq__question::-webkit-details-marker {
        display: none;
    }

    .info__grid {
        gap: clamp(40px, calc(26.67px + 4.17vw), 80px);
        grid-template-columns: 1fr 1fr;
        margin-bottom: clamp(64px, calc(53.33px + 3.33vw), 96px);
    }

    .schedule__event {
        font-family: var(--font-display);
        font-size: 18px;
        letter-spacing: 0.02em;
    }

    .schedule__row {
        border-bottom: 1px solid var(--color-cream-10);
        gap: clamp(8px, calc(5.33px + 0.83vw), 16px);
        grid-template-columns: clamp(64px, calc(52px + 3.75vw), 100px) 1fr auto;
        padding: 16px 0;
        transition: transform var(--duration-fast) ease;
    }

    .schedule__row:hover {
        transform: translateX(8px);
    }

    .schedule__row:hover .schedule__time {
        color: var(--color-coral);
    }

    .schedule__tag {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    .schedule__time {
        color: var(--color-cream);
        font-family: var(--font-mono);
        font-size: 14px;
        letter-spacing: 0.06em;
        transition: color var(--duration-fast) ease;
    }

    .venue {
        margin-bottom: clamp(32px, calc(26.67px + 1.67vw), 48px);
        padding: clamp(32px, calc(26.67px + 1.67vw), 48px);
    }

    .venue__description {
        color: var(--color-cream-60);
        font-family: var(--font-serif);
        font-size: 16px;
        line-height: 1.5;
        margin-bottom: 16px;
    }

    .venue__features li {
        align-items: center;
        color: var(--color-cream);
        display: flex;
        font-family: var(--font-mono);
        font-size: 12px;
        gap: 8px;
        letter-spacing: 0.08em;
    }

    .venue__features li::before {
        color: var(--color-coral);
        content: '+';
        font-weight: 600;
    }

    .venue__name {
        font-size: clamp(28px, calc(25.33px + 0.83vw), 36px);
        line-height: 1;
        margin-bottom: 8px;
    }

    @media (max-width: 1024px) {
        .info__grid {
            grid-template-columns: 1fr;
        }
    }
</style>
