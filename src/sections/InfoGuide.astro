---
import SectionHead from '@components/SectionHead.astro';

const ESSENTIALS = [
    '21+ with valid government-issued ID \u2014 no exceptions',
    'Doors open at 7:00 PM, last entry at 11:30 PM',
    'No outside food or drink \u2014 full-service bar on site',
    'Pool access included with all ticket tiers \u2014 bring a suit',
    'Wristband re-entry permitted up until midnight',
    'Wheelchair-accessible venue \u2014 email us for any further accommodations',
] as const;

const FAQ = [
    { answer: 'A one-night festival in Austin where music videos take the spotlight \u2014 paired with live performances by nominee artists, a Q&A panel with directors, an awards ceremony, and a closing pool party. One night, one venue, every screen and stage active.', question: 'What exactly is the Austin Music Video Film Festival?' },
    { answer: 'Saturday, July 18, 2026, from 7 PM until 2 AM at Cabana Club in Austin, TX. Twelve programmed acts across the night, all under one roof.', question: 'When and where is it happening?' },
    { answer: 'Submissions for 2026 are now closed. Follow us on Instagram for announcements about the next submission window.', question: 'How do I submit a music video?' },
    { answer: 'Yes \u2014 21+ with valid ID. The bar is full-service and the pool party runs late.', question: 'Is there an age requirement?' },
    { answer: 'Red carpet meets pool party. Dress to be photographed \u2014 and bring a swimsuit if you plan to take a dip after midnight.', question: 'What\'s the dress code?' },
    { answer: 'Phones and small personal cameras are welcome. Professional press / accredited media \u2014 please reach out in advance via the contact form.', question: 'Can I bring a camera?' },
    { answer: 'Street parking is available around the venue, but rideshare is strongly recommended given how late the event runs.', question: 'Where do I park?' },
    { answer: 'Cabana Club\'s full-service bar is open all night. Light bites are served during the mixer; no outside food or drink permitted.', question: 'Will there be food and drinks?' },
] as const;

const SCHEDULE = [
    ['TBD', 'Event TBD', 'TBD'],
    ['TBD', 'Event TBD', 'TBD'],
    ['TBD', 'Event TBD', 'TBD'],
    ['TBD', 'Event TBD', 'TBD'],
    ['TBD', 'Event TBD', 'TBD'],
    ['TBD', 'Event TBD', 'TBD'],
    ['TBD', 'Event TBD', 'TBD'],
    ['TBD', 'Event TBD', 'TBD'],
    ['TBD', 'Event TBD', 'TBD'],
    ['TBD', 'Event TBD', 'TBD'],
    ['TBD', 'Event TBD', 'TBD'],
    ['TBD', 'Event TBD', 'TBD'],
] as const;
---

<section
    class="info section"
    aria-labelledby="info-title"
>
    <div class="shell">
        <SectionHead
            headingId="info-title"
            marker="[ I ]"
        >
            Info
        </SectionHead>
        <div
            class="info__grid grid"
            data-scroll
            data-scroll-stagger="0.1"
        >
            <div>
                <h2 class="subhead flex items-baseline justify-between">Run of Show <span class="subhead__badge">7 PM &ndash; 2 AM</span></h2>
                <ol class="schedule flex flex-col list-none">
                    {SCHEDULE.map(([time, event, tag]) => (
                        <li class="schedule__row grid items-baseline relative">
                            <span class="schedule__time">{time}</span>
                            <span class="schedule__event">{event}</span>
                            <span class="schedule__tag">{tag}</span>
                        </li>
                    ))}
                </ol>
            </div>
            <div>
                <h2 class="subhead flex items-baseline justify-between">Venue <span class="subhead__badge">Cap 300</span></h2>
                <div class="venue border border-cream-15 bg-navy">
                    <h3 class="venue__name">Cabana Club</h3>
                    <span class="mb-4 font-mono text-xs tracking-widest uppercase text-cream-60">Austin &middot; Texas</span>
                    <p class="venue__description">Intimate venue, limited to 300 guests. Indoor screening room, outdoor pool area, full-service bar, and a dedicated VIP lounge. Street parking is available, but rideshare is strongly recommended given how late the night runs.</p>
                    <ul class="venue__features grid grid-cols-2 list-none gap-2">
                        <li>Indoor screen</li>
                        <li>Outdoor pool</li>
                        <li>Full bar</li>
                        <li>VIP lounge</li>
                        <li>Red carpet</li>
                        <li>ADA access</li>
                    </ul>
                </div>
                <h2 class="subhead flex items-baseline justify-between">Practical <span class="subhead__badge">Read First</span></h2>
                <ul class="practical flex flex-col list-none gap-3">
                    {ESSENTIALS.map(item => (
                        <li>{item}</li>
                    ))}
                </ul>
            </div>
        </div>
        <div
            class="relative"
            data-scroll
        >
            <h2 class="subhead flex items-baseline justify-between">Frequently Asked <span class="subhead__badge">{FAQ.length} Entries</span></h2>
            <div class="faq flex flex-col">
                {FAQ.map(entry => (
                    <details
                        class="faq__item border-b border-cream-15"
                        name="faq"
                    >
                        <summary class="faq__question flex items-center justify-between cursor-pointer select-none">
                            <span>{entry.question}</span>
                            <span
                                class="faq__icon"
                                aria-hidden="true"
                            >
                                +
                            </span>
                        </summary>
                        <p class="faq__answer">
                            {entry.answer}
                        </p>
                    </details>
                ))}
            </div>
        </div>
    </div>
</section>

<style>
    .faq__answer {
        color: var(--color-cream-60);
        font-family: var(--font-serif);
        font-size: 16px;
        line-height: 1.55;
        padding: 0 0 24px;
    }

    .faq__icon {
        color: var(--color-coral);
        font-family: var(--font-mono);
        font-size: 20px;
        transition: transform var(--duration-fast) ease;
    }

    .faq__item[open] .faq__icon {
        transform: rotate(45deg);
    }

    .faq__question {
        color: var(--color-cream);
        font-family: var(--font-display);
        font-size: 20px;
        gap: 16px;
        letter-spacing: 0.02em;
        list-style: none;
        padding: 16px 0;
        transition: color var(--duration-fast) ease;
    }

    .faq__question:active,
    .faq__question:hover {
        color: var(--color-coral);
    }

    .faq__question::-webkit-details-marker {
        display: none;
    }

    .info__grid {
        gap: clamp(40px, calc(26.67px + 4.17vw), 80px);
        grid-template-columns: 1fr 1fr;
        margin-bottom: clamp(64px, calc(53.33px + 3.33vw), 96px);
    }

    .practical li {
        align-items: baseline;
        color: var(--color-cream);
        display: grid;
        font-size: 14px;
        gap: 12px;
        grid-template-columns: 24px 1fr;
    }

    .practical li::before {
        color: var(--color-coral);
        content: '\25BA';
        font-size: 10px;
    }

    .schedule__event {
        font-family: var(--font-display);
        font-size: 18px;
        letter-spacing: 0.02em;
    }

    .schedule__row {
        border-bottom: 1px solid var(--color-cream-10);
        gap: clamp(8px, calc(5.33px + 0.83vw), 16px);
        grid-template-columns: clamp(64px, calc(52px + 3.75vw), 100px) 1fr auto;
        padding: 16px 0;
        transition: padding var(--duration-fast) ease;
    }

    .schedule__row:hover {
        padding-left: 8px;
    }

    .schedule__row:hover .schedule__time {
        color: var(--color-coral);
    }

    .schedule__tag {
        color: var(--color-cream-60);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    .schedule__time {
        color: var(--color-cream);
        font-family: var(--font-mono);
        font-size: 14px;
        letter-spacing: 0.06em;
        transition: color var(--duration-fast) ease;
    }

    .venue {
        margin-bottom: clamp(32px, calc(26.67px + 1.67vw), 48px);
        padding: clamp(32px, calc(26.67px + 1.67vw), 48px);
    }

    .venue__description {
        color: var(--color-cream-60);
        font-family: var(--font-serif);
        font-size: 16px;
        line-height: 1.5;
        margin-bottom: 16px;
    }

    .venue__features li {
        align-items: center;
        color: var(--color-cream);
        display: flex;
        font-family: var(--font-mono);
        font-size: 12px;
        gap: 8px;
        letter-spacing: 0.08em;
    }

    .venue__features li::before {
        color: var(--color-coral);
        content: '+';
        font-weight: 600;
    }

    .venue__name {
        font-size: clamp(28px, calc(25.33px + 0.83vw), 36px);
        line-height: 1;
        margin-bottom: 8px;
    }

    @media (max-width: 1024px) {
        .info__grid {
            grid-template-columns: 1fr;
        }
    }
</style>
